---
// =============================================================================
// LAYOUT BASE - Estok Inventory System
// Estructura HTML principal con Tailwind CSS y meta tags
// =============================================================================

// Importar estilos globales (Astro los procesa y los pone en /assets/ con hash)
import '../styles/global.css';
import ChatModal from '../components/ChatModal.astro';
import MobileNavBars from '../components/MobileNavBars.astro';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'Estok - Sistema de Inventario', description = 'Sistema de gestión de inventario personal con herencia multi-tabla' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <!-- viewport-fit=cover: habilita env(safe-area-inset-*) en iOS standalone
         (notch, barra de estado y barra de gestos). -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <!-- theme-color dinámico: lib/layout/nativeShell.ts lo sincroniza con el
         dark mode (claro #8B4513 / oscuro #1e293b) y con el manifest. -->
    <meta id="metaThemeColor" name="theme-color" content="#8B4513" />

    <title>{title}</title>

    <!-- Favicon (cache buster v2) -->
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="mask-icon" href="/favicon.svg?v=2" color="#8B4513" />
    <link rel="shortcut icon" href="/favicon.png?v=2" type="image/png" />

    <!-- Fuente Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Cropper.js CSS + JS (para editor de fotos) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js" defer></script>

    <!-- PWA: Manifest + instalación (Android / iOS) -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="application-name" content="Estok" />
    <!-- Android / Chrome: "Añadir a la pantalla de inicio" sin barra de navegador -->
    <meta name="mobile-web-app-capable" content="yes" />
    <!-- iOS / Safari: standalone sin barra de Safari -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <!-- "default" mantiene legible la barra de estado sobre el tema claro;
         nativeShell.ts lo cambia a black-translucent en dark mode. -->
    <meta id="metaAppleStatusBar" name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Estok" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icons/icon-192x192.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/icons/icon-512x512.png" />

  </head>
  <body style="background-color: var(--bg-primary)">
    <!-- Barra de navegación -->
    <nav class="bg-white shadow-sm border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Fila superior: Logo + Acciones derecha -->
        <div class="flex items-center justify-between h-16">
          <!-- Logo y marca -->
          <div class="flex items-center min-w-0 flex-shrink">
            <!-- Logo + marca: ancla directa de retorno al inicio (Dashboard).
                 "/" es la ruta real del Dashboard y "/dashboard" es un alias que
                 redirige ahí, de modo que el regreso al inicio funciona desde
                 cualquier pantalla sin devolver 404. -->
            <a href="/dashboard" class="flex items-center space-x-2 flex-shrink-0"
              title="Ir al Dashboard" aria-label="Estok - Ir al Dashboard">
              <img src="/favicon.png" alt="Estok" class="h-10 w-10 sm:h-16 sm:w-16 object-cover" />
              <span class="text-xl sm:text-2xl font-bold text-blue-700">Estok</span>
            </a>
            <!-- Nombre del Estok (mobile: debajo del logo, desktop: inline) -->
            <div id="estokNombreMobile" class="ml-2 truncate hidden">
              <span class="text-xs font-semibold text-blue-800 truncate max-w-[120px] sm:max-w-[200px] block"></span>
              <span id="estokRoleBadgeMobile" class="text-[10px] px-1 py-0.5 rounded-full bg-blue-100 text-blue-700 font-medium"></span>
            </div>
          </div>

          <!-- Acciones derecha (siempre visibles) -->
          <div class="flex flex-row items-center gap-1 sm:gap-2 flex-wrap justify-end">
            <!-- Indicador de usuarios online -->
            <div id="onlineUsersIndicator" class="hidden flex-shrink-0">
              <button id="onlineUsersBtn"
                class="flex items-center gap-1 px-2 py-1 rounded-lg text-xs text-green-700 bg-green-50 hover:bg-green-100 transition-base"
                title="Usuarios online">
                <span class="w-2 h-2 rounded-full bg-green-500 inline-block animate-pulse"></span>
                <span id="onlineCount" class="font-semibold">0</span>
              </button>
              <!-- Tooltip con lista de usuarios online -->
              <div id="onlineUsersTooltip"
                class="hidden absolute top-full right-0 mt-1 w-56 bg-white rounded-xl shadow-xl border border-gray-200 py-2 z-50">
                <div class="px-3 py-1 text-xs font-semibold text-gray-400 uppercase tracking-wider border-b border-gray-100">
                  Usuarios online
                </div>
                <div id="onlineUsersList" class="max-h-48 overflow-y-auto py-1">
                  <!-- Se llena dinámicamente -->
                </div>
              </div>
            </div>
            <!-- Dark Mode Toggle -->
            <button id="darkModeToggle" class="p-2 rounded-lg text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-base" title="Cambiar tema">
              <svg id="sunIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              <svg id="moonIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
            </button>
            <!-- Mi Perfil (móvil): ocupa el lugar que dejó el menú de las 3 rayitas.
                 Avatar minimalista redondeado que lleva directo al módulo de perfil. -->
            <a id="profileBtnMobile" href="/perfil"
              class="md:hidden flex items-center justify-center w-9 h-9 rounded-full bg-orange-100 text-orange-800 border border-orange-200 hover:bg-orange-200 transition-base flex-shrink-0"
              title="Mi Perfil" aria-label="Mi Perfil">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </a>
            <div id="authSection" class="hidden flex items-center gap-1 sm:gap-3">
              <span id="userName" class="text-xs sm:text-sm text-gray-600 font-medium truncate max-w-[80px] sm:max-w-[150px]"></span>
              <button
                id="logoutBtn"
                class="text-xs sm:text-sm text-red-600 hover:text-red-700 transition-base font-medium whitespace-nowrap"
              >
                Cerrar Sesión
              </button>
            </div>
            <a id="loginLink" href="/login" class="text-sm text-gray-600 hover:text-blue-700 transition-base">
              Iniciar Sesión
            </a>
          </div>
        </div>

        <!-- Fila inferior: Nombre del Estok en mobile (debajo del logo) -->
        <div id="estokSectionMobile" class="hidden md:hidden pb-2">
          <div class="flex items-center gap-2">
            <!-- Dropdown de Estoks compacto -->
            <div id="estokDropdownMobile" class="relative flex-1">
              <button id="estokDropdownBtnMobile"
                class="flex items-center gap-1.5 w-full px-2 py-1.5 bg-blue-50 rounded-lg border border-blue-100 hover:bg-blue-100 transition-base cursor-pointer text-left"
                title="Cambiar de Estok">
                <svg class="w-3.5 h-3.5 text-blue-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                <span id="estokNombreMobileBtn" class="text-sm font-semibold text-blue-800 truncate flex-1"></span>
                <span id="estokRoleBadgeMobileBtn" class="text-[10px] px-1.5 py-0.5 rounded-full bg-blue-200 text-blue-800 font-medium flex-shrink-0"></span>
                <svg class="w-3 h-3 text-blue-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <!-- Menú desplegable mobile -->
              <div id="estokDropdownMenuMobile"
                class="hidden absolute top-full left-0 mt-1 w-64 bg-white rounded-xl shadow-xl border border-gray-200 py-1 z-50 overflow-hidden">
                <div class="px-3 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider border-b border-gray-100">
                  Mis Estoks
                </div>
                <div id="estokDropdownListMobile" class="max-h-60 overflow-y-auto">
                  <!-- Se llena dinámicamente -->
                </div>
                <div class="border-t border-gray-100 px-2 py-1">
                  <a href="/estoks"
                    class="flex items-center gap-2 px-3 py-2 text-sm text-blue-700 hover:bg-blue-50 rounded-lg transition-base font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Gestionar Estoks
                  </a>
                </div>
              </div>
            </div>
            <button id="invitarBtnMobile"
              class="hidden px-2 py-1.5 text-xs font-medium text-white bg-green-600 hover:bg-green-700 rounded-lg transition-base shadow-sm whitespace-nowrap"
              title="Invitar miembros al Estok">
              Invitar
            </button>
          </div>
        </div>

        <!-- Navegación principal desktop -->
        <div class="hidden md:flex items-center justify-between pb-2">
          <div class="flex items-center space-x-6">
            <a href="/" class="text-gray-600 hover:text-blue-700 transition-base font-medium">
              Dashboard
            </a>
            <a href="/objetos" class="text-gray-600 hover:text-blue-700 transition-base font-medium">
              Objetos
            </a>
            <a href="/almacenamiento" class="text-gray-600 hover:text-blue-700 transition-base font-medium">
              📦 Almacenamiento
            </a>
            <a href="/alertas-stock" class="text-gray-600 hover:text-blue-700 transition-base font-medium">
              ⚖️ Decisiones
            </a>
            <a href="/perfil" class="text-gray-600 hover:text-blue-700 transition-base font-medium">
              👤 Mi Perfil
            </a>
            <!-- ============================================================= -->
            <!-- ADMIN GLOBAL - SOLO visible para ygumy44 (invisible para el resto) -->
            <!-- Toggle directo del Panel de Control integrado en el Dashboard -->
            <!-- ============================================================= -->
            <div id="godModeWrap" class="hidden">
              <button
                id="godModeBtn"
                type="button"
                class="flex items-center gap-2 px-3 py-1.5 bg-red-700 hover:bg-red-800 text-white text-sm font-semibold rounded-lg transition-base shadow-sm cursor-pointer"
                title="Abrir / cerrar el Panel de Control global (solo ygumy44)"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                Admin Global
              </button>
            </div>
          </div>
          <!-- Estok activo + Selector de Estoks + Invitar (desktop) -->
          <div id="estokSection" class="hidden flex items-center space-x-3">
            <!-- Dropdown de Estoks -->
            <div id="estokDropdown" class="relative">
              <button id="estokDropdownBtn"
                class="flex items-center gap-2 px-3 py-1.5 bg-blue-50 rounded-lg border border-blue-100 hover:bg-blue-100 transition-base cursor-pointer"
                title="Cambiar de Estok">
                <svg class="w-4 h-4 text-blue-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                <span id="estokNombre" class="text-sm font-semibold text-blue-800"></span>
                <span id="estokRoleBadge" class="text-xs px-1.5 py-0.5 rounded-full bg-blue-200 text-blue-800 font-medium"></span>
                <svg class="w-3 h-3 text-blue-500 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <!-- Menú desplegable -->
              <div id="estokDropdownMenu"
                class="hidden absolute top-full left-0 mt-1 w-64 bg-white rounded-xl shadow-xl border border-gray-200 py-1 z-50 overflow-hidden">
                <div class="px-3 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider border-b border-gray-100">
                  Mis Estoks
                </div>
                <div id="estokDropdownList" class="max-h-60 overflow-y-auto">
                  <!-- Se llena dinámicamente -->
                </div>
                <div class="border-t border-gray-100 px-2 py-1">
                  <a href="/estoks"
                    class="flex items-center gap-2 px-3 py-2 text-sm text-blue-700 hover:bg-blue-50 rounded-lg transition-base font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Gestionar Estoks
                  </a>
                </div>
              </div>
            </div>
            <button id="invitarBtn"
              class="hidden px-3 py-1.5 text-sm font-medium text-white bg-green-600 hover:bg-green-700 rounded-lg transition-base shadow-sm"
              title="Invitar miembros al Estok">
              <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Invitar
            </button>
          </div>
        </div>
      </div>
    </nav>

    <!-- Barra de Estok activo (solo mobile) -->
    <div id="estokBarMobile" class="md:hidden hidden bg-blue-50 border-b border-blue-100">
      <div class="max-w-7xl mx-auto px-4 py-1.5">
        <div class="flex items-center justify-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-blue-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          <span id="estokBarNombre" class="text-xs font-semibold text-blue-800 truncate max-w-[200px]"></span>
          <span id="estokBarRoleBadge" class="text-[10px] px-1.5 py-0.5 rounded-full bg-blue-200 text-blue-800 font-medium"></span>
        </div>
      </div>
    </div>

    <!-- Navegación móvil: 3 barras naranja-crema siempre visibles (reemplazan al
         menú hamburguesa). Solo <md; la fila desktop sigue en `hidden md:flex`. -->
    <MobileNavBars />

    <!-- ADMIN GLOBAL (móvil) - SOLO visible para ygumy44 -->
    <!-- Toggle directo del Panel de Control del Dashboard (index.astro) -->
    <div id="godModeWrapMobile" class="hidden md:hidden max-w-7xl mx-auto px-4 pb-3">
      <button
        id="godModeBtnMobile"
        type="button"
        class="w-full flex items-center justify-center gap-2 px-3 py-2 bg-red-700 hover:bg-red-800 text-white text-sm font-semibold rounded-xl transition-base shadow-sm cursor-pointer"
        title="Abrir / cerrar el Panel de Control global"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Admin Global
      </button>
    </div>

    <!-- Toast Container Global -->
    <div id="toastContainer" class="fixed top-4 right-4 z-[9999] flex flex-col gap-2 pointer-events-none"></div>

    <!-- Chat Modal -->
    <ChatModal />

    <!-- Contenido principal -->
    <main class="min-h-screen">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
          <p class="text-sm text-gray-500">
            &copy; {new Date().getFullYear()} Estok - Sistema de Inventario Personal
          </p>
          <p class="text-sm text-gray-400">
            Construido con Astro + Tailwind CSS
          </p>
        </div>
      </div>
    </footer>

    <!-- Estado activo del botón "Admin Global" (Panel de Control abierto) -->
    <style>
      #godModeBtn.is-open,
      #godModeBtnMobile.is-open {
        background-color: #7f1d1d;
      }
    </style>
  </body>
</html>


<script>
  // Fase A (refactor preventivo): la logica de cliente del layout se modularizo
  // en src/lib/layout/ (toasts, nav desktop/movil, god mode, dark mode, service
  // worker, heartbeat, presencia y deteccion de redeploy).
  import '../lib/layout/baseLayout';
</script>
