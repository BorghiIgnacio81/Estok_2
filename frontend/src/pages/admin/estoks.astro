---
// =============================================================================
// PÁGINA: Modo Dios - CRUD de Estoks / Inquilinos (solo ygumy44)
// Consume de forma aislada el endpoint global /api/admin/estoks/.
// El backend devuelve HTTP 403 para cualquier persona que no sea ygumy44.
// =============================================================================
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthGuard from '../../components/AuthGuard.astro';
---

<AuthGuard />

<BaseLayout title="Modo Dios - CRUD Estoks | Estok">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">🏢 CRUD Estoks</h1>
      <p class="mt-1 text-gray-500">Administración global de inquilinos (<strong>Estok</strong>) — exclusiva de <strong>ygumy44</strong></p>
    </div>

    <!-- Acceso denegado (para quien no sea ygumy44) -->
    <div id="godDenied" class="hidden bg-red-50 border-2 border-red-200 rounded-xl p-8 text-center">
      <p class="text-3xl mb-3">⛔</p>
      <p class="font-semibold text-red-800">Acceso denegado</p>
      <p class="text-sm text-red-600 mt-1">
        Este panel es exclusivo del usuario <strong>ygumy44</strong>. El backend devuelve HTTP 403 para cualquier otra persona.
      </p>
    </div>

    <!-- Loading -->
    <div id="godLoading" class="text-center py-16">
      <svg class="animate-spin h-10 w-10 mx-auto text-red-600 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <p class="text-gray-500">Cargando Estoks...</p>
    </div>

    <!-- Error -->
    <div id="godError" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm mb-4"></div>

    <!-- Contenido principal -->
    <div id="mainContent" class="hidden">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
        <div>
          <h2 class="text-lg font-bold text-gray-900">Estoks del sistema</h2>
          <p id="estoksCount" class="text-xs text-gray-500"></p>
        </div>
        <button
          id="nuevoEstokBtn"
          class="px-4 py-2 bg-red-700 hover:bg-red-800 text-white text-sm font-semibold rounded-lg transition-base shadow-sm"
        >
          ➕ Nuevo Estok
        </button>
      </div>
      <div id="estoksList" class="space-y-3">
        <!-- Se llena dinámicamente -->
      </div>
    </div>
  </div>

  <!-- Modal Crear / Editar -->
  <div id="estokModal" class="hidden fixed inset-0 z-[9999] flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
        <h3 id="modalTitle" class="text-lg font-bold text-gray-900">Nuevo Estok</h3>
        <button id="cerrarModalBtn" class="p-1 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-base" title="Cerrar">✕</button>
      </div>

      <form id="estokForm" class="p-6 space-y-4">
        <div>
          <label for="fNombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre *</label>
          <input id="fNombre" type="text" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base" />
        </div>
        <div>
          <label for="fDescripcion" class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
          <textarea id="fDescripcion" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base"></textarea>
        </div>

        <div id="formError" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm"></div>

        <div class="flex gap-3 pt-1">
          <button
            id="guardarBtn"
            type="submit"
            class="flex-1 py-2.5 bg-red-700 hover:bg-red-800 text-white text-sm font-semibold rounded-lg transition-base shadow-sm"
          >
            Guardar
          </button>
          <button
            id="cancelarBtn"
            type="button"
            class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition-base"
          >
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  import { getCachedUser } from '../../services/auth';
  import { apiGet, apiPost, apiPatch, apiDelete, fetchAllPages } from '../../lib/api';

  // ===========================================================================
  // ELEMENTOS
  // ===========================================================================
  const godDenied = document.getElementById('godDenied')!;
  const godLoading = document.getElementById('godLoading')!;
  const godError = document.getElementById('godError')!;
  const mainContent = document.getElementById('mainContent')!;
  const estoksList = document.getElementById('estoksList')!;
  const estoksCount = document.getElementById('estoksCount')!;
  const nuevoEstokBtn = document.getElementById('nuevoEstokBtn')!;
  const modal = document.getElementById('estokModal')!;
  const modalTitle = document.getElementById('modalTitle')!;
  const estokForm = document.getElementById('estokForm')!;
  const formError = document.getElementById('formError')!;
  const guardarBtn = document.getElementById('guardarBtn')!;

  let editandoId: string | null = null;
  let cargando = false;

  function showError(msg: string) {
    godError.textContent = msg;
    godError.classList.remove('hidden');
  }

  function hideError() {
    godError.classList.add('hidden');
  }

  function setFormError(msg: string) {
    formError.textContent = msg;
    formError.classList.remove('hidden');
  }

  // ===========================================================================
  // GUARD: Solo ygumy44 (el backend además responde 403 para el resto)
  // ===========================================================================
  const cachedUser = getCachedUser();
  const esGod = cachedUser?.username === 'ygumy44';

  if (!esGod) {
    godLoading.classList.add('hidden');
    godDenied.classList.remove('hidden');
  } else {
    cargarEstoks();
  }

  // ===========================================================================
  // LISTADO
  // ===========================================================================
  async function cargarEstoks() {
    hideError();
    godLoading.classList.remove('hidden');
    mainContent.classList.add('hidden');

    try {
      const estoks = await fetchAllPages<any>('/admin/estoks/');
      estoksCount.textContent = `${estoks.length} Estok(s) en el sistema`;
      renderEstoks(estoks);
      godLoading.classList.add('hidden');
      mainContent.classList.remove('hidden');
    } catch (err: any) {
      godLoading.classList.add('hidden');
      showError(
        err?.status === 403
          ? '⛔ 403 Forbidden: solo ygumy44 puede acceder a este panel.'
          : (err?.error || 'Error al cargar Estoks.')
      );
    }
  }

  function renderEstoks(estoks: any[]) {
    if (estoks.length === 0) {
      estoksList.innerHTML = '<p class="text-sm text-gray-500 text-center py-8">No hay Estoks registrados.</p>';
      return;
    }

    estoksList.innerHTML = estoks.map((e) => {
      const miembros = e.miembros || [];
      const primeros = miembros.slice(0, 3).map((m: any) =>
        `<span class="inline-block px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 text-[11px] mr-1 mb-1">${m.display_name || m.username}</span>`
      ).join('');

      return `
        <div class="p-4 rounded-xl border border-gray-200 hover:bg-gray-50 transition-base">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-sm font-semibold text-gray-900 truncate">
                🏢 ${e.nombre}
                <span class="ml-1 text-[10px] px-1.5 py-0.5 rounded-full bg-red-100 text-red-700 font-medium">${e.miembros_count} miembro(s)</span>
                <span class="ml-1 text-[10px] px-1.5 py-0.5 rounded-full bg-blue-100 text-blue-700 font-medium">${e.objetos_count} objeto(s)</span>
              </p>
              <p class="text-xs text-gray-500 mt-0.5">${e.descripcion || '<span class="text-gray-400 italic">Sin descripción</span>'}</p>
              <p class="text-xs text-gray-400 mt-1">Creado: ${(e.created_at || '').slice(0, 10)}</p>
              ${miembros.length > 0 ? `<div class="mt-2">${primeros}${miembros.length > 3 ? `<span class="text-[11px] text-gray-400">+${miembros.length - 3} más</span>` : ''}</div>` : ''}
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <button data-editar="${e.id}" class="adminEditarBtn px-2.5 py-1.5 bg-blue-50 text-blue-700 text-xs font-medium rounded-lg hover:bg-blue-100 transition-base">
                ✏️ Editar
              </button>
              <button data-eliminar="${e.id}" data-nombre="${e.nombre}" class="adminEliminarBtn px-2.5 py-1.5 bg-red-50 text-red-700 text-xs font-medium rounded-lg hover:bg-red-100 transition-base">
                🗑️ Eliminar
              </button>
            </div>
          </div>
        </div>
      `;
    }).join('');

    bindEventListeners();
  }

  function bindEventListeners() {
    document.querySelectorAll('.adminEditarBtn').forEach((btn) => {
      btn.addEventListener('click', () => abrirEditar((btn as HTMLElement).dataset.editar!));
    });
    document.querySelectorAll('.adminEliminarBtn').forEach((btn) => {
      btn.addEventListener('click', () => eliminarEstok((btn as HTMLElement).dataset.eliminar!, (btn as HTMLElement).dataset.nombre!));
    });
  }

  // ===========================================================================
  // MODAL (crear / editar)
  // ===========================================================================
  function abrirModal(titulo: string) {
    modalTitle.textContent = titulo;
    formError.classList.add('hidden');
    modal.classList.remove('hidden');
    document.getElementById('fNombre')!.focus();
  }

  function cerrarModal() {
    modal.classList.add('hidden');
    editandoId = null;
    estokForm.reset();
  }

  nuevoEstokBtn?.addEventListener('click', () => {
    editandoId = null;
    abrirModal('➕ Nuevo Estok');
  });

  document.getElementById('cerrarModalBtn')?.addEventListener('click', cerrarModal);
  document.getElementById('cancelarBtn')?.addEventListener('click', cerrarModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) cerrarModal();
  });

  async function abrirEditar(id: string) {
    editandoId = id;
    abrirModal('✏️ Editar Estok');

    try {
      const e = await apiGet<any>(`/admin/estoks/${id}/`);
      (document.getElementById('fNombre') as HTMLInputElement).value = e.nombre || '';
      (document.getElementById('fDescripcion') as HTMLTextAreaElement).value = e.descripcion || '';
    } catch {
      setFormError('No se pudo cargar el Estok para editar.');
    }
  }

  // ===========================================================================
  // GUARDAR (crear o actualizar)
  // ===========================================================================
  estokForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.classList.add('hidden');
    if (cargando) return;
    cargando = true;
    guardarBtn.textContent = 'Guardando...';
    guardarBtn.setAttribute('disabled', 'true');

    const body = {
      nombre: (document.getElementById('fNombre') as HTMLInputElement).value.trim(),
      descripcion: (document.getElementById('fDescripcion') as HTMLTextAreaElement).value.trim(),
    };

    try {
      if (editandoId) {
        await apiPatch(`/admin/estoks/${editandoId}/`, body);
        (window as any).showSuccess?.('✅ Estok actualizado');
      } else {
        await apiPost('/admin/estoks/', body);
        (window as any).showSuccess?.('✅ Estok creado');
      }
      cerrarModal();
      cargarEstoks();
    } catch (err: any) {
      setFormError(err?.error || 'Error al guardar el Estok.');
    } finally {
      cargando = false;
      guardarBtn.textContent = 'Guardar';
      guardarBtn.removeAttribute('disabled');
    }
  });

  // ===========================================================================
  // ELIMINAR (borrado físico del inquilino - cascada)
  // ===========================================================================
  async function eliminarEstok(id: string, nombre: string) {
    if (!confirm(
      `⚠️ ¿ELIMINAR el Estok "${nombre}"?\n\n` +
      'ATENCIÓN: esto borra el inquilino y TODOS sus datos en cascada\n' +
      '(objetos, ubicaciones, contenedores, membresías, códigos, historial).\n\n' +
      'Esta acción es IRREVERSIBLE.'
    )) return;

    try {
      await apiDelete(`/admin/estoks/${id}/`);
      (window as any).showSuccess?.(`🗑️ Estok "${nombre}" eliminado`);
      cargarEstoks();
    } catch (err: any) {
      showError(err?.error || 'Error al eliminar el Estok.');
    }
  }
</script>
