---
// =============================================================================
// PÁGINA DE MUDANZA INTER-ESTOK (experiencia móvil y escritorio)
// Grilla simétrica de DOS COLUMNAS SIEMPRE lado a lado (grid grid-cols-2,
// gap ampliado desde sm) — nunca se apila en vertical:
//   - Columna IZQUIERDA: Estok Origen → índice de inventario móvil arrastrable
//     (cajas tipo='CAJA', muebles móviles y objetos individuales sueltos).
//   - Columna DERECHA : Estok Destino → MINIMAPAS INTERACTIVOS del plano real
//     (siluetas proporcionales de habitaciones, muebles y estantes con su
//     geometría ui_* persistida) + zona estática «En Tránsito» (limbo sin
//     ubicación física). Cada silueta es una zona de suelta: el ítem se arrastra
//     desde el Origen y se suelta ENCIMA del ambiente o del mueble.
// Cada columna tiene ALTURA FIJA (h-[calc(100vh-190px)]) y su propio scroll
// independiente (overflow-y-auto en el panel), tanto en móvil como en desktop.
// La lógica vive en src/lib/mudanzaBoard.ts (orquestación de DnD + toque),
// src/lib/mudanzaInventario.ts (columna Origen) y src/lib/mudanzaMapaDestino.ts
// + mudanzaMapaDestinoRender.ts (mapa de minimapas del Destino), para mantener
// la página liviana.
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import AuthGuard from '../components/AuthGuard.astro';
import LoadingState from '../components/LoadingState.astro';
import ErrorState from '../components/ErrorState.astro';
// Componente GLOBAL de minimapas: host de la migaja de procedencia del Estok
// destino. mudanzaBoard.ts lo rellena en caliente con el MISMO motor
// (lib/minimapasAnidados.ts) que Almacenamiento y Objetos.
import MinimapaRuta from '../components/MinimapaRuta.astro';
import '../styles/mudanza.css';
// Estilos del mapa de minimapas del Destino (siluetas + chips de navegación).
import '../styles/mudanza-mapa.css';
---

<AuthGuard />

<BaseLayout title="Estok - Mudanza Inter-Estok | Inventario">
  <div id="mudanzaPage"
    class="mx-auto h-screen max-w-7xl overflow-hidden px-2 py-2 sm:px-6 sm:py-8 lg:px-8 md:h-auto md:overflow-visible"
    style="background-color: var(--bg-primary)">
    <!-- Encabezado (compacto en móvil: el alto de la cabecera real se mide en
         caliente para que ninguna columna quede recortada por el padre). -->
    <div class="mb-2 sm:mb-8">
      <h1 class="text-lg font-bold text-gray-900 sm:text-3xl">📦 Mudanza Inter-Estok</h1>
      <p class="mt-1 hidden text-base text-gray-500 sm:block">
        Arrastrá cajas móviles, muebles o ítems sueltos desde el Estok Origen hacia una habitación del
        Estok Destino —o hacia <b>«En Tránsito»</b> para dejarlos sin ubicación física—. El contenido
        viaja en bloque, en cascada y en una sola transacción.
      </p>
    </div>

    <LoadingState mensaje="Cargando tus Estoks..." />
    <ErrorState mensaje="Necesitás al menos dos Estoks activos para realizar una mudanza." />

    <!-- ================================================================
         GRILLA SIMÉTRICA DE DOS COLUMNAS (SIEMPRE lado a lado, también en
         móvil): Origen a la izquierda, Destino a la derecha.
         MÓVIL: el padre queda CONGELADO (h-screen + overflow-hidden) para que
         el <body> no se mueva y el gesto lo resuelva cada panel. `max-h-full`
         evita que las columnas se recorten por debajo del viewport (causa del
         scroll "trabado"). DESKTOP: `md:h-auto md:overflow-visible` devuelve el
         flujo natural del documento.
         ================================================================ -->
    <div id="mudanzaMain"
      class="relative hidden grid h-screen max-h-full grid-cols-2 gap-2 overflow-hidden sm:gap-4 lg:gap-8 md:h-auto md:max-h-none md:overflow-visible">

      <!-- COLUMNA IZQUIERDA: ESTOK ORIGEN -->
      <section
        class="mudanza-col flex h-[calc(100vh-160px)] max-h-full min-w-0 flex-col rounded-xl border border-gray-200 bg-white p-2 shadow-sm sm:rounded-2xl sm:p-4 md:h-auto md:max-h-none">
        <div class="mb-1.5 shrink-0 sm:mb-4">
          <div class="mb-0.5 flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-red-500"></span>
            <h2 class="truncate text-[13px] font-semibold text-gray-900 sm:text-lg">Estok Origen</h2>
          </div>
          <p class="mb-2 hidden text-xs text-gray-400 sm:block">
            Cajas móviles y objetos sueltos (arrastrá o tocá una tarjeta)
          </p>
          <label for="mudanzaOrigenSel" class="sr-only">Estok de origen</label>
          <select id="mudanzaOrigenSel"
            class="w-full rounded-lg border border-gray-300 px-2 py-1 text-[11px] outline-none transition-base focus:border-blue-500 focus:ring-2 focus:ring-blue-500 sm:px-3 sm:py-2 sm:text-sm"></select>
          <!-- Filtros reactivos del ORIGEN (cliente, sin peticiones) -->
          <div id="mudanzaFiltrosOrigen" class="mt-1.5"></div>
        </div>
        <div id="mudanzaOrigenMapa"
          class="mudanza-panel min-h-0 flex-1 overflow-y-auto p-1.5 sm:p-3 md:max-h-[calc(100vh-230px)]">
          <div class="flex flex-col items-center gap-3 py-8 sm:py-10">
            <span class="w-6 h-6 rounded-full border-2 border-gray-200 border-t-orange-500 animate-spin"></span>
            <p class="text-[11px] font-medium text-gray-400 sm:text-xs">Cargando inventario móvil…</p>
          </div>
        </div>
      </section>

      <!-- ================================================================
           BOTÓN DE INTERCAMBIO RÁPIDO (FLIP) Origen ⇄ Destino
           Flota ABSOLUTO sobre el hueco central de la grilla a cualquier
           ancho (no ocupa celda de la grilla) para no romper las dos
           columnas lado a lado en móvil.
           ================================================================ -->
      <button id="mudanzaSwapBtn" type="button"
        class="absolute left-1/2 top-8 z-20 inline-flex h-8 w-8 -translate-x-1/2 items-center justify-center rounded-full border border-amber-300 bg-amber-50 text-amber-700 shadow-sm outline-none transition-base hover:bg-amber-100 hover:text-orange-700 hover:shadow-md focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 active:scale-95 disabled:cursor-wait disabled:opacity-60 sm:top-20 sm:h-11 sm:w-11"
        title="Intercambiar Estok Origen ⇄ Destino"
        aria-label="Intercambiar Estok Origen y Estok Destino">
        <svg class="mudanza-swap-icon h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m16 3 4 4-4 4"></path>
          <path d="M20 7H4"></path>
          <path d="m8 21-4-4 4-4"></path>
          <path d="M4 17h16"></path>
        </svg>
      </button>

      <!-- COLUMNA DERECHA: ESTOK DESTINO -->
      <section
        class="mudanza-col flex h-[calc(100vh-160px)] max-h-full min-w-0 flex-col rounded-xl border border-gray-200 bg-white p-2 shadow-sm sm:rounded-2xl sm:p-4 md:h-auto md:max-h-none">
        <div class="mb-1.5 shrink-0 sm:mb-4">
          <div class="mb-0.5 flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-green-500"></span>
            <h2 class="truncate text-[13px] font-semibold text-gray-900 sm:text-lg">Estok Destino</h2>
          </div>
          <p class="mb-2 hidden text-xs text-gray-400 sm:block">
            Plano real del Estok: soltá sobre la silueta de la habitación o del mueble
          </p>
          <label for="mudanzaDestinoSel" class="sr-only">Estok de destino</label>
          <select id="mudanzaDestinoSel"
            class="w-full rounded-lg border border-gray-300 px-2 py-1 text-[11px] outline-none transition-base focus:border-blue-500 focus:ring-2 focus:ring-blue-500 sm:px-3 sm:py-2 sm:text-sm"></select>
          <!-- Filtros reactivos del DESTINO: escala de la suelta (gruesa/fina) -->
          <div id="mudanzaFiltrosDestino" class="mt-1.5"></div>
          <!-- MINIMAPAS INTERACTIVOS: migaja de procedencia (componente global).
               El tablero lo rellena en caliente en cada repintado del mapa. -->
          <MinimapaRuta id="mudanzaDestinoRuta" class="mt-1.5" />
        </div>

        <!-- ZONA ESTÁTICA «EN TRÁNSITO»: receptora de sueltas SIN ubicación
             física, fuera del scroll del plano para estar siempre visible. -->
        <div id="mudanzaTransito" class="mb-1.5 shrink-0 sm:mb-3"></div>

        <div id="mudanzaDestinoMapa"
          class="mudanza-panel min-h-0 flex-1 overflow-y-auto p-1.5 sm:p-3 md:max-h-[calc(100vh-230px)]">
          <div class="flex flex-col items-center gap-3 py-8 sm:py-10">
            <span class="w-6 h-6 rounded-full border-2 border-gray-200 border-t-green-500 animate-spin"></span>
            <p class="text-[11px] font-medium text-gray-400 sm:text-xs">Cargando plano del destino…</p>
          </div>
        </div>
      </section>
    </div>

    <!-- Ayuda de uso (solo desktop: en móvil el padre congelado la recortaría) -->
    <div class="mt-3 hidden rounded-xl border border-gray-200 bg-white px-3 py-3 text-[11px] text-gray-500 sm:mt-8 sm:px-5 sm:py-4 sm:text-sm md:block">
      <span class="font-semibold text-gray-700">Cómo funciona:</span>
      el índice del <b>Origen</b> lista inventario móvil (cajas tipo CAJA, muebles móviles e ítems
      sueltos —incluso los que no tienen ubicación—); los muebles inmuebles fijos no se mudan.
      Arrastrá una tarjeta (en móvil: tocá la tarjeta y luego el destino) y soltala sobre la
      <b>silueta</b> de la habitación del <b>Destino</b> en el plano de minimapas: el backend re-ancla
      el elemento y su contenido completo al Estok destino en una sola transacción. Entrá a un
      ambiente desde los chips «Abrir un ambiente» para ver el plano interior y soltar dentro de un
      <b>mueble o estante</b> concreto. Si la soltás en <b>«En Tránsito»</b>, viaja igual al Estok
      destino pero SIN ubicación física: queda en el limbo del nuevo inquilinato para ubicarlo luego
      desde Almacenamiento. Usá las barras de <b>filtros</b> para acotar qué querés mudar (objetos
      sueltos, muebles, cajas) y a qué escala querés soltarlo (habitación completa, un mueble o un estante).
    </div>
  </div>

  <script>
    import { getCachedUser, fetchCurrentUser } from '../services/auth';
    import { MudanzaBoard } from '../lib/mudanzaBoard';

    const loadingState = document.getElementById('loadingState')!;
    const errorState = document.getElementById('errorState')!;
    const errorMessage = document.getElementById('errorMessage')!;
    const retryBtn = document.getElementById('retryBtn')!;
    const main = document.getElementById('mudanzaMain')!;
    const origenSel = document.getElementById('mudanzaOrigenSel') as HTMLSelectElement;
    const destinoSel = document.getElementById('mudanzaDestinoSel') as HTMLSelectElement;
    const mapaOrigen = document.getElementById('mudanzaOrigenMapa')!;
    const mapaDestino = document.getElementById('mudanzaDestinoMapa')!;
    const transito = document.getElementById('mudanzaTransito')!;
    const filtrosOrigen = document.getElementById('mudanzaFiltrosOrigen')!;
    const filtrosDestino = document.getElementById('mudanzaFiltrosDestino')!;
    const rutaDestino = document.getElementById('mudanzaDestinoRuta')!;
    const paginaMudanza = document.getElementById('mudanzaPage')!;
    const swapBtn = document.getElementById('mudanzaSwapBtn') as HTMLButtonElement | null;

    // =========================================================================
    // CONTENCIÓN DEL VIEWPORT TÁCTIL (solo móvil < 768px)
    // -------------------------------------------------------------------------
    // La cabecera real de la app (nav + fila de Estok + barras móviles + título)
    // cambia de alto según el dispositivo, así que el alto útil se MIDE en
    // caliente y se lo aplica al contenedor congelado. Sin esto, las columnas
    // (100vh - 160px) se extienden por debajo del viewport, el padre con
    // overflow-hidden las recorta y el paneo interno se percibe "trabado".
    // En desktop se limpia todo: el documento fluye normal (md:h-auto).
    // =========================================================================
    const soloMovil = (): boolean => window.matchMedia('(max-width: 767px)').matches;

    function ajustarViewportMovil(): void {
      if (!soloMovil()) {
        paginaMudanza.style.height = '';
        document.body.classList.remove('mudanza-scroll-lock');
        return;
      }
      // Offset DOCUMENTAL de la cabecera real (estable aunque ya haya scroll).
      const cabeceraReal = paginaMudanza.getBoundingClientRect().top + window.scrollY;
      const altoUtil = Math.max(320, Math.round(window.innerHeight - cabeceraReal));
      paginaMudanza.style.height = `${altoUtil}px`;
      if (!document.body.classList.contains('mudanza-scroll-lock')) {
        window.scrollTo(0, 0); // al congelar, el layout arranca desde arriba
        document.body.classList.add('mudanza-scroll-lock');
      }
    }

    window.addEventListener('resize', ajustarViewportMovil);
    window.addEventListener('orientationchange', ajustarViewportMovil);
    window.visualViewport?.addEventListener('resize', ajustarViewportMovil);

    async function iniciar() {
      try {
        let user = getCachedUser();
        if (!user || (user.estoks?.length || 0) < 2) {
          user = await fetchCurrentUser();
        }
        // Requisito estricto: > 1 Estok activo en el arreglo de membresías.
        if (!user || (user.estoks?.length || 0) < 2) {
          loadingState.classList.add('hidden');
          errorMessage.textContent = 'Necesitás al menos dos Estoks activos para realizar una mudanza. Creá o uníte a otro Estok desde "Mis Estoks".';
          errorState.classList.remove('hidden');
          return;
        }
        loadingState.classList.add('hidden');
        main.classList.remove('hidden');
        // Congelado del layout recién cuando la mudanza está activa.
        ajustarViewportMovil();
        const board = new MudanzaBoard({
          origenSel,
          destinoSel,
          mapaOrigen,
          mapaDestino,
          swapBtn,
          transito,
          filtrosOrigen,
          filtrosDestino,
          rutaDestino,
        });
        await board.init(user.estoks);
      } catch (err: any) {
        loadingState.classList.add('hidden');
        errorMessage.textContent = err?.error || err?.message || 'Error al inicializar la mudanza.';
        errorState.classList.remove('hidden');
      }
    }

    retryBtn.addEventListener('click', () => {
      errorState.classList.add('hidden');
      loadingState.classList.remove('hidden');
      void iniciar();
    });

    void iniciar();
  </script>
</BaseLayout>

