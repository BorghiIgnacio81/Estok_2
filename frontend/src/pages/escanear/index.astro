---
// =============================================================================
// PÁGINA DE ESCÁNER QR MOBILE
// Usa la cámara del móvil para escanear QR de contenedores y redirige al
// detalle. Toda la lógica vive en lib/escanerQr.ts (jsQR empaquetado, permisos,
// rendimiento en móvil y fallback por foto); la página sólo monta el markup.
// =============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthGuard from '../../components/AuthGuard.astro';
---

<AuthGuard />

<BaseLayout title="Estok - Escáner QR | Inventario">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Encabezado -->
    <div class="mb-8">
      <a href="/almacenamiento" class="inline-flex items-center text-sm text-gray-500 hover:text-blue-700 transition-base mb-4">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Volver a almacenamiento
      </a>
      <h1 class="text-3xl font-bold text-gray-900">Escáner QR</h1>
      <p class="mt-1 text-gray-500">Escanea el código QR de un contenedor para ver su contenido</p>
    </div>

    <!-- Estado: cámara no disponible o permiso bloqueado -->
    <div id="noCamera" class="hidden bg-amber-50 border border-amber-200 text-amber-700 px-6 py-4 rounded-xl text-center">
      <svg class="w-12 h-12 mx-auto mb-3 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <p class="font-medium mb-1">Cámara no disponible</p>
      <p id="cameraErrorText" class="text-sm"></p>
      <div class="mt-4 flex flex-col sm:flex-row gap-2 justify-center">
        <button id="retryCameraBtn" type="button"
          class="px-4 py-2.5 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-base text-sm font-medium">
          Reintentar cámara
        </button>
        <a href="/almacenamiento" class="px-4 py-2.5 bg-amber-100 text-amber-700 rounded-lg hover:bg-amber-200 transition-base text-sm font-medium">
          Ir a almacenamiento
        </a>
      </div>
    </div>

    <!-- Estado: Escaneando -->
    <div id="scanningState" class="text-center">
      <div class="relative bg-black rounded-xl overflow-hidden mx-auto max-w-sm mb-4">
        <video id="video" class="w-full aspect-square object-cover" autoplay playsinline muted></video>
        <!-- Marco de escaneo -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <div class="w-48 h-48 border-2 border-blue-400 rounded-xl opacity-70">
            <div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-blue-500 rounded-tl"></div>
            <div class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-blue-500 rounded-tr"></div>
            <div class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-blue-500 rounded-bl"></div>
            <div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-blue-500 rounded-br"></div>
          </div>
        </div>
        <!-- Línea de escaneo animada -->
        <div id="scanLine" class="absolute left-12 right-12 h-0.5 bg-blue-500 opacity-60 animate-scan"></div>
      </div>
      <p class="text-gray-500 text-sm">Enfoca el código QR del contenedor</p>
      <p id="scanStatus" class="text-xs text-gray-400 mt-1">Buscando QR...</p>
    </div>


    <!-- Resultado del escaneo -->
    <div id="resultState" class="hidden bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-center">
      <div id="resultSpinner" class="mb-4">
        <svg class="animate-spin h-10 w-10 mx-auto text-blue-700" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" />
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
        </svg>
      </div>
      <p id="resultText" role="status" aria-live="polite" class="text-gray-700 font-medium">QR detectado. Buscando contenedor...</p>
    </div>

    <!-- Controles -->
    <div class="text-center mt-6 space-y-3">
      <button id="stopBtn" type="button" class="px-6 py-3 bg-red-600 text-white font-medium rounded-lg hover:bg-red-700 transition-base shadow-sm">
        <span id="stopText">⏹ Detener escáner</span>
      </button>
      <button id="retryScanBtn" type="button" class="hidden px-6 py-3 bg-blue-700 text-white font-medium rounded-lg hover:bg-blue-800 transition-base shadow-sm">
        🔄 Escanear otro QR
      </button>

      <!-- Fallback universal: decodifica un QR desde cámara o galería.
           Sirve cuando el navegador/WebView bloquea getUserMedia o no hay HTTPS.
           Sin `capture` para que iOS/Android ofrezcan cámara Y galería. -->
      <div>
        <label class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-white border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-base cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Escanear desde una foto
          <input id="qrFileInput" type="file" accept="image/*" class="hidden" />
        </label>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  @keyframes scan {
    0%, 100% { top: 25%; }
    50% { top: 75%; }
  }
  .animate-scan {
    animation: scan 2s ease-in-out infinite;
  }
</style>

<script>
  import { initEscanerQr } from '../../lib/escanerQr';

  initEscanerQr();
</script>
