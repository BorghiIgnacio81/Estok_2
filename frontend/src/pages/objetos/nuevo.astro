---
// =============================================================================
// PÁGINA DE CARGA MANUAL DE OBJETO (Mobile-First)
// -----------------------------------------------------------------------------
// Formulario de carga manual completa con captura de foto + editor de imagen.
// El botón "Autocompletar con IA" vive en UN solo lugar: la botonera de "Fotos
// del Objeto" (celda contigua a "Otra foto"), con su estado centralizado en
// lib/botonAutocompletarIA.ts; la ubicación se elige con MINIMAPAS INTERACTIVOS
// (siluetas elásticas de plantas, habitaciones y muebles) y el dueño puede ser
// un usuario del Estok o un DUEÑO EXTERNO registrado como texto plano.
//
// Comportamiento en el cliente: TODO el <script> se desmanteló a módulos con
// responsabilidad única en src/lib/objetos/ (regla de modularización <400
// líneas por archivo):
//   · objetoCamara.ts          → cámara/galería/drag&drop + galería multi-foto
//   · objetoAutocompletarIa.ts → botón IA + health-check Gemini + mapeo de campos
//   · objetoIaSegundaFoto.ts   → segunda foto (ISBN de libros)
//   · objetoMercadoLibre.ts    → precio de referencia (Mercado Libre AR)
//   · objetoCatalogos.ts       → catálogos + alta rápida de espacios
//   · objetoFormCore.ts        → persistencia, reset, validación y envío
// =============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import ObjetoFormFields from '../../components/objetos/ObjetoFormFields.astro';
import ObjetoFormActions from '../../components/objetos/ObjetoFormActions.astro';
import NuevoObjetoEncabezado from '../../components/objetos/NuevoObjetoEncabezado.astro';
import ModalExitoObjeto from '../../components/objetos/ModalExitoObjeto.astro';
import AuthGuard from '../../components/AuthGuard.astro';
import ImageEditor from '../../components/ImageEditor.astro';
// Estilos compartidos de los minimapas anidados (.mini-anidado-*): único punto
// que ya cubre Almacenamiento y Objetos. No se duplican reglas en esta página.
import '../../styles/almacenamiento-portales.css';
---

<AuthGuard />

<BaseLayout title="Estok - Nuevo Objeto | Carga Manual">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <NuevoObjetoEncabezado />

    <!-- Formulario -->
    <form id="objetoForm" class="space-y-6">
      <!-- ================================================================ -->
      <!-- CAMPOS DEL FORMULARIO: componentes atomicos                  -->
      <!-- CapturaFotosCompacta : drag & drop compacto + camara/galeria  -->
      <!-- AutocompletarIA      : progreso/resultado IA (sin boton)     -->
      <!-- SelectorMinimapa     : ubicacion por minimapas interactivos   -->
      <!-- LegadoTrazabilidad   : dueno original (+ externo) / beneficiario -->
      <!-- ObjetoFormActions    : boton submit + cancelar                -->
      <!-- ================================================================ -->
      <ObjetoFormFields />
      <ObjetoFormActions />
    </form>
  </div>

  <!-- Image Editor Component (Modal) -->
  <ImageEditor imageSrc="" />

  <!-- Modal de éxito direccional (se abre solo tras un 201 Created) -->
  <ModalExitoObjeto />
</BaseLayout>

<script>
  // ===========================================================================
  // ORQUESTADOR DE LA CARGA MANUAL DE OBJETO
  // ---------------------------------------------------------------------------
  // La página NO contiene lógica de negocio: cada bloque vive en su módulo de
  // src/lib/objetos/ (responsabilidad única, <400 líneas). Este script solo los
  // inicializa en el orden del ciclo de vida del DOM.
  // ===========================================================================
  import { initObjetoCamara } from '../../lib/objetos/objetoCamara';
  import { initObjetoAutocompletarIa } from '../../lib/objetos/objetoAutocompletarIa';
  import { initObjetoIaSegundaFoto } from '../../lib/objetos/objetoIaSegundaFoto';
  import { initObjetoMercadoLibre } from '../../lib/objetos/objetoMercadoLibre';
  import { initObjetoCatalogos } from '../../lib/objetos/objetoCatalogos';
  import { initObjetoFormCore } from '../../lib/objetos/objetoFormCore';

  initObjetoCamara();
  initObjetoAutocompletarIa();
  initObjetoIaSegundaFoto();
  initObjetoMercadoLibre();
  initObjetoCatalogos();
  initObjetoFormCore();
</script>
