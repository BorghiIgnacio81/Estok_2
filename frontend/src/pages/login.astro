---
// Usamos un layout completamente limpio o una estructura HTML cruda para que NO aparezca el menú superior
let error = '';
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Iniciar Sesión - Estok</title>
</head>
<body class="bg-[#0b0f19] min-h-screen flex flex-col justify-center items-center p-4 font-sans select-none">

  <!-- Título Principal Superior Fuera del Mueble -->
  <div class="text-center mb-4">
    <h1 class="text-3xl font-extrabold text-white tracking-tight">Estok</h1>
    <p class="text-xs text-gray-400 mt-0.5">Sistema de Inventario Personal</p>
  </div>

  <!-- EL CONTENEDOR ANCHO DEL ARCHIVADOR: Eliminamos el recuadro blanco y sus bordes -->
  <!-- bg-[size:100%_100%] obliga a expandir el gráfico de borde a borde lateral ocupando todo el ancho -->
  <div 
    class="relative w-full max-w-[360px] h-[360px] bg-center bg-no-repeat overflow-hidden"
    style="background-image: url('/archivador-login.png'); background-size: 100% 100%;"
  >
    <!-- Filtro para disimular los cuadraditos falsos del PNG y dar contraste -->
    <div class="absolute inset-0 bg-slate-950/20 backdrop-blur-[0.5px] -z-10"></div>

    <!-- Título del Formulario encajado en la frente/orejas del gato -->
    <div class="absolute left-0 right-0 top-[6%] text-center px-4">
      <h2 class="text-base font-bold text-white drop-shadow-md">Iniciar Sesión</h2>
    </div>

    <form id="loginForm" class="absolute inset-0">
      <!-- INPUT USUARIO: Metido exactamente ADENTRO del segundo cajón (sin cajas blancas) -->
      <div class="absolute left-[14%] right-[14%] top-[34%]">
        <input 
          id="username" 
          name="username" 
          type="text" 
          required 
          placeholder="Tu usuario"
          class="w-full text-center text-sm font-bold text-white bg-transparent border-none outline-none focus:ring-0 ring-0 p-1"
        />
      </div>

      <!-- INPUT CONTRASEÑA: Metido exactamente ADENTRO del tercer cajón -->
      <div class="absolute left-[14%] right-[14%] top-[54%]">
        <div class="relative">
          <input 
            id="password" 
            name="password" 
            type="password" 
            required 
            placeholder="••••••"
            class="w-full text-center text-sm font-bold text-white bg-transparent border-none outline-none focus:ring-0 ring-0 p-1 pr-8"
          />
          <!-- Botón Ojo absoluto a la derecha interna del cajón -->
          <button
            id="togglePassword"
            type="button"
            class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white"
          >
            <svg id="eyeOpen" class="h-4 w-4" xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <svg id="eyeClosed" class="hidden h-4 w-4" xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
            </svg>
          </button>
        </div>
      </div>

      <!-- BOTÓN INGRESAR: Escondido arriba del último cajón (Manija inferior) -->
      <div class="absolute left-[14%] right-[14%] top-[74%]">
        <button 
          type="submit" 
          id="submitBtn"
          class="w-full text-center text-sm font-bold text-white bg-blue-600/80 hover:bg-blue-600 py-1.5 rounded transition-all active:scale-[0.98]"
        >
          <span id="btnText">Ingresar</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Enlace inferior bien abajo separado de las patas -->
  <div class="text-center mt-4 text-sm">
    <a href="/register" class="text-blue-400 hover:text-blue-300 underline font-medium">¿No tienes cuenta? Registrarse</a>
  </div>

</body>
</html>

<script>
  import { login } from '../services/auth';

  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const togglePassword = document.getElementById('togglePassword') as HTMLButtonElement;
  const eyeOpen = document.getElementById('eyeOpen')!;
  const eyeClosed = document.getElementById('eyeClosed')!;

  togglePassword?.addEventListener('click', () => {
    const isHidden = passwordInput.type === 'password';
    passwordInput.type = isHidden ? 'text' : 'password';
    eyeOpen.classList.toggle('hidden', !isHidden);
    eyeClosed.classList.toggle('hidden', isHidden);
    passwordInput.focus();
  });

  const loginForm = document.getElementById('loginForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const btnText = document.getElementById('btnText')!;

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(loginForm);
    const username = formData.get('username') as string;
    const password = formData.get('password') as string;

    try {
      submitBtn.disabled = true;
      btnText.textContent = '...';
      
      const success = await login({ username, password });
      if (success) {
        window.location.href = '/';
      } else {
        alert('Credenciales inválidas');
        submitBtn.disabled = false;
        btnText.textContent = 'Ingresar';
      }
    } catch (err) {
      alert('Error de conexión');
      submitBtn.disabled = false;
      btnText.textContent = 'Ingresar';
    }
  });
</script>
