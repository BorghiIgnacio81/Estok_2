---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout title="Iniciar Sesión - Estok" bare>
  <style is:global>
    /* Chrome/Edge: el autofill pinta fondo celeste y rompe la transparencia */
    #username:-webkit-autofill,
    #password:-webkit-autofill {
      -webkit-text-fill-color: #f6efe3 !important;
      -webkit-box-shadow: 0 0 0 1000px transparent inset !important;
      background-color: transparent !important;
      transition: background-color 9999s ease-out 0s !important;
    }

    /* El cartel de error entra deslizándose en vez de aparecer de golpe */
    #loginError:not(.hidden) {
      animation: login-error-in 0.28s ease-out both;
    }

    @keyframes login-error-in {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>

  <div class="min-h-screen bg-[#cfd5e2] flex flex-col justify-center items-center p-4 select-none">

    <!-- Título Principal Superior -->
    <div class="text-center mb-6 z-10">
      <h1 class="text-3xl font-extrabold text-[#1e293b] tracking-tight">Estok</h1>
      <p class="text-xs text-gray-600 mt-1">Sistema de Inventario Personal</p>
    </div>

    <!-- CÓMODA: cada % está calibrado sobre archivador-login.png
         (frente de cajones x 38.5%-76.5% y centros verticales 43% / 52% / 62%) -->
    <div
      class="relative w-full max-w-[420px] h-[390px] overflow-visible rounded-3xl"
      style="
        background-image: url('/archivador-login.png');
        background-size: 100% 100%;
        background-position: center;
        box-shadow: inset 0 0 40px 30px #cfd5e2;
      "
    >
      <div class="absolute inset-0 z-10">

        <!-- Rótulo del panel: margen blanco superior, alineado a la columna de cajones -->
        <div class="absolute left-[38.5%] right-[23.5%] top-[7%] text-center">
          <h2 class="text-xs font-bold text-white drop-shadow-md tracking-wider uppercase bg-slate-950/60 py-0.5 rounded max-w-[120px] mx-auto">
            Iniciar Sesión
          </h2>
        </div>

        <form id="loginForm" class="absolute inset-0">

          <!-- CAJÓN 2 · USUARIO: texto transparente centrado sobre la madera -->
          <div class="absolute left-[38.5%] right-[23.5%] top-[43%] -translate-y-1/2">
            <input
              id="username"
              name="username"
              type="text"
              required
              autocomplete="username"
              placeholder="Usuario"
              class="w-full h-[30px] bg-transparent border-none px-2 py-0 text-center text-[13px] font-semibold tracking-[0.06em] text-[#f6efe3] outline-none ring-0 shadow-none focus:border-transparent focus:ring-0 placeholder:text-[#f6efe3]/55 [text-shadow:0_1px_2px_rgba(15,23,42,0.55)] transition-colors duration-200"
            />
          </div>

          <!-- CAJÓN 3 · CONTRASEÑA: cajón relativo + ojo absoluto en el extremo derecho -->
          <div class="absolute left-[38.5%] right-[23.5%] top-[52%] -translate-y-1/2">
            <div class="relative">
              <input
                id="password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
                placeholder="Contraseña"
                class="w-full h-[30px] bg-transparent border-none px-8 py-0 text-center text-[13px] font-semibold tracking-[0.06em] text-[#f6efe3] outline-none ring-0 shadow-none focus:border-transparent focus:ring-0 placeholder:text-[#f6efe3]/55 [text-shadow:0_1px_2px_rgba(15,23,42,0.55)] transition-colors duration-200"
              />

              <button
                id="togglePassword"
                type="button"
                aria-label="Mostrar u ocultar la contraseña"
                class="absolute right-3 top-1/2 -translate-y-1/2 bg-transparent border-0 p-0 text-[#f6efe3]/65 hover:text-white focus:outline-none transition-colors duration-200"
              >
                <svg id="eyeOpen" class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>

                <svg id="eyeClosed" class="hidden h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 01-1.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                </svg>
              </button>
            </div>
          </div>

          <!-- CAJÓN 4 · INGRESAR: etiqueta manuscrita levemente inclinada -->
          <div class="absolute left-[38.5%] right-[23.5%] top-[62%] -translate-y-1/2">
            <button
              type="submit"
              id="submitBtn"
              class="w-full h-[30px] bg-transparent border-none px-2 py-0 text-center text-[13px] font-bold uppercase tracking-[0.22em] text-[#f6efe3] outline-none shadow-none -rotate-1 transition-transform duration-200 active:scale-90 [text-shadow:0_1px_3px_rgba(15,23,42,0.6)]"
            >
              Ingresar
            </button>
          </div>

          <!-- BASE DE LA CÓMODA · recuperación de contraseña sobre el margen blanco -->
          <div class="absolute inset-x-[8%] top-[83.5%] text-center">
            <a
              id="forgotPassword"
              href="#"
              class="group relative inline-block text-[11px] font-medium tracking-wide text-slate-600 hover:text-slate-900 cursor-pointer transition-colors duration-200 focus:outline-none"
            >
              ¿Olvidó su contraseña?
              <span class="pointer-events-none absolute -bottom-0.5 left-0 h-px w-0 bg-slate-800/80 transition-all duration-200 group-hover:w-full"></span>
            </a>
          </div>
        </form>

        <!-- CARTEL DE ERROR · pill simétrico en la base, justo bajo el enlace de recuperación -->
        <div id="loginError" role="alert" aria-live="assertive" class="hidden absolute inset-x-[7%] bottom-[3%] z-20">
          <div class="flex items-center justify-center gap-2 rounded-xl bg-red-50/90 px-3 py-1.5 text-[11px] font-medium tracking-wide text-red-700 ring-1 ring-red-300/60 shadow-sm backdrop-blur-[2px]">
            <svg class="h-3.5 w-3.5 shrink-0 text-red-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
            </svg>
            <span id="loginErrorText"></span>
          </div>
        </div>

      </div>
    </div>

    <!-- Enlace inferior · registro -->
    <div class="text-center mt-6 text-xs">
      <a
        href="/register"
        class="group relative inline-block font-medium tracking-wide text-slate-600 hover:text-slate-900 cursor-pointer transition-colors duration-200"
      >
        ¿No tienes cuenta? Registrarse
        <span class="pointer-events-none absolute -bottom-0.5 left-0 h-px w-0 bg-slate-800/80 transition-all duration-200 group-hover:w-full"></span>
      </a>
    </div>

  </div>

  <!-- ================================================================ -->
  <!-- MODAL RECUPERAR CONTRASEÑA (flujo "Olvidó su contraseña") -->
  <!-- ================================================================ -->
  <div id="recoveryModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"></div>
    <div class="relative w-full max-w-sm bg-white rounded-2xl shadow-2xl p-6">
      <div class="flex items-start justify-between mb-3">
        <div>
          <h3 class="text-lg font-bold text-gray-900">🔑 Recuperar contraseña</h3>
          <p class="text-xs text-gray-500 mt-1">
            Ingresá el email de tu cuenta y te enviaremos una clave temporal.
          </p>
        </div>
        <button
          id="recoveryClose"
          type="button"
          class="text-gray-400 hover:text-gray-700 transition-colors"
          aria-label="Cerrar"
        >
          <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="recoveryForm" class="space-y-4">
        <div>
          <label for="recoveryEmail" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input
            id="recoveryEmail"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="tu@email.com"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base"
          />
        </div>

        <div id="recoveryMessage" class="text-sm text-center"></div>

        <div class="flex items-center justify-end gap-3">
          <button
            id="recoveryCancel"
            type="button"
            class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors"
          >
            Cancelar
          </button>
          <button
            type="submit"
            id="recoveryBtn"
            class="inline-flex items-center px-4 py-2 bg-blue-700 text-white text-sm font-medium rounded-lg hover:bg-blue-800 transition-base shadow-sm"
          >
            <span id="recoveryBtnText">Enviar</span>
          </button>
        </div>
      </form>
    </div>
  </div>

</AuthLayout> 
 
<script> 
  import { login, API_BASE_URL } from '../services/auth'; 
 
  const passwordInput = document.getElementById('password') as HTMLInputElement; 
  const usuarioInput = document.getElementById('username') as HTMLInputElement; 
  const togglePassword = document.getElementById('togglePassword') as HTMLButtonElement; 
  const eyeOpen = document.getElementById('eyeOpen')!; 
  const eyeClosed = document.getElementById('eyeClosed')!; 
 
  togglePassword?.addEventListener('click', () => { 
    const isHidden = passwordInput.type === 'password'; 
    passwordInput.type = isHidden ? 'text' : 'password'; 
    eyeOpen.classList.toggle('hidden', !isHidden); 
    eyeClosed.classList.toggle('hidden', isHidden); 
    passwordInput.focus(); 
  }); 
 
  const loginForm = document.getElementById('loginForm') as HTMLFormElement; 
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement; 
  const loginError = document.getElementById('loginError')!; 
  const loginErrorText = document.getElementById('loginErrorText')!; 

  // Alerta in-place de errores de login (nunca se recarga la página) 
  const MSG_CREDENCIALES = 'Usuario o contraseña incorrectos.'; 
  const MSG_CONEXION = 'Error de conexión con el servidor. Intentá de nuevo.'; 

  function mostrarError(mensaje: string): void { 
    loginErrorText.textContent = mensaje; 
    loginError.classList.remove('hidden'); 
  } 

  function limpiarError(): void { 
    loginErrorText.textContent = ''; 
    loginError.classList.add('hidden'); 
  } 

  function setCargando(cargando: boolean): void { 
    submitBtn.disabled = cargando; 
    submitBtn.textContent = cargando ? '...' : 'Ingresar'; 
  } 

  // El aviso desaparece apenas el usuario vuelve a escribir 
  usuarioInput?.addEventListener('input', limpiarError); 
  passwordInput?.addEventListener('input', limpiarError); 
 
  loginForm?.addEventListener('submit', async (e) => { 
    e.preventDefault(); 
    limpiarError(); 
    setCargando(true); 

    try { 
      // login() guarda los JWT en localStorage (estok_access_token / estok_refresh_token) 
      const result = await login({ 
        username: usuarioInput.value.trim(), 
        password: passwordInput.value, 
      }); 

      // Clave temporal (flujo "Olvidó su contraseña"): el token ya quedó guardado, 
      // pero se obliga a definir una clave nueva en el Perfil antes del Dashboard. 
      window.location.href = result.user?.tiene_clave_temporal ? '/perfil' : '/'; 
    } catch (err) { 
      const status = (err as { status?: number } | null)?.status; 
      mostrarError(status === 400 || status === 401 ? MSG_CREDENCIALES : MSG_CONEXION); 
      console.error('Login error:', err); 
    } finally { 
      setCargando(false); 
    } 
  }); 

  // ===========================================================================
  // FLUJO "¿OLVIDÓ SU CONTRASEÑA?"
  // Modal público → POST /api/usuarios/recuperar-password/ con el email.
  // ===========================================================================
  const forgotPassword = document.getElementById('forgotPassword')!;
  const recoveryModal = document.getElementById('recoveryModal')!;
  const recoveryForm = document.getElementById('recoveryForm') as HTMLFormElement;
  const recoveryEmail = document.getElementById('recoveryEmail') as HTMLInputElement;
  const recoveryClose = document.getElementById('recoveryClose')!;
  const recoveryCancel = document.getElementById('recoveryCancel')!;
  const recoveryBtn = document.getElementById('recoveryBtn') as HTMLButtonElement;
  const recoveryBtnText = document.getElementById('recoveryBtnText')!;
  const recoveryMessage = document.getElementById('recoveryMessage')!;

  function mostrarModalRecuperacion(visible: boolean): void {
    recoveryModal.classList.toggle('hidden', !visible);
    if (visible) recoveryEmail.focus();
  }

  forgotPassword?.addEventListener('click', (e) => {
    e.preventDefault();
    recoveryMessage.textContent = '';
    recoveryMessage.className = 'text-sm text-center';
    mostrarModalRecuperacion(true);
  });

  recoveryClose?.addEventListener('click', () => mostrarModalRecuperacion(false));
  recoveryCancel?.addEventListener('click', () => mostrarModalRecuperacion(false));

  recoveryModal?.addEventListener('click', (e) => {
    if (e.target === recoveryModal) mostrarModalRecuperacion(false);
  });

  recoveryForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = recoveryEmail.value.trim();
    if (!email) return;

    recoveryBtn.disabled = true;
    recoveryBtnText.textContent = 'Enviando...';
    recoveryMessage.textContent = '';
    recoveryMessage.className = 'text-sm text-center';

    try {
      const res = await fetch(`${API_BASE_URL}/usuarios/recuperar-password/`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok && data.success) {
        recoveryMessage.textContent = '📧 ' + (data.mensaje || 'Si el email coincide con una cuenta, recibirás tu clave temporal.');
        recoveryMessage.className = 'text-sm text-center text-green-600 font-medium';
        recoveryEmail.value = '';
      } else {
        recoveryMessage.textContent = data.error || 'No se pudo procesar la solicitud. Intentá de nuevo.';
        recoveryMessage.className = 'text-sm text-center text-red-600 font-medium';
      }
    } catch {
      recoveryMessage.textContent = 'Error de conexión. Intentá de nuevo.';
      recoveryMessage.className = 'text-sm text-center text-red-600 font-medium';
    } finally {
      recoveryBtn.disabled = false;
      recoveryBtnText.textContent = 'Enviar';
    }
  });
</script>



