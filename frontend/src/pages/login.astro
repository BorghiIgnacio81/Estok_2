---
import BaseLayout from '../layouts/BaseLayout.astro';
let error = '';
---

<BaseLayout title="Iniciar Sesión - Estok">
  <style is:global>
    header,
    nav,
    #global-navbar,
    [role="navigation"],
    .fixed.bottom-4.right-4,
    #chatContainer,
    button[class*="rounded-full"] {
      display: none !important;
    }

    /* Evita que Chrome/Edge coloque el fondo blanco/celeste del autofill */
    #username:-webkit-autofill,
    #username:-webkit-autofill:hover,
    #username:-webkit-autofill:focus,
    #password:-webkit-autofill,
    #password:-webkit-autofill:hover,
    #password:-webkit-autofill:focus {
      -webkit-text-fill-color: white !important;
      -webkit-box-shadow: 0 0 0px 1000px transparent inset !important;
      box-shadow: 0 0 0px 1000px transparent inset !important;
      background-color: transparent !important;
      transition: background-color 9999s ease-out 0s !important;
    }

    #username,
    #password {
      background: transparent !important;
      background-color: transparent !important;
      color: white !important;
      border: none !important;
      outline: none !important;
      box-shadow: none !important;
      -webkit-appearance: none;
      appearance: none;
    }

    #username::placeholder,
    #password::placeholder {
      color: rgba(255, 255, 255, 0.75) !important;
    }

    #username:focus,
    #password:focus {
      background: transparent !important;
      background-color: transparent !important;
      border: none !important;
      box-shadow: none !important;
      outline: none !important;
    }
  </style>

  <div class="min-h-screen bg-[#cfd5e2] flex flex-col justify-center items-center p-4 select-none">
    
    <!-- Título Principal Superior -->
    <div class="text-center mb-6 z-10">
      <h1 class="text-3xl font-extrabold text-[#1e293b] tracking-tight">
        Estok
      </h1>

      <p class="text-xs text-gray-600 mt-1">
        Sistema de Inventario Personal
      </p>
    </div>

    <!-- CONTENEDOR CON DIFUMINADO -->
    <div 
      class="relative w-full max-w-[420px] h-[390px] overflow-visible rounded-3xl"
      style="
        background-image: url('/archivador-login.png'); 
        background-size: 100% 100%; 
        background-position: center;
        box-shadow: inset 0 0 40px 30px #cfd5e2;
      "
    >
      
      <!-- CAPA DE FORMULARIO -->
      <div class="absolute inset-0 z-10">
        
        <!-- Título "Iniciar Sesión" -->
        <div class="absolute left-10 right-0 top-[7%] text-center px-4">
          <h2 class="text-xs font-bold text-white drop-shadow-md tracking-wider uppercase bg-slate-950/60 py-0.5 rounded max-w-[120px] mx-auto">
            Iniciar Sesión
          </h2>
        </div>

        <form id="loginForm" class="absolute inset-0">

          <!-- CAJÓN 2: Usuario -->
          <div class="absolute left-[39%] right-[21%] top-[37%]">
            <input 
              id="username" 
              name="username" 
              type="text" 
              required 
              autocomplete="username"
              placeholder="Usuario"
              class="!w-full !h-[26px] !text-center !text-sm !font-bold !text-white !bg-transparent !border-none !rounded-lg !outline-none !shadow-none !px-2 !py-0 transition-all placeholder:!text-white/75"
            />
          </div>

          <!-- CAJÓN 3: Contraseña -->
          <div class="absolute left-[40%] right-[21%] top-[48%]">
            <div class="relative">

              <input 
                id="password" 
                name="password" 
                type="password" 
                required 
                autocomplete="current-password"
                placeholder="Contraseña"
                class="!w-full !h-[26px] !text-center !text-sm !font-bold !text-white !bg-transparent !border-none !rounded-lg !outline-none !shadow-none !px-2 !py-0 !pr-8 transition-all placeholder:!text-white/75"
              />

              <button
                id="togglePassword"
                type="button"
                class="absolute right-2 top-1/2 -translate-y-1/2 !bg-transparent !border-none !p-0 !shadow-none text-gray-400 hover:text-white transition-colors"
              >
                <svg 
                  id="eyeOpen" 
                  class="h-4 w-4" 
                  xmlns="http://www.w3.org/2000/svg" 
                  fill="none" 
                  viewBox="0 0 24 24" 
                  stroke="currentColor" 
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>

                <svg 
                  id="eyeClosed" 
                  class="hidden h-4 w-4" 
                  xmlns="http://www.w3.org/2000/svg" 
                  fill="none" 
                  viewBox="0 0 24 24" 
                  stroke="currentColor" 
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 01-1.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                </svg>

              </button>
            </div>
          </div>

          <!-- CAJÓN 4: Botón Ingresar -->
          <div class="absolute left-[41%] right-[21%] top-[70%]">
            <button  
              type="submit"  
              id="submitBtn" 
              class="!w-full !h-[26px] !text-center !text-sm !font-bold !text-white !bg-transparent !border-none !py-0 !px-2 !rounded-xl !shadow-none transition-all active:scale-[0.90]"
              style="transform: rotate(-1deg);"
            > 
              <span id="btnText">
                Ingresar
              </span>
            </button> 
          </div>

          <!-- CAJÓN 5: Enlace "¿Olvidó su contraseña?" -->
          <div class="absolute left-[8%] right-[8%] top-[79%] text-center">
            <a
              id="forgotPassword"
              href="#"
              class="!text-white/85 hover:!text-white !underline underline-offset-2 !text-[11px] !font-semibold transition-colors"
            >
              ¿Olvidó su contraseña?
            </a>
          </div>

        </form>
 
      </div>
    </div> 
 
    <!-- Enlace inferior --> 
    <div class="text-center mt-6 text-sm"> 
      <a 
        href="/register" 
        class="text-blue-700 hover:text-blue-900 underline font-semibold"
      >
        ¿No tienes cuenta? Registrarse
      </a>
    </div>

  </div>

  <!-- ================================================================ -->
  <!-- MODAL RECUPERAR CONTRASEÑA (flujo "Olvidó su contraseña") -->
  <!-- ================================================================ -->
  <div id="recoveryModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"></div>
    <div class="relative w-full max-w-sm bg-white rounded-2xl shadow-2xl p-6">
      <div class="flex items-start justify-between mb-3">
        <div>
          <h3 class="text-lg font-bold text-gray-900">🔑 Recuperar contraseña</h3>
          <p class="text-xs text-gray-500 mt-1">
            Ingresá el email de tu cuenta y te enviaremos una clave temporal.
          </p>
        </div>
        <button
          id="recoveryClose"
          type="button"
          class="text-gray-400 hover:text-gray-700 transition-colors"
          aria-label="Cerrar"
        >
          <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="recoveryForm" class="space-y-4">
        <div>
          <label for="recoveryEmail" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input
            id="recoveryEmail"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="tu@email.com"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base"
          />
        </div>

        <div id="recoveryMessage" class="text-sm text-center"></div>

        <div class="flex items-center justify-end gap-3">
          <button
            id="recoveryCancel"
            type="button"
            class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors"
          >
            Cancelar
          </button>
          <button
            type="submit"
            id="recoveryBtn"
            class="inline-flex items-center px-4 py-2 bg-blue-700 text-white text-sm font-medium rounded-lg hover:bg-blue-800 transition-base shadow-sm"
          >
            <span id="recoveryBtnText">Enviar</span>
          </button>
        </div>
      </form>
    </div>
  </div>

</BaseLayout> 
 
<script> 
  import { login, API_BASE_URL } from '../services/auth'; 
 
  const passwordInput = document.getElementById('password') as HTMLInputElement; 
  const togglePassword = document.getElementById('togglePassword') as HTMLButtonElement; 
  const eyeOpen = document.getElementById('eyeOpen')!; 
  const eyeClosed = document.getElementById('eyeClosed')!; 
 
  togglePassword?.addEventListener('click', () => { 
    const isHidden = passwordInput.type === 'password'; 
    passwordInput.type = isHidden ? 'text' : 'password'; 
    eyeOpen.classList.toggle('hidden', !isHidden); 
    eyeClosed.classList.toggle('hidden', isHidden); 
    passwordInput.focus(); 
  }); 
 
  const loginForm = document.getElementById('loginForm') as HTMLFormElement; 
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement; 
  const btnText = document.getElementById('btnText')!; 
 
  loginForm?.addEventListener('submit', async (e) => { 
    e.preventDefault(); 

    const formData = new FormData(loginForm); 
    const username = formData.get('username') as string; 
    const password = formData.get('password') as string; 
 
    try { 
      submitBtn.disabled = true; 
      btnText.textContent = '...'; 
       
      const result = await login({ username, password }); 

      if (result.user?.tiene_clave_temporal) { 
        // ============================================================
        // REDIRECCIÓN OBLIGATORIA: la cuenta entró con una clave
        // temporal (flujo "Olvidó su contraseña"). El token queda
        // guardado, pero NO se permite acceder al Dashboard general
        // hasta que el usuario defina una clave nueva en su Perfil.
        // ============================================================
        window.location.href = '/perfil'; 
      } else { 
        window.location.href = '/'; 
      } 
    } catch (err) { 
      alert('Error de conexión'); 
      submitBtn.disabled = false; 
      btnText.textContent = 'Ingresar'; 
    } 
  }); 

  // ===========================================================================
  // FLUJO "¿OLVIDÓ SU CONTRASEÑA?"
  // Modal público → POST /api/usuarios/recuperar-password/ con el email.
  // ===========================================================================
  const forgotPassword = document.getElementById('forgotPassword')!;
  const recoveryModal = document.getElementById('recoveryModal')!;
  const recoveryForm = document.getElementById('recoveryForm') as HTMLFormElement;
  const recoveryEmail = document.getElementById('recoveryEmail') as HTMLInputElement;
  const recoveryClose = document.getElementById('recoveryClose')!;
  const recoveryCancel = document.getElementById('recoveryCancel')!;
  const recoveryBtn = document.getElementById('recoveryBtn') as HTMLButtonElement;
  const recoveryBtnText = document.getElementById('recoveryBtnText')!;
  const recoveryMessage = document.getElementById('recoveryMessage')!;

  function mostrarModalRecuperacion(visible: boolean): void {
    recoveryModal.classList.toggle('hidden', !visible);
    if (visible) recoveryEmail.focus();
  }

  forgotPassword?.addEventListener('click', (e) => {
    e.preventDefault();
    recoveryMessage.textContent = '';
    recoveryMessage.className = 'text-sm text-center';
    mostrarModalRecuperacion(true);
  });

  recoveryClose?.addEventListener('click', () => mostrarModalRecuperacion(false));
  recoveryCancel?.addEventListener('click', () => mostrarModalRecuperacion(false));

  recoveryModal?.addEventListener('click', (e) => {
    if (e.target === recoveryModal) mostrarModalRecuperacion(false);
  });

  recoveryForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = recoveryEmail.value.trim();
    if (!email) return;

    recoveryBtn.disabled = true;
    recoveryBtnText.textContent = 'Enviando...';
    recoveryMessage.textContent = '';
    recoveryMessage.className = 'text-sm text-center';

    try {
      const res = await fetch(`${API_BASE_URL}/usuarios/recuperar-password/`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok && data.success) {
        recoveryMessage.textContent = '📧 ' + (data.mensaje || 'Si el email coincide con una cuenta, recibirás tu clave temporal.');
        recoveryMessage.className = 'text-sm text-center text-green-600 font-medium';
        recoveryEmail.value = '';
      } else {
        recoveryMessage.textContent = data.error || 'No se pudo procesar la solicitud. Intentá de nuevo.';
        recoveryMessage.className = 'text-sm text-center text-red-600 font-medium';
      }
    } catch {
      recoveryMessage.textContent = 'Error de conexión. Intentá de nuevo.';
      recoveryMessage.className = 'text-sm text-center text-red-600 font-medium';
    } finally {
      recoveryBtn.disabled = false;
      recoveryBtnText.textContent = 'Enviar';
    }
  });
</script>