---
// =============================================================================
// PÁGINA DE INICIO DE SESIÓN
// Maneja autenticación JWT con validación y manejo de errores
// =============================================================================

import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout title="Estok - Iniciar Sesión">
  <div class="w-full mx-auto max-w-[440px]">
    <!-- Mueble archivador: contenedor acoplado al tamaño real del mueble gatuno.
         La imagen se agranda al 150% para tapar los cuadraditos de ajedrez
         falsos pintados en los píxeles de los bordes -->
    <div
      class="relative isolate w-full max-w-[340px] h-[340px] bg-center bg-no-repeat rounded-2xl shadow-xl overflow-hidden"
      style="background-image: url('/archivador-login.png'); background-size: 150% 150%;"
    >
      <!-- Velo oscuro: amortigua el contraste de los cuadraditos de fondo -->
      <div class="absolute inset-0 bg-slate-950/30 backdrop-blur-[1px] -z-10"></div>

      <!-- Bloque Título/Instrucción: flota en el área de las orejas/frente -->
      <div class="absolute left-1/2 top-[6%] -translate-x-1/2 w-[80%] text-center z-10">
        <h2 class="text-2xl font-extrabold text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)]">Iniciar Sesión</h2>
        <p class="mt-1 text-sm font-medium text-white/95 drop-shadow-[0_1px_3px_rgba(0,0,0,0.6)]">
          Ingresa tus credenciales para acceder al sistema
        </p>
      </div>

      <!-- Formulario flotando sobre el cuerpo del mueble -->
      <form id="loginForm" class="absolute inset-0">
        <!-- Campo Usuario: gaveta del medio-superior -->
        <div class="absolute left-[15%] right-[15%] top-[34%]">
          <label for="username" class="block text-xs font-bold uppercase tracking-wider text-white/90 mb-0.5">
            Usuario
          </label>
          <input
            id="username"
            name="username"
            type="text"
            required
            autocomplete="username"
            placeholder="Nombre de usuario"
            class="w-full py-1.5 bg-slate-900/60 text-white text-center rounded border border-gray-700 placeholder:text-gray-400 outline-none focus:ring-0 focus:border-gray-500"
          />
        </div>

        <!-- Campo Contraseña: gaveta del medio-inferior -->
        <div class="absolute left-[15%] right-[15%] top-[54%]">
          <label for="password" class="block text-xs font-bold uppercase tracking-wider text-white/90 mb-0.5">
            Contraseña
          </label>
          <div class="relative">
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              placeholder="••••••••"
              class="w-full py-1.5 pr-8 bg-slate-900/60 text-white text-center rounded border border-gray-700 placeholder:text-gray-400 outline-none focus:ring-0 focus:border-gray-500"
            />
            <button
              id="togglePassword"
              type="button"
              aria-label="Mostrar u ocultar contraseña"
              aria-pressed="false"
              class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white focus:outline-none"
            >
              <svg id="eyeOpen" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <svg id="eyeClosed" class="hidden h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Botón Ingresar: azul sólido justo arriba del cajón inferior -->
        <div class="absolute left-[15%] right-[15%] top-[74%]">
          <button
            id="submitBtn"
            type="submit"
            class="w-full py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2 shadow-md"
          >
            <span id="submitText">Ingresar</span>
            <svg id="submitSpinner" class="hidden animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </div>
      </form>

      <!-- Mensaje de error: flota entre el título y la primera gaveta -->
      <div
        id="errorMessage"
        class="absolute inset-x-[15%] top-[20%] hidden bg-red-600/90 text-white px-4 py-2.5 rounded-lg text-sm text-center shadow-md z-20"
        role="alert"
      ></div>
    </div>

    <!-- Fuera del contenedor de fondo: enlace de registro debajo de las patas -->
    <p class="mt-4 text-center text-sm text-gray-500">
      ¿No tienes cuenta?
      <a href="/register" class="text-blue-700 hover:text-blue-800 font-medium">
        Registrarse
      </a>
    </p>
  </div>
</AuthLayout>



<script>
  // ===========================================================================
  // MANEJO DEL FORMULARIO DE LOGIN
  // Usa login() de auth.ts que centraliza la lógica de autenticación,
  // incluyendo la auto-selección del primer Estok activo.
  // ===========================================================================

  import { login } from '../services/auth';

  const form = document.getElementById('loginForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const submitText = document.getElementById('submitText')!;
  const submitSpinner = document.getElementById('submitSpinner')!;
  const errorMessage = document.getElementById('errorMessage')!;

  // ===========================================================================
  // ALTERNAR VISIBILIDAD DE LA CONTRASEÑA
  // ===========================================================================
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const togglePassword = document.getElementById('togglePassword') as HTMLButtonElement;
  const eyeOpen = document.getElementById('eyeOpen')!;
  const eyeClosed = document.getElementById('eyeClosed')!;

  togglePassword?.addEventListener('click', () => {
    const isHidden = passwordInput.type === 'password';
    passwordInput.type = isHidden ? 'text' : 'password';
    eyeOpen.classList.toggle('hidden', isHidden);
    eyeClosed.classList.toggle('hidden', !isHidden);
    togglePassword.setAttribute('aria-pressed', String(!isHidden));
    passwordInput.focus();
  });

  function showError(message: string) {
    errorMessage.textContent = message;
    errorMessage.classList.remove('hidden');
  }

  function hideError() {
    errorMessage.classList.add('hidden');
  }

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    if (loading) {
      submitText.classList.add('hidden');
      submitSpinner.classList.remove('hidden');
    } else {
      submitText.classList.remove('hidden');
      submitSpinner.classList.add('hidden');
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();

    const username = (document.getElementById('username') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;

    // Validación básica
    if (!username) {
      showError('Por favor, ingresa tu nombre de usuario.');
      return;
    }

    if (!password) {
      showError('Por favor, ingresa tu contraseña.');
      return;
    }

    setLoading(true);

    try {
      const { user } = await login({ username, password });
      window.location.href = user.estoks.length === 0 ? '/estoks' : '/';
    } catch (err: any) {
      const errorMsg = err?.error || 'Error de conexión. Verifica que el servidor esté corriendo.';
      showError('❌ ' + errorMsg);
      console.error('Login error:', err);
    } finally {
      setLoading(false);
    }
  });
</script>
