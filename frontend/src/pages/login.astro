---
import BaseLayout from '../layouts/BaseLayout.astro';
let error = '';
---

<BaseLayout title="Iniciar Sesión - Estok">
  <!-- Ocultamos de forma absoluta menús e iconos flotantes ajenos al login -->
  <style is:global>
    header, nav, #global-navbar, [role="navigation"], .fixed.bottom-4.right-4, #chatContainer, button[class*="rounded-full"] { 
      display: none !important; 
    }
  </style>

  <div class="min-h-screen bg-[#0b0f19] flex flex-col justify-center items-center p-4 select-none">
    
    <!-- Título Principal Superior -->
    <div class="text-center mb-6 z-10">
      <h1 class="text-3xl font-extrabold text-white tracking-tight">Estok</h1>
      <p class="text-xs text-gray-400 mt-1">Sistema de Inventario Personal</p>
    </div>

    <!-- EL CONTENEDOR CON TUS COORDENADAS REALES DE CLIP-PATH LIMPIAS -->
    <div 
      class="relative w-full max-w-[365px] h-[390px] bg-center bg-no-repeat overflow-hidden transition-all shadow-2xl"
      style="
        background-image: url('/archivador-login.png'); 
        background-size: 152% 100%;
        clip-path: polygon(
          25% 11%, 37% 2%, 46% 6%, 46% 10%, 57% 11%, 62% 5%, 71% 2%, 75% 12%, 82% 14%, 
          83% 87%, 81% 89%, 80% 95%, 75% 95%, 71% 94%, 70% 90%, 66% 91%, 64% 92%, 
          60% 92%, 58% 91%, 43% 92%, 39% 98%, 34% 98%, 29% 96%, 29% 92%, 27% 93%, 
          22% 93%, 22% 89%, 18% 91%, 18% 87%, 17% 85%, 17% 81%, 17% 16%
        );
      "
    >
      <div class="absolute inset-0 bg-slate-950/5 -z-10"></div>

      <!-- CAPA DE FORMULARIO: Alineada con las maderas de los cajones -->
      <div class="absolute inset-0 z-10">
        
        <!-- Título "Iniciar Sesión" colocado en la frente del gato -->
        <div class="absolute left-0 right-0 top-[20%] text-center px-4">
          <h2 class="text-xs font-bold text-white drop-shadow-md tracking-wider uppercase bg-slate-950/50 py-0.5 rounded max-w-[120px] mx-auto">Iniciar Sesión</h2>
        </div>

        <form id="loginForm" class="absolute inset-0">
          <!-- CAJÓN 2: Usuario (Centrado exactamente en la gaveta superior azul) -->
          <div class="absolute left-[10%] right-[10%] top-[41%]">
            <input 
              id="username" 
              name="username" 
              type="text" 
              required 
              placeholder="Usuario"
              class="w-full text-center text-sm font-bold text-white bg-slate-900/80 border border-gray-700/60 rounded px-3 py-1.5 outline-none focus:border-blue-500 transition-colors shadow-inner placeholder-gray-500"
            />
          </div>

          <!-- CAJÓN 3: Contraseña (Centrado exactamente en la gaveta intermedia azul) -->
          <div class="absolute left-[10%] right-[10%] top-[58%]">
            <div class="relative">
              <input 
                id="password" 
                name="password" 
                type="password" 
                required 
                placeholder="Contraseña"
                class="w-full text-center text-sm font-bold text-white bg-slate-900/80 border border-gray-700/60 rounded px-3 py-1.5 pr-9 outline-none focus:border-blue-500 transition-colors shadow-inner placeholder-gray-500"
              />
              <button
                id="togglePassword"
                type="button"
                class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white transition-colors"
              >
                <svg id="eyeOpen" class="h-4 w-4" xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg id="eyeClosed" class="hidden h-4 w-4" xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                </svg>
              </button>
            </div>
          </div>

          <!-- CAJÓN 4: Botón Ingresar -->
          <div class="absolute left-[10%] right-[10%] top-[75%]">
            <button 
              type="submit" 
              id="submitBtn"
              class="w-full text-center text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 py-2 rounded shadow-md transition-all active:scale-[0.97]"
            >
              <span id="btnText">Ingresar</span>
            </button>
          </div>
        </form>

      </div>
    </div>

    <!-- Enlace inferior -->
    <div class="text-center mt-6 text-sm">
      <a href="/register" class="text-blue-400 hover:text-blue-300 underline font-medium">¿No tienes cuenta? Registrarse</a>
    </div>
  </div>
</BaseLayout>

<script>
  import { login } from '../services/auth';

  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const togglePassword = document.getElementById('togglePassword') as HTMLButtonElement;
  const eyeOpen = document.getElementById('eyeOpen')!;
  const eyeClosed = document.getElementById('eyeClosed')!;

  togglePassword?.addEventListener('click', () => {
    const isHidden = passwordInput.type === 'password';
    passwordInput.type = isHidden ? 'text' : 'password';
    eyeOpen.classList.toggle('hidden', !isHidden);
    eyeClosed.classList.toggle('hidden', isHidden);
    passwordInput.focus();
  });

  const loginForm = document.getElementById('loginForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const btnText = document.getElementById('btnText')!;

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(loginForm);
    const username = formData.get('username') as string;
    const password = formData.get('password') as string;

    try {
      submitBtn.disabled = true;
      btnText.textContent = '...';
      
      const success = await login({ username, password });
      if (success) {
        window.location.href = '/';
      } else {
        alert('Credenciales inválidas');
        submitBtn.disabled = false;
        btnText.textContent = 'Ingresar';
      }
    } catch (err) {
      alert('Error de conexión');
      submitBtn.disabled = false;
      btnText.textContent = 'Ingresar';
    }
  });
</script>
