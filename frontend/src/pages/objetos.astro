---
// Listado jerárquico de objetos (inventario en cascada).
// La pantalla se divide en secciones descendentes que heredan de forma continua
// la misma textura y paleta corporativa. Cada sección es un ACORDEÓN colapsable
// (colapsado por defecto) cuya barra muestra el título con su ícono, un badge con
// el total de objetos, un resumen secundario y el indicador desplegado/colapsado.
// ORDEN VISUAL (Lote 32), de arriba a abajo:
//   SECCIÓN 1    · Objetos Sueltos o sin Caja (ícono /fluffy-objeto.webp)
//   SECCIÓN 2    · Cajas e Inventario Interno (mini-guía analítica asimétrica)
//   SECCIÓN 2bis · Objetos en Contenedor (lista plana con insignia de
//                  ubicación: ningún ítem queda oculto detrás de un acordeón)
//   SECCIÓN 3    · Muebles y Estructuras Móviles (ícono /mueble.webp)
// La lógica vive en src/lib/listadoJerarquicoObjetos.ts.
// Payload: GET /api/contenedores/arbol/ (backend optimizado, cero N+1).

import BaseLayout from '../layouts/BaseLayout.astro';
import AuthGuard from '../components/AuthGuard.astro';
import LoadingState from '../components/LoadingState.astro';
import ErrorState from '../components/ErrorState.astro';
import EmptyState from '../components/EmptyState.astro';
import CategoriaCreator from '../components/CategoriaCreator.astro';
// Modal unificado de exportación (CSV parametrizado + informe PDF con formato).
// Su lógica vive en src/lib/exportarDatos.ts (auth centralizada en services/auth).
import ModalExportarDatos from '../components/objetos/ModalExportarDatos.astro';
// Botón "+" unificado (variante cabecera: PNG grande de la botonera superior).
import BotonAccionRapida from '../components/ui/BotonAccionRapida.astro';
// Estilos de la MINI-GUÍA ANALÍTICA (.mini-anidado*) que dibujan las tarjetas de
// caja de la SECCIÓN 1 y el componente global components/MinimapaRuta.astro.
// No se duplican: viven en un único archivo compartido por Almacenamiento.
import '../styles/almacenamiento-portales.css';
// Estilos del WIDGET DE RUTA GEOGRÁFICA (.ruta-geo*): texto con flechas que
// despliega la fila de minimapas al hacer clic (transición suave del panel).
import '../styles/ruta-geografica.css';
// Hoja PROPIA del componente global components/MinimapaRuta.astro. Esta página
// no lo renderiza en su markup (el asistente «Mover» lo monta EN CALIENTE
// dentro de su overlay), así que Astro no la incluiría por sí sola: sin esta
// importación el host del plano del modal queda sin su `aspect-ratio` elástico
// ni el refuerzo de trazos negros y el mapa se ve descalzado. El modal «Mover»
// usa EXACTAMENTE el mismo host canónico que el componente (lib/minimapaRutaHost.ts).
import '../styles/minimapa-ruta.css';
// Iconografía de interfaz: rutas canónicas (WebP optimizados) en UN solo módulo.
// · ASSET_FOTO_OBJETO → /fluffy-objeto.webp (ícono de «Objetos Sueltos»).
// · ASSET_MUEBLE      → /mueble.webp       (ícono de «Muebles y Estructuras»).
import {
  ASSET_BOTON_QR,
  ASSET_FOTO_OBJETO,
  ASSET_MUEBLE,
  ASSET_NUEVO_OBJETO,
} from '../lib/assetsUi';
// Modal de cámara del escáner QR: al escanear muestra el contenido y la ruta de
// ubicación completa de la caja/objeto (lógica en lib/escanerQrModal.ts).
import EscanerQrModal from '../components/escaner/EscanerQrModal.astro';
// Sección colapsable (acordeón) reutilizable por las cuatro secciones del
// inventario: ícono + título + badge de objetos + resumen secundario + flecha.
import SeccionAcordeon from '../components/objetos/SeccionAcordeon.astro';
---

<AuthGuard />

<BaseLayout title="Estok - Objetos | Inventario">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Encabezado -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Objetos</h1>
        <p class="mt-1 text-gray-500">Cajas, armarios y objetos del Estok activo en vista de cascada</p>
      </div>
      <div class="flex justify-between items-center w-full lg:w-auto gap-3 flex-wrap">
        <CategoriaCreator class="h-24 md:h-32 lg:h-36 w-auto hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer object-contain" />
        <ModalExportarDatos />
        <!-- Escáner QR: BOTÓN GRÁFICO PURO (sin texto ni fondo) entre la
             exportación y «Nuevo Objeto». Abre la cámara y muestra el contenido
             y la ruta de ubicación completa de la caja/objeto escaneado. -->
        <button type="button" data-abrir-escaner-qr
          class="inline-flex shrink-0 items-center justify-center p-0 m-0 bg-transparent border-0 shadow-none leading-none cursor-pointer rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-400 focus-visible:ring-offset-2"
          title="Escanear el QR de una caja, contenedor u objeto y ver su contenido y ubicación"
          aria-label="Escanear código QR">
          <img src={ASSET_BOTON_QR} alt="" aria-hidden="true" draggable="false"
            class="block h-24 w-auto md:h-32 md:w-auto lg:h-36 lg:w-auto max-w-none object-contain object-center hover:scale-105 active:scale-95 transition-all duration-200 select-none" />
        </button>
        <BotonAccionRapida
          variante="cabecera"
          class="flex-shrink-0"
          href="/objetos/nuevo"
          imagen={ASSET_NUEVO_OBJETO}
          etiqueta="Nuevo Objeto"
        />
      </div>
    </div>

    <!-- Barra de filtros dinámicos -->
    <div class="flex flex-wrap items-end gap-4 bg-slate-900/5 p-4 rounded-xl mb-4">
      <div class="flex flex-col gap-1.5 flex-1 min-w-[180px]">
        <label for="filtroDecision" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Decisión</label>
        <select id="filtroDecision"
          class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base cursor-pointer">
          <option value="">Todas</option>
          <option value="vender">Vender</option>
          <option value="conservar">Conservar</option>
          <option value="tirar">Tirar</option>
          <option value="sin_decision">Sin Decisión</option>
        </select>
      </div>
      <div class="flex flex-col gap-1.5 flex-1 min-w-[180px]">
        <label for="filtroCategoria" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Categoría</label>
        <select id="filtroCategoria"
          class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base cursor-pointer">
          <option value="">Todas</option>
        </select>
      </div>
      <div class="flex flex-col gap-1.5 flex-1 min-w-[200px]">
        <label for="filtroUbicacion" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Filtro por Ubicación</label>
        <!-- Opciones DINÁMICAS: «Habitaciones y espacios» (optgroup) y
             «Contenedores padre» (muebles y piezas que alojan otras piezas).
             Se pueblan con el contexto geográfico del Estok activo (lógica en
             lib/filtroUbicacionListado.ts) y filtran el listado EN EL ACTO,
             sin refetch, actualizando los contadores de los acordeones. -->
        <select id="filtroUbicacion"
          class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base cursor-pointer">
          <option value="">Todas las ubicaciones</option>
        </select>
      </div>
      <div class="flex flex-col gap-1.5 flex-1 min-w-[180px]">
        <label for="filtroPublicado" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Publicación</label>
        <select id="filtroPublicado"
          class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base cursor-pointer">
          <option value="">Todas</option>
          <option value="publicado">Publicado en MercadoLibre</option>
          <option value="no_publicado">No publicado</option>
        </select>
      </div>
      <div class="flex flex-col gap-1.5 flex-1 min-w-[220px]">
        <label for="searchInput" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Buscar</label>
        <input id="searchInput" type="search" placeholder="Buscar por nombre o descripción…"
          class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
      </div>
      <!-- Blanqueo reactivo: resetea búsqueda + los cuatro selects (incluido el
           Filtro por Ubicación) y repinta todo el inventario del Estok activo
           (lógica en lib/listadoJerarquicoObjetos.ts). -->
      <div class="flex items-end w-full sm:w-auto">
        <button id="btnLimpiarFiltros" type="button"
          class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-3 py-2.5 rounded-lg text-sm font-semibold text-gray-600 bg-white border border-gray-200 hover:bg-gray-50 hover:text-gray-900 active:scale-95 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base cursor-pointer"
          title="Restablecer la búsqueda y todos los filtros a sus valores por defecto"
          aria-label="Limpiar Filtros">
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
          </svg>
          <span class="whitespace-nowrap">Limpiar Filtros</span>
        </button>
      </div>
    </div>
    <!-- Estados: carga · error · vacío -->
    <LoadingState mensaje="Cargando inventario jerárquico…" />
    <ErrorState mensaje="Error al cargar el inventario jerárquico." />
    <EmptyState id="emptyState" icono="🗄️" titulo="El inventario está vacío"
      descripcion="Creá una caja o un mueble desde Almacenamiento y cargá tu primer objeto."
      accionTexto="Nuevo Objeto" accionHref="/objetos/nuevo" />

    <!-- Sin coincidencias con los filtros activos -->
    <div id="sinResultados"
      class="hidden bg-amber-50 border border-amber-200 text-amber-800 px-6 py-4 rounded-xl text-center text-sm font-medium">
      🔍 No hay objetos que coincidan con los filtros aplicados. Probá ampliar la búsqueda.
    </div>

    <!-- Resumen de la vista actual -->
    <div id="resumenInventario" class="hidden mb-6"></div>

    <!-- =====================================================================
         INVENTARIO JERÁRQUICO · cuatro ACORDEONES secuenciales descendentes
         que heredan la MISMA textura y paleta corporativa (lienzo continuo).
         Cada barra desplegable muestra: ícono + título, badge con el total de
         objetos, resumen secundario (sub-ítems / valor estimado) y la flecha
         de estado. Todos arrancan COLAPSADOS para evitar la sobrecarga visual.
         ORDEN VISUAL (Lote 32), de arriba a abajo:
           SECCIÓN 1     · Objetos Sueltos o sin Caja
           SECCIÓN 2     · Cajas e Inventario Interno
           SECCIÓN 2bis  · Objetos en Contenedor
           SECCIÓN 3     · Muebles y Estructuras Móviles
         El HTML de las tarjetas lo inyecta src/lib/listadoJerarquicoObjetos.ts.
         ===================================================================== -->
    <div id="seccionesInventario" class="hidden secciones-inventario">

      <!-- SECCIÓN 1 · Objetos Sueltos o sin Caja (ícono /fluffy-objeto.webp) -->
      <SeccionAcordeon
        id="seccionSueltos"
        titulo="Objetos Sueltos o sin Caja"
        iconoSrc={ASSET_FOTO_OBJETO}
        iconoAlt="Objetos Sueltos"
        badgeId="badgeSueltos"
        detalleId="detalleSueltos"
        detalle="Ítems que no residen dentro de una caja/mueble"
        detalleTitle="Ítems que no residen dentro de una caja/mueble · incluye los asignados a un espacio (Planta › Habitación › Espacio) con su ruta jerárquica"
        bodyId="objetosGrid"
        bodyClass="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"
      />

      <!-- SECCIÓN 2 · Cajas e Inventario Interno -->
      <SeccionAcordeon
        id="seccionCajas"
        titulo="Cajas e Inventario Interno"
        emoji="📦"
        badgeId="badgeCajas"
        detalleId="detalleCajas"
        detalle="Cajas del Estok activo con su ruta Piso → Habitación → Mueble"
        detalleTitle="Cajas del Estok activo (incluidas las guardadas dentro de muebles), con la ruta de minimapas Piso → Habitación → Mueble y su contenido cerrado por defecto"
        bodyId="cajasContainer"
        bodyClass="space-y-6"
      />

      <!-- SECCIÓN 2bis · Objetos en Contenedor (ningún ítem queda oculto) -->
      <SeccionAcordeon
        id="seccionObjetosEnContenedor"
        titulo="Objetos en Contenedor"
        emoji="📦"
        badgeId="badgeObjetosEnContenedor"
        detalleId="detalleObjetosEnContenedor"
        detalle="Ítems guardados dentro de cajas, muebles o espacios · la insignia indica su ubicación"
        detalleTitle="Todo ítem guardado DENTRO de una caja, mueble o espacio lógico · la insignia indica su ubicación (ej. 📦 En Caja 02)"
        bodyId="objetosEnContenedorGrid"
        bodyClass="grilla-objetos-contenedor"
      />

      <!-- SECCIÓN 3 · Muebles y Estructuras Móviles (ícono /mueble.webp) -->
      <SeccionAcordeon
        id="seccionMuebles"
        titulo="Muebles y Estructuras Móviles"
        iconoSrc={ASSET_MUEBLE}
        iconoAlt="Muebles"
        badgeId="badgeMuebles"
        detalleId="detalleMuebles"
        detalle="Muebles móviles y espacios contenedores declarados"
        detalleTitle="Muebles móviles y espacios contenedores declarados · los muebles fijos (es_inmueble) y la arquitectura (checkbox destildado) quedan excluidos"
        bodyId="mueblesContainer"
        bodyClass="space-y-6"
      />
    </div>
  </div>

  <script>
    import { initListadoJerarquicoObjetos } from '../lib/listadoJerarquicoObjetos';
    import { initModalExportarDatos } from '../lib/exportarDatos';
    initListadoJerarquicoObjetos();
    initModalExportarDatos();
  </script>

  <style is:global>
    /* Acordeón nativo <details>: revelado fluido y sin marcador triangular por defecto.
       El HTML de las tarjetas/viñetas se inyecta desde listadoJerarquicoObjetos.ts,
       por eso estos estilos son globales (no aplican scoping de Astro). */
    #seccionesInventario summary {
      list-style: none;
    }
    #seccionesInventario summary::-webkit-details-marker {
      display: none;
    }
    #seccionesInventario summary::marker {
      content: '';
    }
    /* ACORDEÓN DE SECCIÓN: barra desplegable con la flecha de estado.
       La flecha rota 180° al abrir (indicador visual desplegado/colapsado) y
       el cuerpo hereda el revelado suave de .estok-cuerpo-detalle. */
    #seccionesInventario details.acordeon-seccion > summary {
      cursor: pointer;
    }
    #seccionesInventario details.acordeon-seccion > summary:focus-visible {
      outline: 2px solid #f59e0b;
      outline-offset: 2px;
    }
    #seccionesInventario .acordeon-chevron {
      display: inline-flex;
      transition: transform 0.2s ease;
    }
    #seccionesInventario details.acordeon-seccion[open] .acordeon-chevron {
      transform: rotate(180deg);
    }
    #seccionesInventario details .estok-cuerpo-detalle {
      overflow: hidden;
    }
    #seccionesInventario details[open] .estok-cuerpo-detalle {
      animation: estok-reveal 0.22s ease-out;
    }

    /* Textura y paleta corporativa CONTINUA compartida por las cuatro secciones
       del inventario (sueltos · cajas · objetos en contenedor · muebles): un
       único lienzo ámbar. */
    .secciones-inventario {
      background-image:
        radial-gradient(circle at 18% 30%, rgba(255, 255, 255, 0.5) 0 1.5px, transparent 2.5px),
        radial-gradient(circle at 78% 70%, rgba(255, 255, 255, 0.35) 0 1.5px, transparent 2.5px),
        repeating-linear-gradient(0deg, rgba(146, 64, 14, 0.05) 0 1px, transparent 1px 27px),
        linear-gradient(180deg, #fffbeb 0%, #fde68a 100%);
      border-radius: 1rem;
      padding: 1.25rem 1rem;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.6), 0 1px 2px rgba(120, 53, 15, 0.06);
    }

    /* GRILLA DE «📦 OBJETOS EN CONTENEDOR» (SECCIÓN 2bis).
       Mismo tamaño de tarjeta que el inventario general: auto-fill de 240 px.
       La grilla vive ACÁ y no en el helper de render (listadoObjetosEnContenedor
       .ts), porque una grilla anidada dentro de otra se reduce a UNA columna de
       la externa y las tarjetas quedaban del ancho de una franja (títulos e
       insignias «📦 En Caja 02» ilegibles). */
    .grilla-objetos-contenedor {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1rem;
      align-items: stretch;
    }

    /* MINI-GUÍA ANALÍTICA de las tarjetas de caja (SECCIÓN 1).
       El HTML lo arma rutaCajaMinimapas.ts con el motor compartido
       minimapasAnidados.ts (el mismo que alimenta el componente global
       components/MinimapaRuta.astro) y los estilos .mini-anidado* se reutilizan
       de styles/almacenamiento-portales.css (importado en el frontmatter): no se
       duplican reglas acá. */
    @keyframes estok-reveal {
      from {
        opacity: 0;
        transform: translateY(-3px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <!-- Acción rápida móvil: "+ Nuevo Objeto". En desktop ya está la botonera superior. -->
  <BotonAccionRapida
    variante="flotante"
    href="/objetos/nuevo"
    etiqueta="Nuevo Objeto"
    class="boton-accion-rapida--solo-movil"
  />

  <!-- ESCÁNER QR - modal de cámara (contenido + ruta de ubicación completa). -->
  <EscanerQrModal />
</BaseLayout>

