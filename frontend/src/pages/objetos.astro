---
// Listado jerárquico de objetos (inventario en cascada).
// La pantalla se divide en TRES secciones descendentes que heredan de forma
// continua la misma textura y paleta corporativa:
//   SECCIÓN 1 · 📦 Cajas e Inventario Interno (minimapa ULTRA-MINI naranja)
//   SECCIÓN 2 · 🧸 Objetos Sueltos o sin Caja
//   SECCIÓN 3 · 🗄 Muebles y Estructuras Móviles (excluye es_inmueble = true)
// La lógica vive en src/lib/listadoJerarquicoObjetos.ts.
// Payload: GET /api/contenedores/arbol/ (backend optimizado, cero N+1).

import BaseLayout from '../layouts/BaseLayout.astro';
import AuthGuard from '../components/AuthGuard.astro';
import LoadingState from '../components/LoadingState.astro';
import ErrorState from '../components/ErrorState.astro';
import EmptyState from '../components/EmptyState.astro';
import CategoriaCreator from '../components/CategoriaCreator.astro';
// Estilos de la red de MINIMAPAS EN CADENA (.mini-anidado*) reutilizados por las
// tarjetas de caja de la SECCIÓN 1. No se duplican: viven en un único archivo.
import '../styles/almacenamiento-portales.css';
---

<AuthGuard />

<BaseLayout title="Estok - Objetos | Inventario">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Encabezado -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Objetos</h1>
        <p class="mt-1 text-gray-500">Cajas, armarios y objetos del Estok activo en vista de cascada</p>
      </div>
      <div class="flex justify-between items-center w-full lg:w-auto gap-3 flex-wrap">
        <CategoriaCreator class="h-24 md:h-32 lg:h-36 w-auto hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer object-contain" />
        <button id="exportCsvBtn"
          class="inline-flex items-center px-3 py-2 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 transition-base shadow-sm">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Exportar CSV
        </button>
        <a href="/objetos/nuevo" class="inline-block flex-shrink-0" aria-label="Nuevo Objeto">
          <img src="/nuevo objeto.png" alt="Nuevo Objeto"
            class="h-24 md:h-32 lg:h-36 w-auto hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer object-contain" />
        </a>
      </div>
    </div>

    <!-- Barra de filtros dinámicos -->
    <div class="flex flex-wrap items-end gap-4 bg-slate-900/5 p-4 rounded-xl mb-4">
      <div class="flex flex-col gap-1.5 flex-1 min-w-[180px]">
        <label for="filtroDecision" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Decisión</label>
        <select id="filtroDecision"
          class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base cursor-pointer">
          <option value="">Todas</option>
          <option value="vender">Vender</option>
          <option value="conservar">Conservar</option>
          <option value="tirar">Tirar</option>
          <option value="sin_decision">Sin Decisión</option>
        </select>
      </div>
      <div class="flex flex-col gap-1.5 flex-1 min-w-[180px]">
        <label for="filtroCategoria" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Categoría</label>
        <select id="filtroCategoria"
          class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base cursor-pointer">
          <option value="">Todas</option>
        </select>
      </div>
      <div class="flex flex-col gap-1.5 flex-1 min-w-[180px]">
        <label for="filtroPublicado" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Publicación</label>
        <select id="filtroPublicado"
          class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base cursor-pointer">
          <option value="">Todas</option>
          <option value="publicado">Publicado en MercadoLibre</option>
          <option value="no_publicado">No publicado</option>
        </select>
      </div>
      <div class="flex flex-col gap-1.5 flex-1 min-w-[220px]">
        <label for="searchInput" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Buscar</label>
        <input id="searchInput" type="search" placeholder="Buscar por nombre o descripción…"
          class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
      </div>
    </div>
    <!-- Estados: carga · error · vacío -->
    <LoadingState mensaje="Cargando inventario jerárquico…" />
    <ErrorState mensaje="Error al cargar el inventario jerárquico." />
    <EmptyState id="emptyState" icono="🗄️" titulo="El inventario está vacío"
      descripcion="Creá una caja o un mueble desde Almacenamiento y cargá tu primer objeto."
      accionTexto="Nuevo Objeto" accionHref="/objetos/nuevo" />

    <!-- Sin coincidencias con los filtros activos -->
    <div id="sinResultados"
      class="hidden bg-amber-50 border border-amber-200 text-amber-800 px-6 py-4 rounded-xl text-center text-sm font-medium">
      🔍 No hay objetos que coincidan con los filtros aplicados. Probá ampliar la búsqueda.
    </div>

    <!-- Resumen de la vista actual -->
    <div id="resumenInventario" class="hidden mb-6"></div>

    <!-- =====================================================================
         INVENTARIO JERÁRQUICO · tres bloques secuenciales descendentes que
         heredan la MISMA textura y paleta corporativa (lienzo continuo):
           SECCIÓN 1 · 📦 Cajas e Inventario Interno  (minimapa ULTRA-MINI naranja)
           SECCIÓN 2 · 🧸 Objetos Sueltos o sin Caja
           SECCIÓN 3 · 🗄 Muebles y Estructuras Móviles (excluye es_inmueble)
         El HTML lo inyecta src/lib/listadoJerarquicoObjetos.ts.
         ===================================================================== -->
    <div id="seccionesInventario" class="hidden secciones-inventario">

      <!-- SECCIÓN 1 · Cajas e Inventario Interno -->
      <section id="seccionCajas" class="hidden mb-10">
        <div class="flex flex-wrap items-end justify-between gap-2 mb-4">
          <div>
            <h2 class="text-2xl font-bold text-gray-900">📦 Cajas e Inventario Interno</h2>
            <p class="text-sm text-gray-500">Cajas del Estok activo (incluidas las guardadas dentro de muebles), con la ruta de minimapas Piso → Habitación → Mueble y su contenido cerrado por defecto</p>
          </div>
        </div>
        <div id="cajasContainer" class="space-y-6"></div>
      </section>

      <!-- SECCIÓN 2 · Objetos Sueltos o sin Caja -->
      <section id="seccionSueltos" class="hidden mb-10">
        <div class="flex flex-wrap items-end justify-between gap-2 mb-4">
          <div>
            <h2 class="text-2xl font-bold text-gray-900">🧸 Objetos Sueltos o sin Caja</h2>
            <p class="text-sm text-gray-500">Ítems que no residen dentro de una caja/mueble · consistencia del inventario total</p>
          </div>
        </div>
        <div id="objetosGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"></div>
      </section>

      <!-- SECCIÓN 3 · Muebles y Estructuras Móviles -->
      <section id="seccionMuebles" class="hidden">
        <div class="flex flex-wrap items-end justify-between gap-2 mb-4">
          <div>
            <h2 class="text-2xl font-bold text-gray-900">🗄 Muebles y Estructuras Móviles</h2>
            <p class="text-sm text-gray-500">Contenedores grandes mudables · los muebles fijos (es_inmueble) quedan excluidos</p>
          </div>
        </div>
        <div id="mueblesContainer" class="space-y-6"></div>
      </section>
    </div>
  </div>

  <script>
    import { initListadoJerarquicoObjetos } from '../lib/listadoJerarquicoObjetos';
    initListadoJerarquicoObjetos();
  </script>

  <style is:global>
    /* Acordeón nativo <details>: revelado fluido y sin marcador triangular por defecto.
       El HTML de las tarjetas/viñetas se inyecta desde listadoJerarquicoObjetos.ts,
       por eso estos estilos son globales (no aplican scoping de Astro). */
    #seccionesInventario summary {
      list-style: none;
    }
    #seccionesInventario summary::-webkit-details-marker {
      display: none;
    }
    #seccionesInventario summary::marker {
      content: '';
    }
    #seccionesInventario details .estok-cuerpo-detalle {
      overflow: hidden;
    }
    #seccionesInventario details[open] .estok-cuerpo-detalle {
      animation: estok-reveal 0.22s ease-out;
    }

    /* Textura y paleta corporativa CONTINUA compartida por las tres secciones
       del inventario (cajas · sueltos · muebles): un único lienzo ámbar. */
    .secciones-inventario {
      background-image:
        radial-gradient(circle at 18% 30%, rgba(255, 255, 255, 0.5) 0 1.5px, transparent 2.5px),
        radial-gradient(circle at 78% 70%, rgba(255, 255, 255, 0.35) 0 1.5px, transparent 2.5px),
        repeating-linear-gradient(0deg, rgba(146, 64, 14, 0.05) 0 1px, transparent 1px 27px),
        linear-gradient(180deg, #fffbeb 0%, #fde68a 100%);
      border-radius: 1rem;
      padding: 1.25rem 1rem;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.6), 0 1px 2px rgba(120, 53, 15, 0.06);
    }

    /* Red de MINIMAPAS EN CADENA de las tarjetas de caja (SECCIÓN 1).
       El HTML lo inyecta rutaCajaMinimapas.ts → minimapasAnidados.ts y los
       estilos .mini-anidado* se reutilizan de styles/almacenamiento-portales.css
       (importado en el frontmatter): no se duplican reglas acá. */
    @keyframes estok-reveal {
      from {
        opacity: 0;
        transform: translateY(-3px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</BaseLayout>

