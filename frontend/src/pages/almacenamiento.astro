---
// =============================================================================
// PÁGINA DE ALMACENAMIENTO - FLUJO EN CASCADA SIMÉTRICO DE TRES ESCENAS
//  ESCENA 1: Izq = Mapa Estok (casa) · Der = Mapa general de la Planta
//  ESCENA 2: Izq = Plano de habitaciones · Der = Visor de Habitación
//  ESCENA 3: Izq = Visor de Habitación · Der = Visor Contenedor Grande
// Bandeja inferior permanente: contenedores pequeños y objetos por ubicar,
// con origen de arrastre hacia casilleros y Drop Zone de extracción viva.
// Lógica en src/lib/mapaCasitaNavegable.ts, src/lib/visorHabitacion.ts,
// src/lib/visorContenedorGrande.ts y src/lib/bandejaSinUbicar.ts.
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import AuthGuard from '../components/AuthGuard.astro';
import OnboardingBienvenida from '../components/OnboardingBienvenida.astro';
import LoadingState from '../components/LoadingState.astro';
import ErrorState from '../components/ErrorState.astro';
// COMPONENTE GLOBAL de la mini-guía analítica superior: unifica en un único
// render las siluetas asimétricas proporcionales (mismo motor puro que Objetos).
import MinimapaRuta from '../components/MinimapaRuta.astro';
// Botón "+" unificado: variante flotante móvil (sobre la bandeja inferior fija).
import BotonAccionRapida from '../components/ui/BotonAccionRapida.astro';
// Canasta del cuadrante derecho del visor («Espacio Único») — Lote 31 · punto 2:
// host + hoja de estilos dedicada de la canasta del fin de cadena.
import CanastaCuadranteDerecho from '../components/CanastaCuadranteDerecho.astro';
// Alta simplificada de contenedores físicos («+ Nueva Caja / Contenedor»):
// markup del modal dedicado (Nombre · Foto · Dimensiones · Descripción ·
// Ubicación). Su lógica vive en lib/nuevaCajaModal.ts.
import NuevaCajaModal from '../components/NuevaCajaModal.astro';
import '../styles/mapa-espacial.css';
import '../styles/mapa-casita.css';
import '../styles/almacenamiento-escenas.css';
import '../styles/almacenamiento-controles.css';
import '../styles/almacenamiento-carga-fina.css';
import '../styles/almacenamiento-canasta-cuadrante.css';
import '../styles/planta-unica.css';
import '../styles/lienzo-perimetro.css';
import '../styles/almacenamiento-portales.css';
// Motor de portales recursivos: física dual, bloques monolíticos, grilla directa
// de objetos y responsive híbrido dual de la canasta (Web flotante ⇄ Móvil abajo).
import '../styles/portales-recursivos.css';
// Estado de espera inicial del Nivel Estok: tarjetas de planta con minimapas
// independientes (sin clonar planos) a la espera de selección.
import '../styles/almacenamiento-espera.css';
// Fuelle asimétrico (Lote 20): hosts separados por lado (ancla superior ⇄
// explorador) y refuerzo del resaltado NARANJA del nodo seleccionado.
import '../styles/almacenamiento-fuelle.css';
// Iconografía de interfaz: rutas canónicas (WebP optimizados) en UN solo módulo.
import {
  ASSET_CAJA,
  ASSET_CONTENEDOR_GRANDE,
  ASSET_FOTO_OBJETO,
} from '../lib/assetsUi';
---

<AuthGuard />

<BaseLayout title="Estok - Almacenamiento | Inventario">
  <!-- Asistente de Bienvenida (primer inicio): sin Estok asignado, la pantalla
       completa del asistente reemplaza al panel ordinario (data-estok-panel). -->
  <OnboardingBienvenida />

  <!-- Responsive híbrido dual: PADDING IZQUIERDO CERO (el mapa interactivo se apoya
       contra el borde y no queda pisado por el panel derecho) y reserva md:pr-80
       para la canasta lateral flotante. En celulares la canasta baja al pie. -->
  <div class="max-w-7xl mx-auto py-8 pl-0 pr-4 md:pr-80" data-estok-panel>
    <!-- Encabezado -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Almacenamiento</h1>
        <p class="mt-1 text-gray-500">Flujo en cascada por niveles: Mapa Estok → Habitaciones → Espacios</p>
      </div>
      <!-- ALTA DIRECTA DE CONTENEDOR: abre el formulario simplificado (sin
           «Valor Estimado»), con Nombre, Foto, Dimensiones y Ubicación. -->
      <button type="button" id="nuevaCajaContenedorBtn"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-sm hover:bg-blue-800 active:scale-95 transition-base cursor-pointer"
        title="Crear una caja o contenedor físico con nombre, foto, dimensiones y ubicación">
        <img
          src={ASSET_CAJA}
          alt=""
          aria-hidden="true"
          draggable="false"
          class="h-6 w-6 shrink-0 object-contain select-none"
        />
        + Nueva Caja / Contenedor
      </button>
    </div>

    <!-- Leyenda de iconografía local del Lienzo de Mapeo Espacial -->
    <div class="mb-8 flex flex-wrap items-center gap-x-6 gap-y-3 bg-white rounded-2xl border border-gray-200 shadow-sm px-5 py-3.5">
      <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Iconografía del lienzo</span>
      <span class="flex items-center gap-2 text-xs text-gray-600">
        <img src={ASSET_CONTENEDOR_GRANDE} class="h-16 w-auto draggable" alt="Contenedor grande" />
        Contenedor grande (contiene contenedores)
      </span>
      <span class="flex items-center gap-2 text-xs text-gray-600">
        <img src={ASSET_CAJA} class="h-16 w-auto draggable" alt="Contenedor pequeño" />
        Contenedor pequeño (solo objetos)
      </span>
      <span class="flex items-center gap-2 text-xs text-gray-600">
        <img src={ASSET_FOTO_OBJETO} class="h-12 w-12 rounded-full draggable" alt="Objeto individual" />
        Objeto individual
      </span>
    </div>

    <LoadingState mensaje="Cargando espacios de almacenamiento..." />
    <ErrorState mensaje="Error al cargar los espacios de almacenamiento." />

    <!-- =========================================================================
         TRES ESCENAS EN CASCADA (izquierda → derecha)
         ESCENA 1: Izq = Mapa Estok (casa)         · Der = Mapa general de la Planta
         ESCENA 2: Izq = Plano de habitaciones     · Der = Visor de Habitación
         ESCENA 3: Izq = Visor de Habitación       · Der = Visor Contenedor Grande
         La máquina de escenas vive en el <script> (eventos estok:*).
         ========================================================================= -->
    <section class="mb-10" id="seccionCascada">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- PANEL IZQUIERDO (ESCENAS 1-2: Mapa Estok / ESCENA 3: Visor de Habitación) -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5 escena-panel">
          <div class="flex items-center justify-between gap-3 flex-wrap mb-3">
            <div class="flex items-center gap-2 flex-wrap">
              <h2 id="tituloPanelIzquierdo" class="text-lg font-semibold text-gray-900 flex items-center gap-2">🏠 Mapa Estok</h2>
              <span id="mapaJerarquicoBadge" class="text-xs px-2 py-0.5 rounded-full bg-purple-50 text-purple-700 font-medium">Cargando...</span>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
              <button type="button" id="btnVolverNivel" class="hidden nav-volver" title="⬅ Volver de Nivel: desandá el camino de portales paso a paso">⬅ Volver de Nivel</button>
              <button type="button" data-modo-editar class="portales-modo-boton" title="Habilitar la edición in-place de los planos (renombrar, arrastrar, fusionar, estirar)">✏️ Editar</button>
              <button type="button" data-modo-guardar class="portales-modo-boton hidden" title="Guardar ui_width/ui_height por PUT y bloquear la grilla para navegar por portales">💾 Guardar</button>
            </div>
          </div>
          <p id="descPanelIzquierdo" class="text-xs text-gray-500 mb-3">Edición en vivo sobre el lienzo: clic en un nombre para renombrar, arrastrá las tarjetas para reacomodarlas entre cuadrantes y tirá de su esquina para estirarlas. Tocá una planta para desplegar el plano de sus habitaciones.</p>
          <div id="contenidoPanelIzquierdo" class="mt-1">
            <div id="mapaEstokPanel">
              <p class="text-sm text-gray-400 text-center py-6">Cargando mapa espacial...</p>
            </div>
            <!-- Nivel 4: el canvas de la caja/estante reemplaza al plano en la izquierda -->
            <div id="cajaCanvas" class="hidden mt-1"></div>
            <!-- ANCLA IZQUIERDA (NIVEL SUPERIOR): mapa de habitaciones de la planta
                 con el cuarto seleccionado resaltado en NARANJA (#f97316). Host
                 DEDICADO de la izquierda, JAMÁS compartido con el panel derecho. -->
            <div id="anclaHabitacionesPanel" class="hidden mt-1 min-w-0"></div>
            <!-- En Nivel 2 el #visorHabitacion se reubica aquí desde el panel derecho -->
            <!-- En niveles de contenedor, el #visorContenedorGrande se reubica aquí
                 para dibujar la sub-grilla elástica interna del nodo (recursivo ∞) -->
          </div>
        </div>

        <!-- PANEL DERECHO (ESCENAS 1-2: Visor de Habitación / ESCENA 3: Visor Contenedor Grande) -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5 escena-panel">
          <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
            <div class="flex items-center gap-2">
              <h2 id="tituloPanelDerecho" class="text-lg font-semibold text-gray-900 flex items-center gap-2">🗺️ Mapa general de la Planta</h2>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
              <button type="button" data-modo-editar class="portales-modo-boton" title="Habilitar la edición in-place de los planos (renombrar, arrastrar, fusionar, estirar)">✏️ Editar</button>
              <button type="button" data-modo-guardar class="portales-modo-boton hidden" title="Guardar ui_width/ui_height por PUT y bloquear la grilla para navegar por portales">💾 Guardar</button>
              <button type="button" id="btnOrganizarEscena4" class="hidden inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-orange-600 hover:bg-orange-700 text-white text-xs font-semibold shadow-sm transition-colors cursor-pointer" title="Abrir la Organización Interna del mueble: pantalla dividida con la Bandeja de Carga Fina a la derecha">📦 Organizar Contenido</button>
              <button type="button" id="btnVolverEscena" class="nav-volver hidden" title="Volver al nivel anterior del flujo en cascada">
                <svg class="volver-btn-ico" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"/></svg>
                <span>Volver</span>
              </button>
            </div>
          </div>
          <!-- MINI-GUÍA ANALÍTICA SUPERIOR: componente global autocontenido
               (cadena de minimapas asimétricos proporcionales + sector activo
               en naranja #f97316). El host arranca vacío y
               portalesAlmacenamiento.ts lo rellena en vivo con el MISMO motor
               puro (src/lib/minimapasAnidados.ts) que usa Objetos. -->
          <MinimapaRuta id="minimapasAnidados" class="hidden" />
          <p id="descPanelDerecho" class="text-xs text-gray-500 mb-3">El detalle del nivel actual: los casilleros reciben elementos por Drag &amp; Drop. En ESCENA 3 podés inspeccionar cada mueble en caliente y ajustar sus sub-divisiones internas con los botones + y −.</p>
          <div id="contenidoPanelDerecho" class="mt-1 min-w-0">
            <div id="visorHabitacion" class="min-h-[180px] min-w-0">
              <!-- 🚪 BLOQUE COMPACTO «MINIMAPAS DE LAS PLANTAS» (estándar visual
                   único del proyecto): una tarjeta por planta del Estok activo,
                   dibujada por el COMPONENTE GLOBAL <MinimapaRuta /> (motor puro
                   lib/minimapasAnidados.ts + siluetas REALES con los trazos
                   negros nítidos). El host del componente queda MONTADO de forma
                   permanente (no se destruye al re-renderizar) y
                   visorHabitacion.ts solo rellena su interior: al ser un
                   contenedor elástico y autocontenido, el bloque no puede
                   desbordarse de esta barra lateral. -->
              <div id="visorPlantas" class="visor-default w-full min-w-0">
                <div class="visor-default-encabezado">
                  <span class="visor-titulo">🗺️ Minimapas de las plantas</span>
                  <span class="visor-default-sub">Seleccioná una habitación encastrada en el Mapa Estok para inspeccionarla en este Visor.</span>
                </div>
                <MinimapaRuta id="minimapaPlantasIniciales" class="minimapa-ruta-plantas" />
              </div>
              <!-- Visor de la habitación abierta (Nivel 2): montaje en vivo -->
              <div id="visorRoom" class="hidden w-full min-w-0"></div>
            </div>
            <div id="visorContenedorGrande" class="hidden mt-1"></div>
            <div id="cargaFinaPanel" class="hidden mt-1"></div>
            <!-- Nivel 4: listado fino de objetos de la caja activa -->
            <div id="cajaObjetos" class="hidden mt-1"></div>
            <!-- =================================================================
                 HOSTS DEL MOTOR DE PORTALES RECURSIVOS (Panel DERECHO)
                 La derecha TRANSMUTA en cada nivel: habitaciones con mini-mapas
                 internos ⇄ interior jerárquico del nodo ⇄ grilla directa de
                 objetos reales (fin de cadena «Espacio Único»).
                 ================================================================= -->
            <div id="listaPlantasPanel" class="hidden mt-1 min-w-0"></div>
            <div id="listaHabitacionesPanel" class="hidden mt-1 min-w-0"></div>
            <div id="listaContenedoresPanel" class="hidden mt-1 min-w-0"></div>
            <div id="grillaObjetosPanel" class="hidden mt-1 min-w-0"></div>

            <!-- Canasta del cuadrante derecho («Espacio Único») · Lote 31. -->
            <CanastaCuadranteDerecho />
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================================
         BANDEJA LATERAL DE ELEMENTOS POR UBICAR (panel vertical flotante derecho)
         Anclada al lateral derecho (md:w-80 h-full fixed right-0). Lista en
         CASCADA MOVIBLE: objetos sueltos, cajas sueltas, objetos ubicados, cajas
         ubicadas y muebles móviles. Es origen de arrastre hacia los casilleros y
         Drop Zone de extracción viva. Lógica en src/lib/bandejaSinUbicar.ts.
         ========================================================================= -->
    <aside id="bandejaSinUbicar"
      class="bandeja-lateral hidden md:flex fixed right-0 w-64 sm:w-72 md:w-80 z-40"
      aria-label="Bandeja lateral de elementos por ubicar">
      <div class="bandeja-lateral-cab">
        <span class="bandeja-titulo">🧺 Elementos por ubicar</span>
        <span id="contadorBandeja" data-contador-bandeja class="bandeja-contador">0</span>
      </div>
      <p class="bandeja-hint">Arrastrá cada elemento hacia un contenedor, un casillero del Visor o el bloque de la izquierda. Soltá uno de un casillero acá para extraerlo.</p>
      <div id="bandejaContenido" class="bandeja-contenido"></div>
    </aside>

    <!-- =========================================================================
         CANASTA DE CELULARES (block md:hidden): el panel derecho flotante se apaga
         por completo y la canasta vuelve al MARGEN INFERIOR como barra horizontal
         fija. Misma lógica y mismos chips (src/lib/bandejaSinUbicar.ts).
         ========================================================================= -->
    <aside id="bandejaSinUbicarMovil"
      class="bandeja-movil flex md:hidden fixed bottom-0 left-0 right-0 z-40"
      aria-label="Canasta inferior de elementos por ubicar">
      <div class="bandeja-movil-cab">
        <span class="bandeja-titulo">🧺 Elementos por ubicar</span>
        <span data-contador-bandeja class="bandeja-contador">0</span>
      </div>
      <div id="bandejaContenidoMovil" class="bandeja-contenido bandeja-contenido-movil"></div>
    </aside>
  </div>

    <!-- Modal: Editar entidad (Ubicación / Contenedor) -->
    <div id="modalEditar" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4">
          <h3 id="editarTitulo" class="text-lg font-semibold text-gray-900">Editar</h3>
          <button type="button" data-cerrar-modal="editar" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <form id="editarForm" class="space-y-4">
          <input type="hidden" id="editarTipo" value="" />
          <input type="hidden" id="editarId" value="" />
          <div>
            <label for="editarNombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre <span class="text-red-500">*</span></label>
            <input id="editarNombre" name="nombre" type="text" required placeholder="Nombre de la entidad"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
          </div>
          <div>
            <label for="editarDescripcion" class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
            <textarea id="editarDescripcion" name="descripcion" rows={2} placeholder="Descripción opcional"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base"></textarea>
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label for="editarAlto" class="block text-xs font-medium text-gray-700 mb-1">Alto (cm)</label>
              <input id="editarAlto" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
            <div>
              <label for="editarAncho" class="block text-xs font-medium text-gray-700 mb-1">Ancho (cm)</label>
              <input id="editarAncho" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
            <div>
              <label for="editarLargo" class="block text-xs font-medium text-gray-700 mb-1">Largo (cm)</label>
              <input id="editarLargo" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
          </div>
          <div>
          <div id="editarGrillaRow" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-1">Grilla interna del contenedor (casilleros)</label>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label for="editarGridFilas" class="block text-xs font-medium text-gray-700 mb-1">Filas</label>
                <input id="editarGridFilas" type="number" min="1" max="12" placeholder="3"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
              </div>
              <div>
                <label for="editarGridColumnas" class="block text-xs font-medium text-gray-700 mb-1">Columnas</label>
                <input id="editarGridColumnas" type="number" min="1" max="12" placeholder="3"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
              </div>
            </div>
            <p class="text-xs text-gray-400 mt-1">Ej: 2×3 en un armario empotrado. Las Columnas por fila (grilla asimétrica) se configuran en la tarjeta del contenedor con los selectores − / +.</p>
          </div>
          <div id="editarInmuebleRow" class="hidden">
            <label class="flex items-center gap-2 p-3 rounded-lg border border-orange-200 bg-orange-50 cursor-pointer">
              <input id="editarInmueble" name="es_inmueble" type="checkbox"
                class="w-4 h-4 text-orange-600 focus:ring-orange-500 rounded" />
              <span class="text-sm font-medium text-gray-700">📌 Fijar como mueble inmueble <span class="text-orange-600 font-semibold">(No mudable)</span></span>
            </label>
            <p class="text-xs text-gray-400 mt-1">El mueble quedará fijo y adherido permanentemente a la habitación que lo contiene: no podrá arrastrarse ni eliminarse desde la pantalla de almacenamiento.</p>
          </div>
          <!-- 🎒 DECLARACIÓN DE MOVILIDAD: se MUDÓ al panel de portales (Lote 26),
               justo debajo del control «Espacio Único» del nivel activo, donde el
               operador lo ve mientras modela los espacios (ver
               lib/muebleMovil.ts + lib/mapa/portales/editorDivisionesPortales.ts).
               El backend recibe el flag por PUT parcial al crear/editar la celda. -->
            <label class="block text-sm font-medium text-gray-700 mb-1">Foto</label>
            <div class="flex items-start gap-3">
              <div id="editarFotoPreview" class="hidden w-16 h-16 rounded-lg overflow-hidden border border-gray-200 bg-gray-50 flex items-center justify-center flex-shrink-0">
                <img id="editarFotoPreviewImg" class="w-full h-full object-cover" alt="Vista previa de la foto" />
              </div>
              <div class="flex-1 min-w-0 space-y-2">
                <!-- Selector de captura (móvil-first): cámara TRASERA directa vs.
                     galería. Ambos inputs alimentan el MISMO `fotoSeleccionada`
                     del tablero (lib/almacenamientoBoard.ts), así el submit no
                     depende de cuál se usó. `capture="environment"` abre la
                     cámara en tiempo real en iOS/Android. -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <label class="flex items-center justify-center gap-1.5 px-3 py-2.5 bg-blue-700 text-white text-sm font-semibold rounded-lg hover:bg-blue-800 transition-base cursor-pointer"
                    aria-label="Tomar foto con la cámara del teléfono">
                    <span class="text-base leading-none" aria-hidden="true">📷</span>
                    Tomar foto
                    <input id="editarFotoCamaraInput" type="file" accept="image/*" capture="environment" class="hidden" />
                  </label>
                  <label class="flex items-center justify-center gap-1.5 px-3 py-2.5 bg-gray-100 text-gray-700 text-sm font-semibold rounded-lg hover:bg-gray-200 transition-base cursor-pointer"
                    aria-label="Elegir una foto de la galería">
                    <span class="text-base leading-none" aria-hidden="true">🖼️</span>
                    Elegir de la Galería
                    <input id="editarFotoInput" type="file" accept="image/*" class="hidden" />
                  </label>
                </div>
                <span id="editarFotoLabel" class="block text-xs text-gray-400">Sin foto seleccionada</span>
              </div>
            </div>
          </div>
          <!-- ================================================================
               PROPIEDADES DEL OBJETO (Mueble / Objeto declarado)
               Sólo para contenedores con `declarado_movible = true`. El
               contenido se inyecta desde lib/objetoEspacioModal.ts (misma
               fuente de campos que el panel del editor de espacios) y viaja
               en el MISMO PUT del espacio, prefijado `objeto_*`.
               ================================================================ -->
          <div id="editarObjetoCampos" class="hidden border-t border-gray-200 pt-4"></div>
