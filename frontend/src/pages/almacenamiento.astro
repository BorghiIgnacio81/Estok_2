---
// =============================================================================
// PÁGINA DE ALMACENAMIENTO (UNIFICADA)
// Unifica "Ubicaciones" y "Contenedores" en una única vista de dos columnas
// con Drag & Drop nativo (HTML5 API). La lógica vive en
// src/lib/almacenamientoBoard.ts para mantener la página liviana.
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import AuthGuard from '../components/AuthGuard.astro';
import LoadingState from '../components/LoadingState.astro';
import ErrorState from '../components/ErrorState.astro';
import '../styles/mapa-espacial.css';
---

<AuthGuard />

<BaseLayout title="Estok - Almacenamiento | Inventario">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Encabezado -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Almacenamiento</h1>
      <p class="mt-1 text-gray-500">Gestioná ubicaciones y contenedores con arrastrar y soltar</p>
    </div>

    <LoadingState mensaje="Cargando espacios de almacenamiento..." />
    <ErrorState mensaje="Error al cargar los espacios de almacenamiento." />

    <!-- Mapa Espacial (adaptativo por tipo_layout del Estok activo) -->
    <section class="mb-10" id="seccionMapaEspacial">
      <div class="flex items-center justify-between gap-4 mb-4">
        <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">🗺️ Mapa Espacial</h2>
        <span id="mapaEspacialBadge" class="text-xs px-2 py-0.5 rounded-full bg-purple-50 text-purple-700 font-medium">Cargando...</span>
      </div>
      <div id="mapaEspacialCanvas" class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5">
        <p class="text-sm text-gray-400 text-center py-6">Cargando mapa espacial...</p>
      </div>
    </section>

    <!-- Grid de dos columnas (sin scroll horizontal) -->
    <div id="tableroAlmacenamiento" class="grid grid-cols-1 lg:grid-cols-2 gap-8">

      <!-- Columna izquierda: Ubicaciones raíz (drop zones) -->
      <section>
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mb-6">
          <div class="flex items-center gap-2">
            <h2 class="text-lg font-semibold text-gray-900">📍 Ubicaciones</h2>
            <span id="contadorUbicaciones" class="text-xs px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 font-medium">0</span>
          </div>
          <img id="nuevaUbicacionBtn" src="/nueva ubicacion.png" alt="Nueva Ubicación" class="h-28 md:h-36 lg:h-40 w-auto hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer object-contain" />
        </div>
        <p class="text-xs text-gray-500 mb-4">Soltá contenedores dentro de una tarjeta para asignarlos a esa ubicación, o dentro de otro contenedor para crear sub-niveles.</p>
        <div id="columnaUbicaciones" class="space-y-5"></div>
      </section>

      <!-- Columna derecha: Contenedores disponibles (paleta draggable) -->
      <section>
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mb-6">
          <div class="flex items-center gap-2">
            <h2 class="text-lg font-semibold text-gray-900">📦 Contenedores</h2>
            <span id="contadorContenedores" class="text-xs px-2 py-0.5 rounded-full bg-green-50 text-green-700 font-medium">0</span>
          </div>
          <img id="nuevoContenedorBtn" src="/Nuevo Contenedor.png" alt="Nuevo Contenedor" class="h-28 md:h-36 lg:h-40 w-auto hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer object-contain" />
        </div>
        <p class="text-xs text-gray-500 mb-4">Arrastrá un contenedor (✋) hacia una ubicación o dentro de otro contenedor. Todo se guarda automáticamente.</p>
        <div id="columnaContenedores" class="space-y-3"></div>
      </section>
    </div>

    <!-- Modal: Nueva Ubicación -->
    <div id="modalUbicacion" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold text-gray-900">Nueva Ubicación</h3>
          <button type="button" data-cerrar-modal="ubicacion" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <form id="ubiForm" class="space-y-4">
          <div>
            <label for="ubiNombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre <span class="text-red-500">*</span></label>
            <input id="ubiNombre" name="nombre" type="text" required placeholder="Ej: Garaje, Sótano, Oficina"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
          </div>
          <div>
            <label for="ubiDescripcion" class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
            <textarea id="ubiDescripcion" name="descripcion" rows={2} placeholder="Descripción opcional de la ubicación"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base"></textarea>
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label for="ubiLargo" class="block text-xs font-medium text-gray-700 mb-1">Largo (cm)</label>
              <input id="ubiLargo" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
            <div>
              <label for="ubiAncho" class="block text-xs font-medium text-gray-700 mb-1">Ancho (cm)</label>
              <input id="ubiAncho" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
            <div>
              <label for="ubiAlto" class="block text-xs font-medium text-gray-700 mb-1">Alto (cm)</label>
              <input id="ubiAlto" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Foto</label>
            <label class="flex items-center justify-center gap-2 px-4 py-3 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-base cursor-pointer">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span id="ubiFotoLabel">Seleccionar foto</span>
              <input id="ubiFotoInput" type="file" accept="image/*" class="hidden" />
            </label>
          </div>
          <div class="flex gap-3 pt-2">
            <button type="submit" id="ubiSaveBtn"
              class="flex-1 px-4 py-2 bg-blue-700 text-white font-medium rounded-lg hover:bg-blue-800 transition-base disabled:opacity-50">
              <span id="ubiSaveText">Guardar</span>
              <span id="ubiSaveSpinner" class="hidden">
                <svg class="animate-spin h-5 w-5 mx-auto" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" />
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                </svg>
              </span>
            </button>
            <button type="button" data-cerrar-modal="ubicacion" class="flex-1 px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-base">
              Cancelar
            </button>
          </div>
        </form>
        <p id="ubiFormError" data-form-error class="hidden mt-3 text-sm text-red-600"></p>
      </div>
    </div>

    <!-- Modal: Nuevo Contenedor -->
    <div id="modalContenedor" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold text-gray-900">Nuevo Contenedor</h3>
          <button type="button" data-cerrar-modal="contenedor" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <form id="conForm" class="space-y-4">
          <div>
            <label for="conNombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre <span class="text-red-500">*</span></label>
            <input id="conNombre" name="nombre" type="text" required placeholder="Ej: Caja 4, Estante A, Cajón 3"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
          </div>
          <div>
            <label for="conDescripcion" class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
            <textarea id="conDescripcion" name="descripcion" rows={2} placeholder="Descripción opcional"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base"></textarea>
          </div>
          <div>
            <label for="conUbicacion" class="block text-sm font-medium text-gray-700 mb-1">Ubicación <span class="text-red-500">*</span></label>
            <select id="conUbicacion" name="ubicacion" required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base bg-white">
              <option value="">Seleccionar ubicación...</option>
            </select>
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label for="conLargo" class="block text-xs font-medium text-gray-700 mb-1">Largo (cm)</label>
              <input id="conLargo" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
            <div>
              <label for="conAncho" class="block text-xs font-medium text-gray-700 mb-1">Ancho (cm)</label>
              <input id="conAncho" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
            <div>
              <label for="conAlto" class="block text-xs font-medium text-gray-700 mb-1">Alto (cm)</label>
              <input id="conAlto" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Foto</label>
            <label class="flex items-center justify-center gap-2 px-4 py-3 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-base cursor-pointer">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span id="conFotoLabel">Seleccionar foto</span>
              <input id="conFotoInput" type="file" accept="image/*" class="hidden" />
            </label>
          </div>
          <div class="flex gap-3 pt-2">
            <button type="submit" id="conSaveBtn"
              class="flex-1 px-4 py-2 bg-blue-700 text-white font-medium rounded-lg hover:bg-blue-800 transition-base disabled:opacity-50">
              <span id="conSaveText">Guardar</span>
              <span id="conSaveSpinner" class="hidden">
                <svg class="animate-spin h-5 w-5 mx-auto" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" />
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                </svg>
              </span>
            </button>
            <button type="button" data-cerrar-modal="contenedor" class="flex-1 px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-base">
              Cancelar
            </button>
          </div>
        </form>
        <p id="conFormError" data-form-error class="hidden mt-3 text-sm text-red-600"></p>
      </div>
    </div>
  </div>

    <!-- Modal: Editar entidad (Ubicación / Contenedor) -->
    <div id="modalEditar" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6">
        <div class="flex justify-between items-center mb-4">
          <h3 id="editarTitulo" class="text-lg font-semibold text-gray-900">Editar</h3>
          <button type="button" data-cerrar-modal="editar" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <form id="editarForm" class="space-y-4">
          <input type="hidden" id="editarTipo" value="" />
          <input type="hidden" id="editarId" value="" />
          <div>
            <label for="editarNombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre <span class="text-red-500">*</span></label>
            <input id="editarNombre" name="nombre" type="text" required placeholder="Nombre de la entidad"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
          </div>
          <div>
            <label for="editarDescripcion" class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
            <textarea id="editarDescripcion" name="descripcion" rows={2} placeholder="Descripción opcional"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base"></textarea>
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label for="editarAlto" class="block text-xs font-medium text-gray-700 mb-1">Alto (cm)</label>
              <input id="editarAlto" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
            <div>
              <label for="editarAncho" class="block text-xs font-medium text-gray-700 mb-1">Ancho (cm)</label>
              <input id="editarAncho" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
            <div>
              <label for="editarLargo" class="block text-xs font-medium text-gray-700 mb-1">Largo (cm)</label>
              <input id="editarLargo" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Foto</label>
            <div class="flex items-center gap-3">
              <div id="editarFotoPreview" class="hidden w-16 h-16 rounded-lg overflow-hidden border border-gray-200 bg-gray-50 flex items-center justify-center flex-shrink-0">
                <img id="editarFotoPreviewImg" class="w-full h-full object-cover" alt="Vista previa de la foto" />
              </div>
              <label class="flex-1 flex items-center justify-center gap-2 px-4 py-3 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-base cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span id="editarFotoLabel">Seleccionar foto</span>
                <input id="editarFotoInput" type="file" accept="image/*" class="hidden" />
              </label>
            </div>
          </div>
          <div class="flex gap-3 pt-2">
            <button type="submit" id="editarSaveBtn"
              class="flex-1 px-4 py-2 bg-blue-700 text-white font-medium rounded-lg hover:bg-blue-800 transition-base disabled:opacity-50">
              <span id="editarSaveText">Guardar cambios</span>
              <span id="editarSaveSpinner" class="hidden">
                <svg class="animate-spin h-5 w-5 mx-auto" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" />
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                </svg>
              </span>
            </button>
            <button type="button" data-cerrar-modal="editar" class="flex-1 px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-base">
              Cancelar
            </button>
          </div>
        </form>
        <p id="editarFormError" data-form-error class="hidden mt-3 text-sm text-red-600"></p>
      </div>
    </div>
</BaseLayout>

<style is:global>
  /* =========================================================================
     Feedback visual del Drag & Drop (borde intermitente + fondo azulado)
     ========================================================================= */
  @keyframes dndPulso {
    0%, 100% { box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15); }
    50% { box-shadow: 0 0 0 7px rgba(59, 130, 246, 0.35); }
  }

  .dnd-ubicacion.dnd-drop-activo,
  .dnd-contenedor.dnd-drop-activo {
    border-color: #3b82f6 !important;
    animation: dndPulso 0.9s ease-in-out infinite;
  }

  .dnd-ubicacion.dnd-drop-activo {
    background-color: rgba(219, 234, 254, 0.55) !important;
  }

  @keyframes dndFadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .dnd-toast {
    animation: dndFadeIn 0.2s ease-out;
  }
</style>

<script>
  import { AlmacenamientoBoard } from '../lib/almacenamientoBoard';
  import { fetchTipoLayoutEstokActivo, renderMapaEspacial } from '../lib/mapaEspacial';

  const tablero = new AlmacenamientoBoard();
  tablero.init();

  // Mapa Espacial adaptativo por inquilino: lee el tipo_layout del Estok activo
  // y renderiza el lienzo (CASA_2_PISOS => vertical dividido | VISTA_PLANTA_UNICA
  // => lienzo único full-width estilo Word).
  void (async () => {
    const [tipoLayout, ubicaciones] = await Promise.all([
      fetchTipoLayoutEstokActivo(),
      tablero.obtenerUbicacionesParaMapa(),
    ]);
    renderMapaEspacial(
      document.getElementById('mapaEspacialCanvas'),
      tipoLayout,
      ubicaciones,
      document.getElementById('mapaEspacialBadge'),
    );
  })();
</script>
