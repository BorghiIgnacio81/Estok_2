---
// =============================================================================
// PÃGINA DE ALMACENAMIENTO - FLUJO EN CASCADA SIMÃ‰TRICO DE TRES ESCENAS
//  ESCENA 1: Izq = Mapa Estok (casa) Â· Der = Mapa general de la Planta
//  ESCENA 2: Izq = Plano de habitaciones Â· Der = Visor de HabitaciÃ³n
//  ESCENA 3: Izq = Visor de HabitaciÃ³n Â· Der = Visor Contenedor Grande
// Bandeja inferior permanente: contenedores pequeÃ±os y objetos por ubicar,
// con origen de arrastre hacia casilleros y Drop Zone de extracciÃ³n viva.
// LÃ³gica en src/lib/mapaCasitaNavegable.ts, src/lib/visorHabitacion.ts,
// src/lib/visorContenedorGrande.ts y src/lib/bandejaSinUbicar.ts.
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import AuthGuard from '../components/AuthGuard.astro';
import LoadingState from '../components/LoadingState.astro';
import ErrorState from '../components/ErrorState.astro';
import '../styles/mapa-espacial.css';
import '../styles/mapa-casita.css';
import '../styles/almacenamiento-escenas.css';
---

<AuthGuard />

<BaseLayout title="Estok - Almacenamiento | Inventario">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-36">
    <!-- Encabezado -->
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-900">Almacenamiento</h1>
      <p class="mt-1 text-gray-500">Flujo en cascada por niveles: Mapa Estok â†’ Habitaciones â†’ Contenedores Mayores</p>
    </div>

    <!-- Leyenda de iconografÃ­a local del Lienzo de Mapeo Espacial -->
    <div class="mb-8 flex flex-wrap items-center gap-x-6 gap-y-3 bg-white rounded-2xl border border-gray-200 shadow-sm px-5 py-3.5">
      <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">IconografÃ­a del lienzo</span>
      <span class="flex items-center gap-2 text-xs text-gray-600">
        <img src="/archivador-login.png" class="h-16 w-auto draggable" alt="Contenedor grande" />
        Contenedor grande (contiene contenedores)
      </span>
      <span class="flex items-center gap-2 text-xs text-gray-600">
        <img src="/Nuevo Contenedor.png" class="h-16 w-auto draggable" alt="Contenedor pequeÃ±o" />
        Contenedor pequeÃ±o (solo objetos)
      </span>
      <span class="flex items-center gap-2 text-xs text-gray-600">
        <img src="/fluffy_plush_ball.jpg" class="h-12 w-12 rounded-full draggable" alt="Objeto individual" />
        Objeto individual
      </span>
    </div>

    <LoadingState mensaje="Cargando espacios de almacenamiento..." />
    <ErrorState mensaje="Error al cargar los espacios de almacenamiento." />

    <!-- =========================================================================
         TRES ESCENAS EN CASCADA (izquierda â†’ derecha)
         ESCENA 1: Izq = Mapa Estok (casa)         Â· Der = Mapa general de la Planta
         ESCENA 2: Izq = Plano de habitaciones     Â· Der = Visor de HabitaciÃ³n
         ESCENA 3: Izq = Visor de HabitaciÃ³n       Â· Der = Visor Contenedor Grande
         La mÃ¡quina de escenas vive en el <script> (eventos estok:*).
         ========================================================================= -->
    <section class="mb-10" id="seccionCascada">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- PANEL IZQUIERDO (ESCENAS 1-2: Mapa Estok / ESCENA 3: Visor de HabitaciÃ³n) -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5 escena-panel">
          <div class="flex items-center justify-between gap-3 flex-wrap mb-3">
            <div class="flex items-center gap-2 flex-wrap">
              <h2 id="tituloPanelIzquierdo" class="text-lg font-semibold text-gray-900 flex items-center gap-2">ðŸ  Mapa Estok</h2>
              <span id="mapaJerarquicoBadge" class="text-xs px-2 py-0.5 rounded-full bg-purple-50 text-purple-700 font-medium">Cargando...</span>
            </div>
          </div>
          <p id="descPanelIzquierdo" class="text-xs text-gray-500 mb-3">EdiciÃ³n en vivo sobre el lienzo: clic en un nombre para renombrar, arrastrÃ¡ las tarjetas para reacomodarlas entre cuadrantes y tirÃ¡ de su esquina para estirarlas. TocÃ¡ una planta para desplegar el plano de sus habitaciones.</p>
          <div id="contenidoPanelIzquierdo" class="mt-1">
            <div id="mapaEstokPanel">
              <p class="text-sm text-gray-400 text-center py-6">Cargando mapa espacial...</p>
            </div>
            <!-- En ESCENA 3 el #visorHabitacion se reubica aquÃ­ desde el panel derecho -->
          </div>
        </div>

        <!-- PANEL DERECHO (ESCENAS 1-2: Visor de HabitaciÃ³n / ESCENA 3: Visor Contenedor Grande) -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5 escena-panel">
          <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
            <div class="flex items-center gap-2">
              <h2 id="tituloPanelDerecho" class="text-lg font-semibold text-gray-900 flex items-center gap-2">ðŸ—ºï¸ Mapa general de la Planta</h2>
            </div>
            <button type="button" id="btnVolverEscena" class="volver-btn hidden" title="Volver al nivel anterior del flujo en cascada">
              <svg class="volver-btn-ico" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"/></svg>
              <span>Volver</span>
            </button>
          </div>
          <p id="descPanelDerecho" class="text-xs text-gray-500 mb-3">El detalle del nivel actual. Los casilleros reciben elementos por Drag &amp; Drop exclusivamente (sin botones +).</p>
          <div id="contenidoPanelDerecho" class="mt-1">
            <div id="visorHabitacion" class="min-h-[180px]">
              <div class="visor-placeholder">
                <div class="visor-placeholder-ico">ðŸ </div>
                <p class="visor-placeholder-texto">Cargando minimapas de las plantas del Estok activo...</p>
              </div>
            </div>
            <div id="visorContenedorGrande" class="hidden mt-1"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================================
         BANDEJA INFERIOR DE ELEMENTOS POR UBICAR (permanente, fixed bottom)
         Lista Contenedores PequeÃ±os y Objetos sin casillero asignado. Es origen
         de arrastre hacia los casilleros Y Drop Zone de extracciÃ³n viva.
         ========================================================================= -->
    <section id="bandejaSinUbicar" class="bandeja-fixed" aria-label="Bandeja de elementos por ubicar">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bandeja-inner">
          <div class="flex items-center gap-3 flex-wrap mb-2">
            <span class="bandeja-titulo">ðŸ§º Elementos por ubicar</span>
            <span id="contadorBandeja" class="bandeja-contador">0</span>
            <span class="bandeja-hint">Arrastralos hacia un casillero del Visor o de un mueble, o soltÃ¡ un elemento de un casillero acÃ¡ para extraerlo.</span>
          </div>
          <div id="bandejaContenido" class="bandeja-contenido"></div>
        </div>
      </div>
    </section>
  </div>

    <!-- Modal: Editar entidad (UbicaciÃ³n / Contenedor) -->
    <div id="modalEditar" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6">
        <div class="flex justify-between items-center mb-4">
          <h3 id="editarTitulo" class="text-lg font-semibold text-gray-900">Editar</h3>
          <button type="button" data-cerrar-modal="editar" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <form id="editarForm" class="space-y-4">
          <input type="hidden" id="editarTipo" value="" />
          <input type="hidden" id="editarId" value="" />
          <div>
            <label for="editarNombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre <span class="text-red-500">*</span></label>
            <input id="editarNombre" name="nombre" type="text" required placeholder="Nombre de la entidad"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
          </div>
          <div>
            <label for="editarDescripcion" class="block text-sm font-medium text-gray-700 mb-1">DescripciÃ³n</label>
            <textarea id="editarDescripcion" name="descripcion" rows={2} placeholder="DescripciÃ³n opcional"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base"></textarea>
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label for="editarAlto" class="block text-xs font-medium text-gray-700 mb-1">Alto (cm)</label>
              <input id="editarAlto" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
            <div>
              <label for="editarAncho" class="block text-xs font-medium text-gray-700 mb-1">Ancho (cm)</label>
              <input id="editarAncho" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
            <div>
              <label for="editarLargo" class="block text-xs font-medium text-gray-700 mb-1">Largo (cm)</label>
              <input id="editarLargo" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
          </div>
          <div>
          <div id="editarGrillaRow" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-1">Grilla interna del contenedor (casilleros)</label>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label for="editarGridFilas" class="block text-xs font-medium text-gray-700 mb-1">Filas</label>
                <input id="editarGridFilas" type="number" min="1" max="12" placeholder="3"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
              </div>
              <div>
                <label for="editarGridColumnas" class="block text-xs font-medium text-gray-700 mb-1">Columnas</label>
                <input id="editarGridColumnas" type="number" min="1" max="12" placeholder="3"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
              </div>
            </div>
            <p class="text-xs text-gray-400 mt-1">Ej: 2Ã—3 en un armario empotrado. Las Columnas por fila (grilla asimÃ©trica) se configuran en la tarjeta del contenedor con los selectores âˆ’ / +.</p>
          </div>
          <div id="editarInmuebleRow" class="hidden">
            <label class="flex items-center gap-2 p-3 rounded-lg border border-orange-200 bg-orange-50 cursor-pointer">
              <input id="editarInmueble" name="es_inmueble" type="checkbox"
                class="w-4 h-4 text-orange-600 focus:ring-orange-500 rounded" />
              <span class="text-sm font-medium text-gray-700">ðŸ“Œ Fijar como mueble inmueble <span class="text-orange-600 font-semibold">(No mudable)</span></span>
            </label>
            <p class="text-xs text-gray-400 mt-1">El mueble quedarÃ¡ fijo y adherido permanentemente a la habitaciÃ³n que lo contiene: no podrÃ¡ arrastrarse ni eliminarse desde la pantalla de almacenamiento.</p>
          </div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Foto</label>
            <div class="flex items-center gap-3">
              <div id="editarFotoPreview" class="hidden w-16 h-16 rounded-lg overflow-hidden border border-gray-200 bg-gray-50 flex items-center justify-center flex-shrink-0">
                <img id="editarFotoPreviewImg" class="w-full h-full object-cover" alt="Vista previa de la foto" />
              </div>
              <label class="flex-1 flex items-center justify-center gap-2 px-4 py-3 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-base cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span id="editarFotoLabel">Seleccionar foto</span>
                <input id="editarFotoInput" type="file" accept="image/*" class="hidden" />
              </label>
            </div>
          </div>
          <div class="flex gap-3 pt-2">
            <button type="submit" id="editarSaveBtn"
              class="flex-1 px-4 py-2 bg-blue-700 text-white font-medium rounded-lg hover:bg-blue-800 transition-base disabled:opacity-50">
              <span id="editarSaveText">Guardar cambios</span>
              <span id="editarSaveSpinner" class="hidden">
                <svg class="animate-spin h-5 w-5 mx-auto" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" />
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                </svg>
              </span>
            </button>
            <button type="button" data-cerrar-modal="editar" class="flex-1 px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-base">
              Cancelar
            </button>
          </div>
        </form>
        <p id="editarFormError" data-form-error class="hidden mt-3 text-sm text-red-600"></p>
      </div>
    </div>

</BaseLayout>

<script>
  import { AlmacenamientoBoard } from '../lib/almacenamientoBoard';
  import { initMapaCasita } from '../lib/mapaCasitaNavegable';
  import { initVisor } from '../lib/visorHabitacion';
  import { initVisorContenedorGrande } from '../lib/visorContenedorGrande';
  import { initBandeja } from '../lib/bandejaSinUbicar';

  // ===========================================================================
  // ARRANQUE CON GARANTÃA DE DOM LISTO
  // El render del lienzo "Mapa Estok" se enlaza dentro de DOMContentLoaded para
  // que la silueta con techo puntiagudo dibuje de forma instantÃ¡nea el Nivel 1
  // (divisiones raÃ­z del Estok activo) apenas carga la pÃ¡gina. Si el script ya
  // corre con el DOM listo (mÃ³dulo deferred), se ejecuta de inmediato.
  // ===========================================================================
  function alCargarDom(accion: () => void): void {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => accion());
    } else {
      accion();
    }
  }

  alCargarDom(() => {
    const tablero = new AlmacenamientoBoard();
    void tablero.init();


    // =========================================================================
    // MÃQUINA DE TRES ESCENAS EN CASCADA (izquierda â†’ derecha)
    //   ESCENA 1: Mapa Estok (casa) Â· Mapa general de la Planta
    //   ESCENA 2: Plano de habitaciones Â· Visor de HabitaciÃ³n
    //   ESCENA 3: Visor de HabitaciÃ³n Â· Visor Contenedor Grande (+ Volver)
    // =========================================================================
    type Escena = 1 | 2 | 3;
    let plantaActiva = false;
    let habitacionActiva = false;

    const slotIzq = () => document.getElementById('contenidoPanelIzquierdo') as HTMLElement | null;
    const slotDer = () => document.getElementById('contenidoPanelDerecho') as HTMLElement | null;
    const visorEl = () => document.getElementById('visorHabitacion') as HTMLElement | null;
    const mapaEl = () => document.getElementById('mapaEstokPanel') as HTMLElement | null;
    const cgEl = () => document.getElementById('visorContenedorGrande') as HTMLElement | null;
    const btnVolver = () => document.getElementById('btnVolverEscena') as HTMLElement | null;

    function irAEscena(escena: Escena): void {
      const visor = visorEl();
      const mapa = mapaEl();
      const cg = cgEl();
      const badge = document.getElementById('mapaJerarquicoBadge');
      const tituloIzq = document.getElementById('tituloPanelIzquierdo');
      const tituloDer = document.getElementById('tituloPanelDerecho');
      const descIzq = document.getElementById('descPanelIzquierdo');
      const descDer = document.getElementById('descPanelDerecho');

      if (escena === 3) {
        // El "Visor de HabitaciÃ³n" se DESPLAZA al panel izquierdo.
        if (visor && slotIzq()) slotIzq()!.appendChild(visor);
        mapa?.classList.add('hidden');
        cg?.classList.remove('hidden');
        if (tituloIzq) tituloIzq.textContent = 'ðŸ§­ Visor de HabitaciÃ³n';
        if (tituloDer) tituloDer.textContent = 'ðŸ“¦ Visor Contenedor Grande';
        if (descIzq) descIzq.textContent = 'Lienzo matricial de la habitaciÃ³n: recibÃ­ muebles, cajas y objetos por arrastre.';
        if (descDer) descDer.textContent = 'Muebles y archivadores de la habitaciÃ³n. SoltÃ¡ contenedores pequeÃ±os y objetos desde la bandeja en sus casilleros.';
        badge?.classList.add('hidden');
        btnVolver()?.classList.remove('hidden');
      } else {
        // El "Visor de HabitaciÃ³n" vuelve al panel derecho.
        if (visor && slotDer()) slotDer()!.appendChild(visor);
        mapa?.classList.remove('hidden');
        cg?.classList.add('hidden');
        if (tituloIzq) tituloIzq.textContent = 'ðŸ  Mapa Estok';
        if (tituloDer) tituloDer.textContent = escena === 1 ? 'ðŸ—ºï¸ Mapa general de la Planta' : 'ðŸ§­ Visor de HabitaciÃ³n';
        if (descIzq) descIzq.textContent = 'NavegaciÃ³n tÃ¡ctil por niveles en cascada: tocÃ¡ una planta para desplegar el plano de sus habitaciones, y una habitaciÃ³n para inspeccionarla.';
        if (descDer) descDer.textContent = escena === 1
          ? 'Vista general de las plantas del Estok activo. SeleccionÃ¡ una planta en el Mapa Estok para descender al plano de habitaciones.'
          : 'SeleccionÃ¡ una habitaciÃ³n en el plano para abrir su Visor. Los casilleros reciben elementos por Drag & Drop exclusivamente.';
        badge?.classList.remove('hidden');
        if (escena === 1) btnVolver()?.classList.add('hidden');
      }
    }

    function recalcularEscena(): void {
      irAEscena(habitacionActiva ? 3 : plantaActiva ? 2 : 1);
    }

    window.addEventListener('estok:planta-seleccionada', (e) => {
      const detalle = (e as CustomEvent<{ fila: number | null }>).detail;
      plantaActiva = Boolean(detalle?.fila);
      recalcularEscena();
    });
    window.addEventListener('estok:habitacion-seleccionada', (e) => {
      const room = (e as CustomEvent<{ room: { id: string } | null }>).detail?.room ?? null;
      habitacionActiva = Boolean(room);
      recalcularEscena();
    });

    // BotÃ³n "â¬… Volver" (ESCENA 3 â†’ 2): deselecciona la habitaciÃ³n y la
    // mÃ¡quina reubica el Visor en el panel derecho.
    btnVolver()?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('estok:habitacion-seleccionada', { detail: { room: null } }));
    });

    // =========================================================================
    // ARRANQUE DE MÃ“DULOS
    // =========================================================================
    initBandeja({ contenedor: document.getElementById('bandejaContenido') });
    initVisorContenedorGrande({ contenedor: document.getElementById('visorContenedorGrande') });
    initMapaCasita({
      mapa: document.getElementById('mapaEstokPanel'),
      badge: document.getElementById('mapaJerarquicoBadge'),
    });
    initVisor();
  });
</script>
