---
// =============================================================================
// PÁGINA DE ALMACENAMIENTO - PANTALLA DIVIDIDA ÚNICA (Nivel 1 → Nivel 2)
// El lienzo queda acotado a la fila principal de split (grid lg:grid-cols-2):
//  - Izquierda: Mapa Estok navegable (casa con techo, Nivel 1 → habitaciones).
//  - Derecha  : Visor de Habitación con minimapas rectangulares de las plantas
//               en estado inicial y lienzo matricial DnD al seleccionar una.
// La lógica vive en src/lib/mapaCasitaNavegable.ts, src/lib/visorHabitacion.ts
// y src/lib/mapaEstokWizardUI.ts para mantener la página liviana.
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import AuthGuard from '../components/AuthGuard.astro';
import LoadingState from '../components/LoadingState.astro';
import ErrorState from '../components/ErrorState.astro';
import '../styles/mapa-espacial.css';
import '../styles/mapa-estok-wizard.css';
import '../styles/mapa-casita.css';
---

<AuthGuard />

<BaseLayout title="Estok - Almacenamiento | Inventario">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Encabezado -->
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-900">Almacenamiento</h1>
      <p class="mt-1 text-gray-500">Flujo en cascada por niveles: Mapa Estok → Habitaciones → Contenedores Mayores</p>
    </div>

    <!-- Leyenda de iconografía local del Lienzo de Mapeo Espacial -->
    <div class="mb-8 flex flex-wrap items-center gap-x-6 gap-y-3 bg-white rounded-2xl border border-gray-200 shadow-sm px-5 py-3.5">
      <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Iconografía del lienzo</span>
      <span class="flex items-center gap-2 text-xs text-gray-600">
        <img src="/archivador-login.png" class="h-16 w-auto draggable" alt="Contenedor grande" />
        Contenedor grande (contiene contenedores)
      </span>
      <span class="flex items-center gap-2 text-xs text-gray-600">
        <img src="/Nuevo Contenedor.png" class="h-16 w-auto draggable" alt="Contenedor pequeño" />
        Contenedor pequeño (solo objetos)
      </span>
      <span class="flex items-center gap-2 text-xs text-gray-600">
        <img src="/fluffy_plush_ball.jpg" class="h-12 w-12 rounded-full draggable" alt="Objeto individual" />
        Objeto individual
      </span>
    </div>

    <LoadingState mensaje="Cargando espacios de almacenamiento..." />
    <ErrorState mensaje="Error al cargar los espacios de almacenamiento." />

    <!-- =========================================================================
         SECCIÓN ÚNICA - PANTALLA DIVIDIDA (NIVELES 1 y 2)
         Izquierda: Mapa Estok (Nivel 1) navegable tipo casa + plano de Nivel 2.
         Derecha  : Visor de la Habitación con minimapas rectangulares de plantas
                    (estado inicial) y lienzo matricial DnD (habitación activa).
         ========================================================================= -->
    <section class="mb-10" id="seccionMapaEstok">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- LADO IZQUIERDO: Mapa Estok (Nivel 1) -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5">
          <div class="flex items-center justify-between gap-3 flex-wrap mb-3">
            <div class="flex items-center gap-2 flex-wrap">
              <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">🏠 Mapa Estok</h2>
              <span id="mapaJerarquicoBadge" class="text-xs px-2 py-0.5 rounded-full bg-purple-50 text-purple-700 font-medium">Cargando...</span>
              <button type="button" id="editarEstructuraBtn"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-orange-600 text-white text-xs font-semibold rounded-full hover:bg-orange-700 transition-base shadow-sm"
                title="Abrir el modelador jerárquico del Mapa de Estok (plantas, habitaciones, muebles y estanterías)">
                ✏️ Editar Estructura
              </button>
            </div>
          </div>
          <p class="text-xs text-gray-500 mb-3">Navegación táctil por niveles en cascada: tocá una planta de la casa para desplegar el plano de sus habitaciones. La configuración numérica de la estructura quedó encapsulada dentro de «✏️ Editar Estructura».</p>
          <div id="mapaEstokPanel" class="mt-1">
            <p class="text-sm text-gray-400 text-center py-6">Cargando mapa espacial...</p>
          </div>
        </div>

        <!-- LADO DERECHO: Visor de la Habitación Seleccionada (Nivel 2) -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5">
          <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
            <div class="flex items-center gap-2">
              <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">🏠 Visor de Habitación <span class="text-sm font-normal text-gray-400">(Nivel 2)</span></h2>
            </div>
          </div>
          <p class="text-xs text-gray-500 mb-3">Hacé clic sobre una habitación encastrada en el Mapa Estok para inspeccionarla. Su lienzo matricial recibe contenedores y objetos por Drag &amp; Drop.</p>
          <div id="visorHabitacion" class="min-h-[180px]">
            <div class="visor-placeholder">
              <div class="visor-placeholder-ico">🏠</div>
              <p class="visor-placeholder-texto">Cargando minimapas de las plantas del Estok activo...</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

    <!-- Modal: Editar entidad (Ubicación / Contenedor) -->
    <div id="modalEditar" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6">
        <div class="flex justify-between items-center mb-4">
          <h3 id="editarTitulo" class="text-lg font-semibold text-gray-900">Editar</h3>
          <button type="button" data-cerrar-modal="editar" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <form id="editarForm" class="space-y-4">
          <input type="hidden" id="editarTipo" value="" />
          <input type="hidden" id="editarId" value="" />
          <div>
            <label for="editarNombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre <span class="text-red-500">*</span></label>
            <input id="editarNombre" name="nombre" type="text" required placeholder="Nombre de la entidad"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
          </div>
          <div>
            <label for="editarDescripcion" class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
            <textarea id="editarDescripcion" name="descripcion" rows={2} placeholder="Descripción opcional"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base"></textarea>
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label for="editarAlto" class="block text-xs font-medium text-gray-700 mb-1">Alto (cm)</label>
              <input id="editarAlto" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
            <div>
              <label for="editarAncho" class="block text-xs font-medium text-gray-700 mb-1">Ancho (cm)</label>
              <input id="editarAncho" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
            <div>
              <label for="editarLargo" class="block text-xs font-medium text-gray-700 mb-1">Largo (cm)</label>
              <input id="editarLargo" type="number" step="0.01" placeholder="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
          </div>
          <div>
          <div id="editarGrillaRow" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-1">Grilla interna del contenedor (casilleros)</label>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label for="editarGridFilas" class="block text-xs font-medium text-gray-700 mb-1">Filas</label>
                <input id="editarGridFilas" type="number" min="1" max="12" placeholder="3"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
              </div>
              <div>
                <label for="editarGridColumnas" class="block text-xs font-medium text-gray-700 mb-1">Columnas</label>
                <input id="editarGridColumnas" type="number" min="1" max="12" placeholder="3"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
              </div>
            </div>
            <p class="text-xs text-gray-400 mt-1">Ej: 2×3 en un armario empotrado. Las Columnas por fila (grilla asimétrica) se configuran en la tarjeta del contenedor con los selectores − / +.</p>
          </div>
          <div id="editarInmuebleRow" class="hidden">
            <label class="flex items-center gap-2 p-3 rounded-lg border border-orange-200 bg-orange-50 cursor-pointer">
              <input id="editarInmueble" name="es_inmueble" type="checkbox"
                class="w-4 h-4 text-orange-600 focus:ring-orange-500 rounded" />
              <span class="text-sm font-medium text-gray-700">📌 Fijar como mueble inmueble <span class="text-orange-600 font-semibold">(No mudable)</span></span>
            </label>
            <p class="text-xs text-gray-400 mt-1">El mueble quedará fijo y adherido permanentemente a la habitación que lo contiene: no podrá arrastrarse ni eliminarse desde la pantalla de almacenamiento.</p>
          </div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Foto</label>
            <div class="flex items-center gap-3">
              <div id="editarFotoPreview" class="hidden w-16 h-16 rounded-lg overflow-hidden border border-gray-200 bg-gray-50 flex items-center justify-center flex-shrink-0">
                <img id="editarFotoPreviewImg" class="w-full h-full object-cover" alt="Vista previa de la foto" />
              </div>
              <label class="flex-1 flex items-center justify-center gap-2 px-4 py-3 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-base cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span id="editarFotoLabel">Seleccionar foto</span>
                <input id="editarFotoInput" type="file" accept="image/*" class="hidden" />
              </label>
            </div>
          </div>
          <div class="flex gap-3 pt-2">
            <button type="submit" id="editarSaveBtn"
              class="flex-1 px-4 py-2 bg-blue-700 text-white font-medium rounded-lg hover:bg-blue-800 transition-base disabled:opacity-50">
              <span id="editarSaveText">Guardar cambios</span>
              <span id="editarSaveSpinner" class="hidden">
                <svg class="animate-spin h-5 w-5 mx-auto" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" />
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                </svg>
              </span>
            </button>
            <button type="button" data-cerrar-modal="editar" class="flex-1 px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-base">
              Cancelar
            </button>
          </div>
        </form>
        <p id="editarFormError" data-form-error class="hidden mt-3 text-sm text-red-600"></p>
      </div>
    </div>

  <!-- Contenedor raíz del Wizard "✏️ Editar Estructura" (Mapa de Estok) -->
  <div id="mapaEstokWizardRoot"></div>
</BaseLayout>

<style is:global>
  /* =========================================================================
     Feedback visual del Drag & Drop (borde intermitente + fondo azulado)
     ========================================================================= */
  @keyframes dndPulso {
    0%, 100% { box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15); }
    50% { box-shadow: 0 0 0 7px rgba(59, 130, 246, 0.35); }
  }

  .dnd-ubicacion.dnd-drop-activo,
  .dnd-contenedor.dnd-drop-activo {
    border-color: #3b82f6 !important;
    animation: dndPulso 0.9s ease-in-out infinite;
  }

  .dnd-ubicacion.dnd-drop-activo {
    background-color: rgba(219, 234, 254, 0.55) !important;
  }

  @keyframes dndFadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .dnd-toast {
    animation: dndFadeIn 0.2s ease-out;
  }

  /* =========================================================================
     Visor de Habitación - estado inicial: minimapas rectangulares de las
     plantas ("Planta Alta" y "Planta Baja") en paralelo + guía de casillero.
     ========================================================================= */
  .visor-default {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .visor-default-encabezado {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .visor-default-sub {
    font-size: 12px;
    color: #6b7280;
  }

  .visor-default-minimapas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
  }

  .visor-minimapa-planta {
    flex-direction: column;
    align-items: flex-start;
  }

  .visor-minimapa-planta svg {
    margin: 0 auto;
  }
</style>

<script>
  import { AlmacenamientoBoard } from '../lib/almacenamientoBoard';
  import { initMapaCasita } from '../lib/mapaCasitaNavegable';
  import { initVisor } from '../lib/visorHabitacion';
  import { MapaEstokWizardUI } from '../lib/mapaEstokWizardUI';
  import { getEstokActivoId, getCachedUser } from '../services/auth';

  // ===========================================================================
  // ARRANQUE CON GARANTÍA DE DOM LISTO
  // El render del lienzo "Mapa Estok" se enlaza dentro de DOMContentLoaded para
  // que la silueta con techo puntiagudo dibuje de forma instantánea el Nivel 1
  // (divisiones raíz del Estok activo) apenas carga la página. Si el script ya
  // corre con el DOM listo (módulo deferred), se ejecuta de inmediato.
  // ===========================================================================
  function alCargarDom(accion: () => void): void {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => accion());
    } else {
      accion();
    }
  }

  alCargarDom(() => {
    const tablero = new AlmacenamientoBoard();
    void tablero.init();

    // =========================================================================
    // WIZARD "✏️ EDICION DE ESTRUCTURA" — REUTILIZA EL MODAL DE ALTA DE ESTOK
    // Abre el modelador jerárquico precargado con la estructura ACTUAL y, al
    // "Guardar Mapa", hace PUTs granulares (JWT + X-Estok-Id) y refresca en vivo
    // el lienzo del Drag & Drop (evento estok:espacios-cambiados).
    // =========================================================================
    const editarEstructuraBtn = document.getElementById('editarEstructuraBtn');
    const mapaEstokWizardRoot = document.getElementById('mapaEstokWizardRoot')!;

    editarEstructuraBtn?.addEventListener('click', async () => {
      const estokId = getEstokActivoId();
      if (!estokId) {
        (window as any).showError?.('No hay un Estok activo para editar.');
        return;
      }
      const estokNombre = getCachedUser()?.estoks?.find((e) => e.id === estokId)?.nombre || 'Estok';
      const wizard = new MapaEstokWizardUI(mapaEstokWizardRoot);
      try {
        await wizard.abrirEdicion(
          { id: estokId, nombre: estokNombre },
          {
            onGuardado: () => {
              (window as any).showSuccess?.('✅ Estructura del Mapa Estok actualizada.');
            },
            onCerrar: () => {
              // Sin acción: el usuario cerró el modal sin guardar.
            },
          },
        );
      } catch (err: any) {
        (window as any).showError?.(err?.message || 'No se pudo abrir el editor de estructura.');
      }
    });

    // La cascada inferior (Habitaciones/Contenedores) fue eliminada: la fila
    // activa del Mapa Estok ya no filtra una sección inferior. El Visor de la
    // derecha gestiona el detalle de la habitación seleccionada por su cuenta.
    // (evento 'estok:habitacion-seleccionada' → initVisor).

    // Lienzo navegable "Mapa Estok" (Nivel 1 casa → Nivel 2 habitaciones) +
    // Visor de la habitación seleccionada en la columna derecha.
    initMapaCasita({
      mapa: document.getElementById('mapaEstokPanel'),
      badge: document.getElementById('mapaJerarquicoBadge'),
    });
    initVisor();
  });
</script>
