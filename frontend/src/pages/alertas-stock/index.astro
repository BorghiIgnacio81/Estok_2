---
// =============================================================================
// PÁGINA DE DECISIONES (pestaña del menú)
// -----------------------------------------------------------------------------
// Centraliza la resolución de los objetos del Estok activo en DOS secciones:
//
//   1. 🗳️ Votaciones pendientes del Estok — objetos con Dueño (original o
//      EXTERNO) y Beneficiario VACÍO: los resuelve la democracia del Estok,
//      1 usuario = 1 voto (components/VotacionesPendientes.astro).
//
//   2. 🧭 Objetos pendientes de decisión — cuadrícula simétrica de tarjetas con
//      foto, título, ubicación actual (mini-guía analítica del motor compartido
//      minimapasAnidados.ts, el MISMO del componente MinimapaRuta.astro) y la
//      botonera in-place 💰 Vender / 📦 Conservar / 🗑️ Tirar.
//
// Toda la lógica vive en src/lib (decisionesPendientes.ts y publicarObjeto.ts):
// esta página es únicamente el host y el arranque, para no superar las 400
// líneas (disciplina de modularidad del proyecto).
//
// Datos: GET /api/objetos/pendientes_decision/ y GET /api/decisiones/pendientes/
// con la auth centralizada (JWT + X-Estok-Id) de services/auth.
// =============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthGuard from '../../components/AuthGuard.astro';
import LoadingState from '../../components/LoadingState.astro';
import ErrorState from '../../components/ErrorState.astro';
import EmptyState from '../../components/EmptyState.astro';
import VotacionesPendientes from '../../components/VotacionesPendientes.astro';
import PublicarObjetoModal from '../../components/PublicarObjetoModal.astro';
// Estilos de la MINI-GUÍA ANALÍTICA (.mini-anidado*) que dibujan las tarjetas:
// único archivo compartido con Almacenamiento y Objetos, no se duplican reglas.
import '../../styles/almacenamiento-portales.css';

export const prerender = false;
---

<AuthGuard />

<BaseLayout title="Estok - Decisiones de Objetos | Inventario">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Encabezado -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Decisiones de Objetos</h1>
        <p class="mt-1 text-gray-500">Objetos del Estok que esperan decisión: Vender, Conservar o Tirar</p>
      </div>
      <a
        href="/objetos"
        class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-base"
      >
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Volver a Objetos
      </a>
    </div>

    <!-- ============================================================== -->
    <!-- SECCIÓN 1 · VOTACIONES PENDIENTES DEL ESTOK                     -->
    <!-- Se abren solas cuando un objeto tiene Dueño y Beneficiario      -->
    <!-- vacío: todo el Estok vota el destino del objeto.                -->
    <!-- ============================================================== -->
    <VotacionesPendientes />

    <!-- ============================================================== -->
    <!-- SECCIÓN 2 · OBJETOS PENDIENTES DE DECISIÓN                      -->
    <!-- Grilla simétrica: foto, título, ubicación actual y botonera     -->
    <!-- in-place Vender / Conservar / Tirar por tarjeta.                -->
    <!-- ============================================================== -->
    <section class="mt-8">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <h2 class="text-lg font-semibold text-gray-900">🧭 Objetos pendientes de decisión</h2>
        <span id="pendientesCount"
          class="hidden px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 text-xs font-bold">0</span>
        <button id="btnRefrescarPendientes" type="button"
          class="ml-auto inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 text-gray-700 text-xs font-semibold rounded-lg hover:bg-gray-200 transition-base">
          ↻ Actualizar
        </button>
      </div>

      <div id="pendientesAviso" class="hidden"></div>

      <LoadingState mensaje="Cargando objetos pendientes..." />
      <ErrorState mensaje="Error al cargar los objetos pendientes." />
      <EmptyState
        titulo="No hay objetos pendientes de decisión"
        descripcion="Acá se listan los objetos del Estok activo que todavía no tienen decisión. Salen de la lista cuando el Estok los vende, los conserva o los descarta."
        icono="✅"
      />

      <div id="pendientesGrid" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"></div>
    </section>
  </div>

  <!-- Modal de publicación (Mercado Libre / Facebook Marketplace) -->
  <PublicarObjetoModal />

  <script>
    import { iniciarDecisionesPendientes } from '../../lib/decisionesPendientes';
    import { iniciarModalPublicar } from '../../lib/publicarObjeto';

    iniciarDecisionesPendientes();
    iniciarModalPublicar();
  </script>

  <style is:global>
    /* Salida suave de la tarjeta descartada (🗑️ Tirar). El HTML de las tarjetas
       se inyecta desde src/lib/decisionesPendientes.ts, por eso la regla es
       global (no aplica el scoping de estilos de Astro). */
    .decision-card {
      transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .decision-card-saliendo {
      opacity: 0;
      transform: scale(0.94) translateY(-6px);
      pointer-events: none;
    }
  </style>
</BaseLayout>
