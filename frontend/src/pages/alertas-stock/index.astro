---
// =============================================================================
// PÁGINA DE DECISIONES (owner_action)
// Muestra objetos agrupados por decisión del dueño: Vender, Conservar, Tirar
// =============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthGuard from '../../components/AuthGuard.astro';
import LoadingState from '../../components/LoadingState.astro';
import ErrorState from '../../components/ErrorState.astro';
import EmptyState from '../../components/EmptyState.astro';

export const prerender = false;
---

<AuthGuard />

<BaseLayout title="Estok - Decisiones de Objetos | Inventario">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Encabezado -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Decisiones de Objetos</h1>
        <p class="mt-1 text-gray-500">Objetos con decisión del dueño: Vender, Conservar o Tirar</p>
      </div>
      <a
        href="/objetos"
        class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-base"
      >
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Volver a Objetos
      </a>
    </div>

    <LoadingState mensaje="Cargando decisiones..." />
    <ErrorState mensaje="Error al cargar decisiones." />
    <EmptyState
      titulo="No hay decisiones tomadas"
      descripcion="Acá aparecerán los objetos cuando el dueño original decida si vender, conservar o tirar cada objeto."
      icono="📋"
    />

    <!-- KPI Cards de resumen -->
    <div id="resumenCards" class="hidden grid grid-cols-3 gap-4 mb-6">
      <div id="cardVender" class="bg-red-50 border border-red-200 rounded-xl p-4 text-center cursor-pointer hover:shadow-md transition-base">
        <div class="text-2xl mb-1">💰</div>
        <div id="countVender" class="text-2xl font-bold text-red-700">0</div>
        <div class="text-xs text-red-500 mt-1">Para Vender</div>
        <div id="valorVender" class="text-xs font-medium text-red-600 mt-0.5">—</div>
      </div>
      <div id="cardConservar" class="bg-green-50 border border-green-200 rounded-xl p-4 text-center cursor-pointer hover:shadow-md transition-base">
        <div class="text-2xl mb-1">📦</div>
        <div id="countConservar" class="text-2xl font-bold text-green-700">0</div>
        <div class="text-xs text-green-500 mt-1">Conservar</div>
        <div id="valorConservar" class="text-xs font-medium text-green-600 mt-0.5">—</div>
      </div>
      <div id="cardTirar" class="bg-gray-100 border border-gray-300 rounded-xl p-4 text-center cursor-pointer hover:shadow-md transition-base">
        <div class="text-2xl mb-1">🗑️</div>
        <div id="countTirar" class="text-2xl font-bold text-gray-700">0</div>
        <div class="text-xs text-gray-500 mt-1">Tirar / Desechar</div>
        <div id="valorTirar" class="text-xs font-medium text-gray-600 mt-0.5">—</div>
      </div>
    </div>

    <!-- Contenido agrupado por decisión -->
    <div id="decisionesContainer" class="hidden space-y-6">
      <!-- Se llena dinámicamente -->
    </div>
  </div>
</BaseLayout>

<script>
  // ===========================================================================
  // DECISIONES DE OBJETOS (owner_action)
  // ===========================================================================

  import { getAuthHeaders, API_BASE_URL } from '../../services/auth';

  const loadingState = document.getElementById('loadingState')!;
  const emptyState = document.getElementById('emptyState')!;
  const errorState = document.getElementById('errorState')!;
  const errorMessage = document.getElementById('errorMessage')!;
  const retryBtn = document.getElementById('retryBtn')!;
  const resumenCards = document.getElementById('resumenCards')!;
  const decisionesContainer = document.getElementById('decisionesContainer')!;

  // Elementos KPI
  const cardVender = document.getElementById('cardVender')!;
  const cardConservar = document.getElementById('cardConservar')!;
  const cardTirar = document.getElementById('cardTirar')!;

  const countVender = document.getElementById('countVender')!;
  const countConservar = document.getElementById('countConservar')!;
  const countTirar = document.getElementById('countTirar')!;
  const valorVender = document.getElementById('valorVender')!;
  const valorConservar = document.getElementById('valorConservar')!;
  const valorTirar = document.getElementById('valorTirar')!;

  function showLoading() {
    loadingState.classList.remove('hidden');
    emptyState.classList.add('hidden');
    errorState.classList.add('hidden');
    resumenCards.classList.add('hidden');
    decisionesContainer.classList.add('hidden');
  }

  function showError(msg: string) {
    loadingState.classList.add('hidden');
    emptyState.classList.add('hidden');
    errorState.classList.remove('hidden');
    resumenCards.classList.add('hidden');
    decisionesContainer.classList.add('hidden');
    errorMessage.textContent = msg;
  }

  function showEmpty() {
    loadingState.classList.add('hidden');
    emptyState.classList.remove('hidden');
    errorState.classList.add('hidden');
    resumenCards.classList.add('hidden');
    decisionesContainer.classList.add('hidden');
  }

  const TIPO_ICONOS: Record<string, string> = {
    libro: '📚',
    tecnologia: '💻',
    mueble: '🖼️',
    ropa: '👕',
    objeto: '📦',
  };

  const ESTADO_COLORS: Record<string, string> = {
    excelente: 'bg-green-100 text-green-700',
    bueno: 'bg-blue-100 text-blue-700',
    regular: 'bg-yellow-100 text-yellow-700',
    malo: 'bg-orange-100 text-orange-700',
    muy_malo: 'bg-red-100 text-red-700',
  };

  function formatUSD(val: string | null): string {
    if (!val) return '—';
    const num = parseFloat(val);
    return `$${num.toLocaleString('es-AR', { minimumFractionDigits: 2 })}`;
  }

  function renderObjetoCard(obj: any): string {
    const icono = TIPO_ICONOS[obj.tipo] || '📦';
    const estadoColor = ESTADO_COLORS[obj.estado_conservacion] || 'bg-gray-100 text-gray-700';

    return `
      <div class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:bg-gray-50 transition-base">
        <span class="text-xl flex-shrink-0">${icono}</span>
        <div class="flex-1 min-w-0">
          <a href="/objetos/${obj.id}" class="text-sm font-medium text-blue-700 hover:text-blue-900 hover:underline truncate block">
            ${obj.nombre}
          </a>
          <div class="flex items-center gap-2 mt-0.5 flex-wrap">
            ${obj.ubicacion ? `<span class="text-xs text-gray-400">📍 ${obj.ubicacion}</span>` : ''}
            ${obj.categoria ? `<span class="text-xs text-gray-400">🏷️ ${obj.categoria}</span>` : ''}
            <span class="inline-block px-1.5 py-0.5 rounded-full text-xs font-medium ${estadoColor}">
              ${obj.estado_conservacion}
            </span>
          </div>
        </div>
        <div class="text-right flex-shrink-0">
          <div class="text-sm font-semibold text-gray-800">${formatUSD(obj.valor_estimado)}</div>
          ${obj.dueno_original_nombre ? `<div class="text-xs text-gray-400">👤 ${obj.dueno_original_nombre}</div>` : ''}
        </div>
      </div>
    `;
  }

  function renderGrupo(label: string, icono: string, colorClass: string, objetos: any[]): string {
    if (objetos.length === 0) {
      return `
        <div class="bg-gray-50 rounded-xl border border-gray-200 p-6 text-center">
          <p class="text-gray-400 text-sm">No hay objetos en esta categoría</p>
        </div>
      `;
    }

    const valorTotal = objetos.reduce((sum, o) => sum + (parseFloat(o.valor_estimado) || 0), 0);

    return `
      <div>
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
            <span>${icono}</span>
            <span>${label}</span>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-sm font-semibold ${colorClass}">
              ${objetos.length}
            </span>
          </h2>
          <span class="text-sm font-medium text-gray-600">
            Valor total: ${formatUSD(valorTotal.toFixed(2))}
          </span>
        </div>
        <div class="space-y-2">
          ${objetos.map(renderObjetoCard).join('')}
        </div>
      </div>
    `;
  }

  function renderDecisiones(data: any) {
    const grupos = data.grupos || { vender: [], conservar: [], tirar: [] };
    const resumen = data.resumen || {};
    const totalObjetos = (grupos.vender.length + grupos.conservar.length + grupos.tirar.length);

    if (totalObjetos === 0) {
      showEmpty();
      return;
    }

    loadingState.classList.add('hidden');
    emptyState.classList.add('hidden');
    errorState.classList.add('hidden');
    resumenCards.classList.remove('hidden');
    decisionesContainer.classList.remove('hidden');

    // Actualizar KPIs
    const rVender = resumen.vender || { count: 0, valor_total: 0 };
    const rConservar = resumen.conservar || { count: 0, valor_total: 0 };
    const rTirar = resumen.tirar || { count: 0, valor_total: 0 };

    countVender.textContent = String(rVender.count);
    countConservar.textContent = String(rConservar.count);
    countTirar.textContent = String(rTirar.count);
    valorVender.textContent = formatUSD(String(rVender.valor_total));
    valorConservar.textContent = formatUSD(String(rConservar.valor_total));
    valorTirar.textContent = formatUSD(String(rTirar.valor_total));

    // Render grupos
    decisionesContainer.innerHTML = `
      ${renderGrupo('Para Vender', '💰', 'bg-red-100 text-red-700', grupos.vender)}
      ${renderGrupo('Conservar', '📦', 'bg-green-100 text-green-700', grupos.conservar)}
      ${renderGrupo('Tirar / Desechar', '🗑️', 'bg-gray-200 text-gray-700', grupos.tirar)}
    `;

    // Scroll al tocar una KPI card
    cardVender.onclick = () => {
      document.getElementById('grupo-vender')?.scrollIntoView({ behavior: 'smooth' });
    };
    cardConservar.onclick = () => {
      document.getElementById('grupo-conservar')?.scrollIntoView({ behavior: 'smooth' });
    };
    cardTirar.onclick = () => {
      document.getElementById('grupo-tirar')?.scrollIntoView({ behavior: 'smooth' });
    };
  }

  async function cargarDecisiones() {
    showLoading();

    try {
      const response = await fetch(`${API_BASE_URL}/objetos/owner_actions/`, {
        headers: getAuthHeaders(),
      });

      if (response.status === 401) {
        window.location.href = '/login';
        return;
      }

      if (!response.ok) {
        showError(`Error del servidor (${response.status})`);
        return;
      }

      const data = await response.json();
      renderDecisiones(data);
    } catch (err) {
      console.error('Error al cargar decisiones:', err);
      showError('Error de conexión. Verifica que el servidor esté corriendo.');
    }
  }

  // Retry
  retryBtn?.addEventListener('click', () => cargarDecisiones());

  // Cargar al inicio
  cargarDecisiones();
</script>
</write_to_file>
<task_progress>
- [x] Backend: Agregar endpoint owner_actions (GET /api/objetos/owner_actions/)
- [ ] Frontend: Reescribir alertas-stock como panel de decisiones (Vender/Conservar/Tirar)
- [ ] Verificar con python manage.py check
- [ ] Commit y push
</task_progress>
</write_to_file>