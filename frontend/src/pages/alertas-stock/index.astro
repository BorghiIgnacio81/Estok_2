---
// =============================================================================
// PÁGINA DE DECISIONES (/alertas-stock) · CUATRO SECCIONES COLAPSABLES
// -----------------------------------------------------------------------------
// El tablero se lee de ARRIBA hacia ABAJO, priorizando lo que espera al usuario:
//
//   SECCIÓN 1 · ✅ Decisiones tomadas (En proceso)
//     Objetos con decisión tomada cuyo ciclo todavía no terminó:
//       💰 Vender      → «Marcar como Vendido»: registra el ingreso financiero
//                        (usuario_vendedor) y archiva el objeto.
//       🗑️ Tirar/Donar → «Marcar como Tirado/Donado»: sale del Estok activo.
//       📦 Conservar   → resolución instantánea: el objeto queda protegido.
//     → lib/decisionesGrupos.ts + lib/decisionesCierre.ts
//     Endpoint: GET /api/objetos/panel_decisiones/
//
//   SECCIÓN 2 · 🏷️ Objetos con Decisión de Venta / Listos para Publicar
//     → lib/ventasDestacadas.ts (GET /api/objetos/en_venta/)
//
//   SECCIÓN 3 · 🗳️ Votaciones pendientes del Estok (+ 🚨 Alerta Rojo)
//     → components/VotacionesPendientes.astro + lib/descarteGracia.ts
//
//   SECCIÓN 4 · ⏳ Objetos pendientes de decisión (DOS sub-acordeones)
//     a) Pendientes de MI decisión           (objeto.dueno_id === usuario)
//     b) Pendientes de la decisión de OTROS  (incluye «Avisar al propietario»)
//     → lib/decisionesPendientes.ts (GET /api/objetos/pendientes_decision/)
//
// Cada sección es un acordeón (components/decisiones/SeccionAcordeon.astro) con
// ícono, título, badge del total de ítems y flecha de colapsado/desplegado.
//
// Modales: publicación (Mercado Libre / Facebook), descarte con período de
// gracia y aviso al dueño. Auth 100% centralizada en services/auth.
// Esta página es sólo el host y el arranque (ningún archivo de UI supera 400
// líneas).
// =============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthGuard from '../../components/AuthGuard.astro';
import LoadingState from '../../components/LoadingState.astro';
import ErrorState from '../../components/ErrorState.astro';
import EmptyState from '../../components/EmptyState.astro';
import VotacionesPendientes from '../../components/VotacionesPendientes.astro';
import PublicarObjetoModal from '../../components/PublicarObjetoModal.astro';
import ModalDescarteGracia from '../../components/ModalDescarteGracia.astro';
import ModalNotificarDueno from '../../components/ModalNotificarDueno.astro';
// Sección colapsable (acordeón) con ícono + título + badge + flecha: la misma
// barra para las cuatro secciones y para los dos sub-acordeones de pendientes.
import SeccionAcordeon from '../../components/decisiones/SeccionAcordeon.astro';
// Estilos de la MINI-GUÍA ANALÍTICA (.mini-anidado*) que dibujan las tarjetas:
// único archivo compartido con Almacenamiento y Objetos, no se duplican reglas.
import '../../styles/almacenamiento-portales.css';

export const prerender = false;
---

<AuthGuard />

<BaseLayout title="Estok - Decisiones de Objetos | Inventario">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Encabezado -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Decisiones de Objetos</h1>
        <p class="mt-1 text-gray-500">
          Objetos del Estok que esperan decisión: Vender, Conservar o Tirar.
          Desplegá cada sección para ver su contenido.
        </p>
      </div>
      <a
        href="/objetos"
        class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-base"
      >
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Volver a Objetos
      </a>
    </div>

    <!-- ============================================================== -->
    <!-- SECCIÓN 1 · ✅ DECISIONES TOMADAS (EN PROCESO)                  -->
    <!-- Objetos con decisión tomada cuyo ciclo todavía no terminó:      -->
    <!--   💰 Vender      → «Marcar como Vendido» (ingreso financiero)   -->
    <!--   🗑️ Tirar/Donar → «Marcar como Tirado/Donado» (baja lógica)    -->
    <!--   📦 Conservar   → resolución instantánea (protegido)           -->
    <!-- Lo alimenta GET /api/objetos/panel_decisiones/                  -->
    <!-- (lib/decisionesGrupos.ts) y los cierres los resuelve            -->
    <!-- lib/decisionesCierre.ts.                                        -->
    <!-- ============================================================== -->
    <SeccionAcordeon
      id="seccionEnProceso"
      emoji="✅"
      titulo="Decisiones tomadas (En proceso)"
      badgeId="decisionesEnProcesoCount"
      detalleId="decisionesEnProcesoDetalle"
      detalle="Los objetos con decisión permanecen acá hasta cerrar su ciclo."
      tono="emerald"
      abierto={true}
    >
      <p id="panelDecisionesAviso" class="hidden"></p>
      <p id="panelDecisionesCargando" class="text-sm text-gray-500">Cargando decisiones tomadas...</p>
      <div id="panelDecisionesError" class="hidden mb-4 px-4 py-2 rounded-lg bg-red-50 text-red-700 text-sm">
        ⚠️ No se pudo cargar el tablero de decisiones tomadas.
      </div>

      <div id="panelDecisiones">
        <section id="seccionDecisionesTomadas" class="hidden">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <button id="btnRefrescarPanel" type="button" data-acordeon-accion
              class="inline-flex items-center gap-1 px-3 py-1.5 bg-white border border-gray-200 text-gray-700 text-xs font-semibold rounded-lg hover:bg-gray-100 transition-base">
              ↻ Actualizar
            </button>
          </div>

          <!-- 💰 Con decisión de Vender (espera «Marcar como Vendido») -->
          <div class="mb-10">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <h2 class="text-base font-semibold text-gray-900">💰 Con decisión de Vender</h2>
              <span id="venderCount"
                class="hidden px-2 py-0.5 rounded-full bg-green-100 text-green-800 text-xs font-bold">0</span>
            </div>
            <p class="text-xs text-gray-500 mb-3">
              Publicá el objeto y, cuando la venta se concrete, confirmá con
              <strong>«✅ Marcar como Vendido»</strong>: el objeto sale del Estok activo y
              el ingreso queda registrado con el usuario que lo vendió.
            </p>

            <div id="venderSinPublicarBloque" class="mb-4">
              <h3 class="text-sm font-semibold text-gray-600 mb-2">📢 Sin publicar</h3>
              <div id="venderSinPublicarGrid"
                class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"></div>
            </div>

            <div id="venderPublicadosBloque">
              <h3 class="text-sm font-semibold text-gray-600 mb-2">🔗 Ya publicados</h3>
              <div id="venderPublicadosGrid"
                class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"></div>
            </div>
          </div>

          <!-- 🗑️ Con decisión de Tirar / Donar -->
          <div class="mb-10">
            <div class="flex flex-wrap items-center gap-2 mb-1">
              <h2 class="text-base font-semibold text-gray-900">🗑️ Con decisión de Tirar / Donar</h2>
              <span id="tirarCount"
                class="hidden px-2 py-0.5 rounded-full bg-red-100 text-red-800 text-xs font-bold">0</span>
            </div>
            <p class="text-xs text-gray-500 mb-2">
              En espera de la ejecución física o del fin del tiempo de reclamo. Al confirmar
              <strong>«🗑️ Marcar como Tirado/Donado»</strong> el objeto abandona el Estok activo.
            </p>
            <div id="tirarGrid"
              class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"></div>
            <p id="tirarVacio" class="hidden text-sm text-gray-400">
              No hay objetos esperando el descarte físico.
            </p>
          </div>

          <!-- 📦 Con decisión de Conservar (resolución instantánea) -->
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-1">
              <h2 class="text-base font-semibold text-gray-900">📦 Con decisión de Conservar</h2>
              <span id="conservarCount"
                class="hidden px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 text-xs font-bold">0</span>
            </div>
            <p class="text-xs text-gray-500 mb-2">
              Resolución instantánea: el objeto ya quedó protegido en el Estok (incluye los
              reclamados para mudanza antes de que venciera el descarte).
            </p>
            <div id="conservarGrid"
              class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"></div>
            <p id="conservarVacio" class="hidden text-sm text-gray-400">
              Todavía no hay objetos protegidos.
            </p>
          </div>
        </section>
      </div>
    </SeccionAcordeon>

    <!-- ============================================================== -->
    <!-- SECCIÓN 2 · 🏷️ OBJETOS CON DECISIÓN DE VENTA / LISTOS PARA     -->
    <!-- PUBLICAR: acceso rápido a TODO objeto marcado para vender      -->
    <!-- (publicado o no) con «Publicar / Generar Anuncio» (Mercado      -->
    <!-- Libre / Facebook) y «Ver publicación».                          -->
    <!-- Lo alimenta GET /api/objetos/en_venta/ (lib/ventasDestacadas).  -->
    <!-- ============================================================== -->
    <SeccionAcordeon
      id="ventaDestacada"
      emoji="🏷️"
      titulo="Objetos con Decisión de Venta / Listos para Publicar"
      badgeId="ventaDestacadaCount"
      detalleId="ventaDestacadaResumen"
      detalle="Listos para publicar en Mercado Libre o canales comerciales."
      tono="emerald"
      abierto={true}
    >
      <span slot="extra" class="ml-1">
        <button id="btnRefrescarVenta" type="button" data-acordeon-accion
          class="inline-flex items-center gap-1 px-3 py-1.5 bg-white border border-emerald-200 text-emerald-800 text-xs font-semibold rounded-lg hover:bg-emerald-100 transition-base">
          ↻ Actualizar
        </button>
      </span>

      <p class="text-xs text-emerald-900/70 mb-3">
        Los <strong>listos para publicar</strong> aparecen primero con el botón directo a
        <strong>Publicar / Generar Anuncio</strong>; los ya publicados muestran su link.
      </p>
      <p id="ventaDestacadaLoading" class="text-sm text-gray-600">Cargando objetos marcados para vender...</p>
      <p id="ventaDestacadaError"
        class="hidden mb-3 px-4 py-2 rounded-lg bg-red-50 text-red-700 text-sm">
        ⚠️ No se pudieron cargar los objetos en venta.
      </p>
      <p id="ventaDestacadaVacio"
        class="hidden text-sm text-gray-400 bg-white border border-dashed border-gray-300 rounded-xl px-4 py-6 text-center">
        No hay objetos marcados para vender en este momento.
      </p>
      <div id="ventaDestacadaGrid"
        class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"></div>
    </SeccionAcordeon>

    <!-- ============================================================== -->
    <!-- SECCIÓN 3 · 🗳️ VOTACIONES PENDIENTES DEL ESTOK                 -->
    <!-- Se abren solas cuando un objeto tiene Dueño y Beneficiario      -->
    <!-- vacío (todo el Estok vota el destino). En el encabezado vive    -->
    <!-- el 🚨 ALERTA ROJO con el contador regresivo de los descartes en -->
    <!-- período de gracia (reclamar → Conservar / Mudar).               -->
    <!-- ============================================================== -->
    <SeccionAcordeon
      id="seccionVotaciones"
      emoji="🗳️"
      titulo="Votaciones pendientes del Estok"
      badgeId="votacionesCount"
      detalle="Encuestas familiares abiertas para decidir el destino de los objetos."
      tono="orange"
      abierto={true}
    >
      <!-- ALERTA ROJO · descartes con período de gracia vigente (lo llena
           lib/descarteGracia.ts con el contador Días:Horas:Minutos:Segundos en
           vivo, refrescado cada 1000 ms). -->
      <span slot="extra" id="alertaDescarte" class="hidden ml-auto flex items-center gap-0 text-sm"></span>

      <VotacionesPendientes />
    </SeccionAcordeon>

    <!-- ============================================================== -->
    <!-- SECCIÓN 4 · ⏳ OBJETOS PENDIENTES DE DECISIÓN                   -->
    <!-- Dos sub-acordeones con la REGLA DE PROPIEDAD como fuente única: -->
    <!--   a) Pendientes de MI decisión      (dueno_id === usuario)      -->
    <!--   b) Pendientes de la decisión de OTROS (incluye «Avisar al     -->
    <!--      propietario» y los objetos sin dueño, que se votan)        -->
    <!-- Grilla: foto, título, ubicación actual y botonera in-place.     -->
    <!-- ============================================================== -->
    <SeccionAcordeon
      id="seccionPendientes"
      emoji="⏳"
      titulo="Objetos pendientes de decisión"
      badgeId="pendientesCount"
      detalle="Objetos sin decisión tomada y sin votación abierta."
      tono="blue"
      abierto={true}
    >
      <span slot="extra" class="ml-1">
        <button id="btnRefrescarPendientes" type="button" data-acordeon-accion
          class="inline-flex items-center gap-1 px-3 py-1.5 bg-white border border-blue-200 text-blue-800 text-xs font-semibold rounded-lg hover:bg-blue-100 transition-base">
          ↻ Actualizar
        </button>
      </span>

      <div id="pendientesAviso" class="hidden"></div>

      <LoadingState mensaje="Cargando objetos pendientes..." />
      <ErrorState mensaje="Error al cargar los objetos pendientes." />
      <EmptyState
        titulo="No hay objetos pendientes de decisión"
        descripcion="Acá se listan los objetos del Estok activo que todavía no tienen decisión. Salen de la lista cuando el Estok los vende, los conserva o los descarta."
        icono="✅"
      />

      <!-- a) PENDIENTES DE MI DECISIÓN -->
      <SeccionAcordeon
        id="subseccionPendientesPropios"
        nivel="secundario"
        emoji="🙋"
        titulo="Pendientes de MI decisión"
        badgeId="pendientesPropiosCount"
        detalle="Objetos que te pertenecen y todavía no tienen decisión."
        tono="blue"
        abierto={true}
      >
        <p id="pendientesPropiosVacio" class="hidden text-sm text-gray-400">
          No tenés objetos pendientes de tu decisión.
        </p>
        <div id="pendientesPropiosGrid"
          class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"></div>
      </SeccionAcordeon>

      <!-- b) PENDIENTES DE LA DECISIÓN DE OTROS -->
      <SeccionAcordeon
        id="subseccionPendientesAjenos"
        nivel="secundario"
        emoji="👥"
        titulo="Pendientes de la decisión de OTROS"
        badgeId="pendientesAjenosCount"
        detalle="Objetos de otros miembros del Estok: podés avisarles para que decidan."
        tono="amber"
        abierto={true}
      >
        <p id="pendientesAjenosVacio" class="hidden text-sm text-gray-400">
          No hay decisiones pendientes de otros miembros.
        </p>
        <div id="pendientesAjenosGrid"
          class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"></div>
      </SeccionAcordeon>
    </SeccionAcordeon>
  </div>

  <!-- Modal de publicación (Mercado Libre / Facebook Marketplace) -->
  <PublicarObjetoModal />
  <!-- Modales del descarte: tiempo de gracia + reclamo del Alerta Rojo -->
  <ModalDescarteGracia />
  <!-- Modal del puente 403: invitar por email al dueño del objeto ajeno -->
  <ModalNotificarDueno />

  <script>
    import { iniciarDecisionesPendientes } from '../../lib/decisionesPendientes';
    import { iniciarModalPublicar } from '../../lib/publicarObjeto';
    import { iniciarPanelDecisiones } from '../../lib/decisionesGrupos';
    import { iniciarVentasDestacadas } from '../../lib/ventasDestacadas';
    import { iniciarModalesDescarte } from '../../lib/descarteModales';
    import { iniciarModalNotificarDueno } from '../../lib/notificacionDueno';
    // ESTADO REAL DE LAS PUBLICACIONES: verifica en Mercado Libre (active /
    // paused / closed) al abrir la pestaña y refresca las tarjetas si algo
    // cambió (publicación pausada, finalizada o eliminada en ML).
    import { iniciarSincronizacionPublicaciones } from '../../lib/sincronizacionPublicaciones';
    // Clic en el CUERPO/TÍTULO de cualquier tarjeta → ficha interna del objeto.
    // Los botones (publicar, «Ver publicación», despacho, cierre, reclamo…) y la
    // ruta geográfica conservan su propia acción y NO navegan.
    import { initNavegacionTarjetasDecisiones } from '../../lib/decisionesTarjeta';
    // ACCIÓN RÁPIDA de las tarjetas: «⏸ Pausar publicación» / «▶️ Reactivar
    // publicación» → PUT /items/{id} de Mercado Libre desde el backend.
    import { iniciarAccionesEstadoPublicacion } from '../../lib/accionesPublicacionML';

    initNavegacionTarjetasDecisiones();
    iniciarAccionesEstadoPublicacion();
    // Sección 1 · ✅ Decisiones tomadas (En proceso) + cierre del ciclo.
    iniciarPanelDecisiones();
    // Sección 2 · 🏷️ Listos para publicar.
    iniciarVentasDestacadas();
    // Sección 4 · ⏳ Pendientes (dos sub-acordeones por propiedad).
    iniciarDecisionesPendientes();
    iniciarModalPublicar();
    iniciarModalesDescarte();
    iniciarModalNotificarDueno();
    // Segunda pasada (no bloquea el render): si el estado real de alguna
    // publicación cambió en Mercado Libre, las islas se recargan solas.
    iniciarSincronizacionPublicaciones();
  </script>

  <style is:global>
    /* Salida suave de la tarjeta descartada (🗑️ Tirar). El HTML de las tarjetas
       se inyecta desde src/lib/decisionesPendientes.ts, por eso la regla es
       global (no aplica el scoping de estilos de Astro). */
    .decision-card {
      transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .decision-card-saliendo {
      opacity: 0;
      transform: scale(0.94) translateY(-6px);
      pointer-events: none;
    }
  </style>
</BaseLayout>
