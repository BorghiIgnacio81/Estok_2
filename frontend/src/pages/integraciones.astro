---
// =============================================================================
// PÁGINA DE INTEGRACIONES
// Gestionar conexiones a plataformas externas (Mercado Libre, etc.)
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import AuthGuard from '../components/AuthGuard.astro';

export const prerender = false;
---

<AuthGuard />

<BaseLayout title="Estok - Integraciones | Inventario">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Integraciones</h1>
      <p class="mt-1 text-gray-500">Conectá tus cuentas para publicar en marketplaces</p>
    </div>

    <!-- Mercado Libre -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 bg-yellow-100 rounded-2xl flex items-center justify-center flex-shrink-0 text-3xl">
            🛒
          </div>
          <div>
            <h2 class="text-lg font-bold text-gray-900">Mercado Libre</h2>
            <p class="text-sm text-gray-500">Publicá tus objetos directamente en Mercado Libre</p>
            <div id="mlStatusBadge" class="mt-1">
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">
                Verificando...
              </span>
            </div>
          </div>
        </div>
        <div>
          <button id="btnConectarML" class="hidden px-4 py-2 text-sm font-semibold text-white bg-blue-700 hover:bg-blue-800 rounded-lg transition-base shadow-sm">
            🔗 Conectar cuenta
          </button>
          <button id="btnDesconectarML" class="hidden px-4 py-2 text-sm font-semibold text-red-600 bg-red-50 hover:bg-red-100 rounded-lg transition-base">
            Desconectar
          </button>
        </div>
      </div>
      <div id="mlInfo" class="hidden mt-4 p-4 bg-green-50 border border-green-200 rounded-lg">
        <p class="text-sm text-green-800">
          ✅ Conectado como <strong id="mlUserName">—</strong>
          <span class="text-green-600 ml-1">(ML ID: <span id="mlUserId">—</span>)</span>
        </p>
      </div>
    </div>

    <!-- Facebook Marketplace -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 bg-blue-100 rounded-2xl flex items-center justify-center flex-shrink-0 text-3xl">
          📘
        </div>
        <div>
          <h2 class="text-lg font-bold text-gray-900">Facebook Marketplace</h2>
          <p class="text-sm text-gray-500">Facebook no permite publicar automáticamente vía API. Podés copiar el anuncio generado y pegarlo manualmente.</p>
          <span class="inline-flex items-center mt-1 px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">
            Solo copia manual
          </span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { API_BASE_URL } from '../services/auth';

  const btnConectarML = document.getElementById('btnConectarML')!;
  const btnDesconectarML = document.getElementById('btnDesconectarML')!;
  const mlStatusBadge = document.getElementById('mlStatusBadge')!;
  const mlInfo = document.getElementById('mlInfo')!;
  const mlUserName = document.getElementById('mlUserName')!;
  const mlUserId = document.getElementById('mlUserId')!;

  async function cargarEstadoML() {
    try {
      const token = localStorage.getItem('estok_access_token');
      const resp = await fetch(`${API_BASE_URL}/mercadolibre/status/`, {
        headers: { 'Authorization': `Bearer ${token}` },
      });

      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);

      const data = await resp.json();

      if (data.conectado) {
        mlStatusBadge.innerHTML = '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">✅ Conectado</span>';
        btnConectarML.classList.add('hidden');
        btnDesconectarML.classList.remove('hidden');
        mlInfo.classList.remove('hidden');
        if (data.nombre) {
          mlUserName.textContent = data.nombre + (data.apellido ? ` ${data.apellido}` : '');
          if (data.email) mlUserName.textContent += ` (${data.email})`;
        } else if (data.nickname) {
          mlUserName.textContent = data.nickname;
        }
        if (data.ml_user_id) mlUserId.textContent = data.ml_user_id;
      } else {
        mlStatusBadge.innerHTML = '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">⚠️ No conectado</span>';
        btnConectarML.classList.remove('hidden');
        btnDesconectarML.classList.add('hidden');
        mlInfo.classList.add('hidden');
      }
    } catch (err) {
      console.error('Error al cargar estado ML:', err);
      mlStatusBadge.innerHTML = '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700">Error al verificar</span>';
    }
  }

  btnConectarML.addEventListener('click', async () => {
    try {
      const token = localStorage.getItem('estok_access_token');
      const resp = await fetch(`${API_BASE_URL}/mercadolibre/auth-url/`, {
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (resp.ok) {
        const data = await resp.json();
        // Abrir en misma pestaña para que el callback pueda volver
        window.location.href = data.auth_url;
      }
    } catch (err) {
      alert('Error al obtener URL de autorización');
    }
  });

  btnDesconectarML.addEventListener('click', async () => {
    if (!confirm('¿Desconectar tu cuenta de Mercado Libre?')) return;

    try {
      const token = localStorage.getItem('estok_access_token');
      const resp = await fetch(`${API_BASE_URL}/mercadolibre/disconnect/`, {
        method: 'DELETE',
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (resp.ok) {
        cargarEstadoML();
      }
    } catch (err) {
      alert('Error al desconectar');
    }
  });

  cargarEstadoML();

  // Escuchar notificación postMessage desde el popup/callback de OAuth
  window.addEventListener('message', (event) => {
    if (event.data && event.data.type === 'ml_connected' && event.data.success) {
      cargarEstadoML();
    }
  });
</script>
</write_to_file>
<task_progress>
- [x] Crear página /integraciones con estado de conexión ML
- [ ] Mejorar modal de publicación: verificar conexión antes del formulario
- [ ] Mejorar callback OAuth con botón "Volver a Estok"
- [ ] Agregar endpoint ML status con info del usuario
- [ ] Conectar navegación a la nueva página
- [ ] Verificar + commit + push
</task_progress>
</write_to_file>