---
// =============================================================================
// PÁGINA MI PERFIL - Datos base + Cambio de contraseña
// Consume PUT /api/usuarios/perfil/ (cualquier usuario autenticado)
// =============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthGuard from '../../components/AuthGuard.astro';
---

<AuthGuard />

<BaseLayout title="Mi Perfil - Estok">
  <div class="flex flex-col gap-8 w-full max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- ================================================================ -->
    <!-- CARTEL DE CLAVE TEMPORAL (flujo "Olvidó su contraseña") -->
    <!-- Se muestra cuando el backend reporta tiene_clave_temporal=true. -->
    <!-- ================================================================ -->
    <div id="claveTemporalBanner" class="hidden mb-6 bg-amber-50 border border-amber-300 text-amber-800 rounded-xl p-4 flex items-start gap-3">
      <span class="text-xl leading-none">⚠️</span>
      <div>
        <p class="font-semibold text-sm">Estás usando una contraseña temporal</p>
        <p class="text-xs mt-1">
          Por seguridad, definí una contraseña nueva abajo antes de continuar.
          Al actualizarla, se desbloqueará el acceso al Dashboard general.
        </p>
      </div>
    </div>

    <!-- Encabezado -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Mi Perfil</h1>
      <p class="mt-2 text-gray-500">Administrá tus datos personales y credenciales de acceso</p>
    </div>

    <!-- ================================================================ -->
    <!-- DATOS BASE -->
    <!-- ================================================================ -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-1">👤 Datos Base</h2>
      <p class="text-xs text-gray-400 mb-5">Usuario, correo electrónico y nombre de la cuenta</p>

      <form id="perfilForm" class="space-y-4" autocomplete="on">
        <div>
          <label for="username" class="block text-sm font-medium text-gray-700 mb-1">Nombre de usuario <span class="text-red-500">*</span></label>
          <input id="username" name="username" type="text" required autocomplete="username"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Correo electrónico <span class="text-red-500">*</span></label>
          <input id="email" name="email" type="email" required autocomplete="email"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="first_name" class="block text-sm font-medium text-gray-700 mb-1">Nombre</label>
            <input id="first_name" name="first_name" type="text" autocomplete="given-name"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
          </div>
          <div>
            <label for="last_name" class="block text-sm font-medium text-gray-700 mb-1">Apellido</label>
            <input id="last_name" name="last_name" type="text" autocomplete="family-name"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
          </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button type="submit" id="guardarPerfilBtn"
            class="inline-flex items-center px-4 py-2 bg-blue-700 text-white text-sm font-medium rounded-lg hover:bg-blue-800 transition-base shadow-sm">
            <span id="guardarPerfilLabel">Guardar Datos</span>
          </button>
        </div>
      </form>
    </div>

    <!-- ================================================================ -->
    <!-- CAMBIAR CONTRASEÑA -->
    <!-- ================================================================ -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-1">🔑 Cambiar Contraseña</h2>
      <p class="text-xs text-gray-400 mb-5">Al cambiar tu clave se cerrará la sesión actual y deberás ingresar de nuevo con las nuevas credenciales</p>

      <form id="passwordForm" class="space-y-4" autocomplete="off">
        <div>
          <label for="password_actual" class="block text-sm font-medium text-gray-700 mb-1">Contraseña actual <span class="text-red-500">*</span></label>
          <input id="password_actual" name="password_actual" type="password" required autocomplete="current-password"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="password_nueva" class="block text-sm font-medium text-gray-700 mb-1">Nueva contraseña <span class="text-red-500">*</span></label>
            <input id="password_nueva" name="password_nueva" type="password" required minlength="8" autocomplete="new-password"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            <p class="mt-1 text-[11px] text-gray-400">Mínimo 8 caracteres</p>
          </div>
          <div>
            <label for="password_confirm" class="block text-sm font-medium text-gray-700 mb-1">Confirmar nueva contraseña <span class="text-red-500">*</span></label>
            <input id="password_confirm" name="password_confirm" type="password" required minlength="8" autocomplete="new-password"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
          </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button type="submit" id="cambiarPassBtn"
            class="inline-flex items-center px-4 py-2 bg-red-700 text-white text-sm font-medium rounded-lg hover:bg-red-800 transition-base shadow-sm">
            <span id="cambiarPassLabel">Cambiar Contraseña</span>
          </button>
        </div>
      </form>
    </div>

    <!-- ================================================================ -->
    <!-- INTEGRACIONES DEL ECOSISTEMA -->
    <!-- ================================================================ -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-1">🔌 Integraciones del Ecosistema</h2>
      <p class="text-xs text-gray-400 mb-5">Conectá tus cuentas para publicar en marketplaces</p>

      <!-- Mercado Libre -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-gray-100 pb-5 mb-5">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 bg-yellow-100 rounded-2xl flex items-center justify-center flex-shrink-0 text-3xl">🛒</div>
          <div>
            <h3 class="text-lg font-bold text-gray-900">Mercado Libre</h3>
            <p class="text-sm text-gray-500">Publicá tus objetos directamente en Mercado Libre</p>
            <div id="mlStatusBadge" class="mt-1">
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">Verificando...</span>
            </div>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
          <button id="btnConectarML" class="hidden px-4 py-2 text-sm font-semibold text-white bg-blue-700 hover:bg-blue-800 rounded-lg transition-base shadow-sm">
            🔗 Conectar cuenta
          </button>
          <button id="btnDesconectarML" class="hidden px-4 py-2 text-sm font-semibold text-red-600 bg-red-50 hover:bg-red-100 rounded-lg transition-base">
            Desconectar
          </button>
        </div>
      </div>
      <div id="mlInfo" class="hidden mb-5 p-4 bg-green-50 border border-green-200 rounded-lg">
        <p class="text-sm text-green-800">
          ✅ Conectado como <strong id="mlUserName">—</strong>
          <span class="text-green-600 ml-1">(ML ID: <span id="mlUserId">—</span>)</span>
        </p>
      </div>

      <!-- Facebook Marketplace -->
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 bg-blue-100 rounded-2xl flex items-center justify-center flex-shrink-0 text-3xl">📘</div>
        <div>
          <h3 class="text-lg font-bold text-gray-900">Facebook Marketplace</h3>
          <p class="text-sm text-gray-500">Facebook no permite publicar automáticamente vía API. Podés copiar el anuncio generado y pegarlo manualmente.</p>
          <span class="inline-flex items-center mt-1 px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">Solo copia manual</span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { getAuthHeaders, API_BASE_URL, getCachedUser, cacheUser, clearTokens } from '../../services/auth';
  import { apiPut } from '../../lib/api';
  import { obtenerEstadoML, obtenerAuthUrlML, desconectarCuentaML } from '../../services/mercadolibre';

  // ===========================================================================
  // Carga de datos actuales (GET /api/usuarios/me/)
  // ===========================================================================
  async function cargarPerfil(): Promise<void> {
    try {
      const response = await fetch(`${API_BASE_URL}/usuarios/me/`, { headers: getAuthHeaders() });
      if (response.status === 401) { window.location.href = '/login'; return; }
      if (!response.ok) return;
      const user = await response.json();
      (document.getElementById('username') as HTMLInputElement).value = user.username || '';
      (document.getElementById('email') as HTMLInputElement).value = user.email || '';
      (document.getElementById('first_name') as HTMLInputElement).value = user.first_name || '';
      (document.getElementById('last_name') as HTMLInputElement).value = user.last_name || '';

      // Si la cuenta entró con clave temporal (flujo "Olvidó su contraseña"),
      // se muestra el cartel de advertencia. El backend apaga el flag
      // automáticamente al procesar el cambio de contraseña (PUT /perfil/).
      if (user.tiene_clave_temporal) {
        document.getElementById('claveTemporalBanner')?.classList.remove('hidden');
      }
    } catch {
      // Silencioso: los campos quedan vacíos y el usuario puede editarlos
    }
  }

  // ===========================================================================
  // Formulario de Datos Base
  // ===========================================================================
  const perfilForm = document.getElementById('perfilForm') as HTMLFormElement;
  perfilForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('guardarPerfilBtn') as HTMLButtonElement;
    const label = document.getElementById('guardarPerfilLabel')!;
    const textoOriginal = label.textContent || 'Guardar Datos';

    btn.disabled = true;
    label.textContent = 'Guardando...';
    try {
      const body = {
        username: (document.getElementById('username') as HTMLInputElement).value.trim(),
        email: (document.getElementById('email') as HTMLInputElement).value.trim(),
        first_name: (document.getElementById('first_name') as HTMLInputElement).value.trim(),
        last_name: (document.getElementById('last_name') as HTMLInputElement).value.trim(),
      };
      const res = await apiPut<any>('/usuarios/perfil/', body);
      (window as any).showToast?.(`✅ ${res?.mensaje || 'Perfil actualizado'}`, 'success');

      // Refrescar la caché local del usuario
      const cached = getCachedUser();
      if (cached) {
        cached.username = body.username;
        cached.email = body.email;
        cached.first_name = body.first_name;
        cached.last_name = body.last_name;
        cacheUser(cached);
      }
    } catch (err: any) {
      (window as any).showError?.(err?.error || 'Error al guardar el perfil.');
    } finally {
      btn.disabled = false;
      label.textContent = textoOriginal;
    }
  });

  // ===========================================================================
  // Formulario de Cambio de Contraseña
  // ===========================================================================
  const passwordForm = document.getElementById('passwordForm') as HTMLFormElement;
  passwordForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('cambiarPassBtn') as HTMLButtonElement;
    const label = document.getElementById('cambiarPassLabel')!;
    const textoOriginal = label.textContent || 'Cambiar Contraseña';

    const actual = (document.getElementById('password_actual') as HTMLInputElement).value;
    const nueva = (document.getElementById('password_nueva') as HTMLInputElement).value;
    const confirmar = (document.getElementById('password_confirm') as HTMLInputElement).value;

    if (nueva !== confirmar) {
      (window as any).showError?.('Las contraseñas nuevas no coinciden.');
      return;
    }

    btn.disabled = true;
    label.textContent = 'Guardando...';
    try {
      await apiPut<any>('/usuarios/perfil/', { password_actual: actual, password_nueva: nueva });
      (window as any).showToast?.('🔑 Contraseña actualizada. Ingresá de nuevo con tus nuevas credenciales.', 'success');

      // Cerrar sesión: borrar tokens y redirigir al login
      clearTokens();
      setTimeout(() => { window.location.href = '/login'; }, 900);
    } catch (err: any) {
      (window as any).showError?.(err?.error || 'Error al cambiar la contraseña.');
      btn.disabled = false;
      label.textContent = textoOriginal;
    }
  });

  cargarPerfil();

  // ===========================================================================
  // Integraciones del Ecosistema - Control de vinculación Mercado Libre
  // Todas las llamadas envían JWT + X-Estok-Id (inquilinato activo) vía el
  // helper centralizado getAuthHeaders() de services/auth → hermetismo multi-tenant.
  // ===========================================================================
  const btnConectarML = document.getElementById('btnConectarML');
  const btnDesconectarML = document.getElementById('btnDesconectarML');
  const mlStatusBadge = document.getElementById('mlStatusBadge');
  const mlInfo = document.getElementById('mlInfo');
  const mlUserName = document.getElementById('mlUserName');
  const mlUserId = document.getElementById('mlUserId');

  const setMLBadge = (clases: string, texto: string) => {
    if (mlStatusBadge) {
      mlStatusBadge.innerHTML = `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${clases}">${texto}</span>`;
    }
  };

  async function cargarEstadoML() {
    try {
      const data = await obtenerEstadoML();
      if (data.conectado) {
        setMLBadge('bg-green-100 text-green-700', '✅ Conectado');
        btnConectarML?.classList.add('hidden');
        btnDesconectarML?.classList.remove('hidden');
        mlInfo?.classList.remove('hidden');
        if (mlUserName) {
          if (data.nombre) {
            mlUserName.textContent = data.nombre + (data.apellido ? ` ${data.apellido}` : '');
            if (data.email) mlUserName.textContent += ` (${data.email})`;
          } else if (data.nickname) {
            mlUserName.textContent = data.nickname;
          }
        }
        if (data.ml_user_id && mlUserId) mlUserId.textContent = String(data.ml_user_id);
      } else {
        setMLBadge('bg-amber-100 text-amber-700', '⚠️ No conectado');
        btnConectarML?.classList.remove('hidden');
        btnDesconectarML?.classList.add('hidden');
        mlInfo?.classList.add('hidden');
      }
    } catch (err) {
      console.error('Error al cargar estado ML:', err);
      setMLBadge('bg-red-100 text-red-700', 'Error al verificar');
    }
  }

  btnConectarML?.addEventListener('click', async () => {
    try {
      const data = await obtenerAuthUrlML();
      // Abrir en misma pestaña: el callback OAuth redirige de vuelta a /perfil
      window.location.href = data.auth_url;
    } catch (err) {
      alert('Error al obtener URL de autorización');
    }
  });

  btnDesconectarML?.addEventListener('click', async () => {
    if (!confirm('¿Desconectar tu cuenta de Mercado Libre?')) return;
    try {
      await desconectarCuentaML();
      cargarEstadoML();
    } catch (err) {
      alert('Error al desconectar');
    }
  });

  // Escuchar notificación postMessage desde el popup/callback de OAuth
  window.addEventListener('message', (event) => {
    if (event.data && event.data.type === 'ml_connected' && event.data.success) {
      cargarEstadoML();
    }
  });

  cargarEstadoML();
</script>

