---
// =============================================================================
// PÁGINA PRINCIPAL - Dashboard Pro de Estok
// Con Chart.js, PWA Install, AI Heartbeat y estadísticas reales
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import AuthGuard from '../components/AuthGuard.astro';

// Detección de plataforma móvil por User Agent
const userAgent = Astro.request.headers.get('user-agent') || '';
const isMobile = /Android|iPhone|iPad|iPod|webOS|BlackBerry|IEMobile|Opera Mini/i.test(userAgent);
---

<AuthGuard />

<BaseLayout title="Estok - Dashboard | Sistema de Inventario">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Hero Section -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900">
          Bienvenido a <span class="text-blue-700">Estok</span>
        </h1>
        <p class="mt-2 text-base sm:text-lg text-gray-500 max-w-3xl">
          Sistema de gestión de inventario personal con análisis por IA y taxonomía unificada por categorías
        </p>

      </div>
      <div class="flex flex-row items-center gap-2 flex-wrap justify-end">
        <!-- AI Status Badge -->
        <span id="aiStatusBadge" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-500 flex-shrink-0">
          <span id="aiStatusDot" class="w-2 h-2 rounded-full bg-gray-400"></span>
          <span id="aiStatusText">Verificando IA...</span>
        </span>
        <!-- PWA Install Button (hero) - SOLO MÓVIL, no se renderiza en desktop -->
        {isMobile && (
          <button id="installPwaBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-green-600 text-white text-xs font-medium rounded-full hover:bg-green-700 transition-base shadow-sm flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Instalar App
          </button>
        )}
      </div>
    </div>

    <!-- Estado de carga -->
    <div id="loadingState" class="text-center py-12">
      <svg class="animate-spin h-10 w-10 mx-auto text-blue-700 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <p class="text-gray-500">Cargando estadísticas...</p>
    </div>

    <!-- Estado de error -->
    <div id="errorState" class="hidden bg-red-50 border border-red-200 text-red-700 px-6 py-4 rounded-xl text-center mb-8">
      <p id="errorMessage" class="font-medium">Error al cargar estadísticas.</p>
      <button id="retryBtn" class="mt-3 px-4 py-2 bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition-base text-sm font-medium">
        Reintentar
      </button>
    </div>

    <!-- Dashboard Content -->
    <div id="dashboardContent" class="hidden space-y-8">
      <!-- ================================================================ -->
      <!-- KPI CARDS - Métricas principales -->
      <!-- ================================================================ -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
            <p class="text-xs sm:text-sm text-gray-500 font-medium">Total Objetos</p>
          </div>
          <p id="kpiTotalObjetos" class="text-2xl sm:text-3xl font-bold text-gray-900">—</p>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <p class="text-xs sm:text-sm text-gray-500 font-medium">Valor Total</p>
          </div>
          <p id="kpiValorTotal" class="text-2xl sm:text-3xl font-bold text-green-700">—</p>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <p class="text-xs sm:text-sm text-gray-500 font-medium">Valor Promedio</p>
          </div>
          <p id="kpiValorPromedio" class="text-2xl sm:text-3xl font-bold text-purple-700">—</p>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <p class="text-xs sm:text-sm text-gray-500 font-medium">Ubicaciones</p>
          </div>
          <p id="kpiUbicaciones" class="text-2xl sm:text-3xl font-bold text-gray-900">—</p>
        </div>
      </div>

      <!-- ================================================================ -->
      <!-- GRÁFICOS CON CHART.JS -->
      <!-- ================================================================ -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Gráfico de torta: Distribución por tipo -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Distribución por Categoría</h2>
          <div class="relative h-64">
            <canvas id="chartTorta"></canvas>
          </div>
        </div>

        <!-- Gráfico de barras: Valor por categoría -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Valor por Categoría</h2>
          <div class="relative h-64">
            <canvas id="chartBarras"></canvas>
          </div>
        </div>
      </div>

      <!-- ================================================================ -->
      <!-- BARRAS DE PROGRESO + ÚLTIMOS OBJETOS -->
      <!-- ================================================================ -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Estado de conservación -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Estado de Conservación</h2>
          <div id="estadosContainer" class="space-y-3">
            <p class="text-sm text-gray-400">Cargando...</p>
          </div>
        </div>

        <!-- Últimos objetos registrados -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Últimos Objetos</h2>
          <div id="ultimosContainer" class="space-y-3">
            <p class="text-sm text-gray-400">Cargando...</p>
          </div>
        </div>
      </div>

      <!-- ================================================================ -->
      <!-- CATEGORÍAS (cards dinámicas desde /api/categorias/) -->
      <!-- ================================================================ -->
      <div>
        <h2 class="text-xl font-bold text-gray-900 mb-4">Categorías del Sistema</h2>
        <div id="categoriasGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          <p class="text-sm text-gray-400 col-span-full">Cargando categorías...</p>
        </div>
      </div>
    </div>


    <!-- ================================================================ -->
    <!-- CTA - Agregar Nuevo Objeto -->
    <!-- ================================================================ -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4 mt-4">
      <a href="/objetos/nuevo" class="inline-flex items-center px-6 py-3 bg-blue-700 text-white font-medium rounded-lg hover:bg-blue-800 transition-base shadow-sm">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Agregar Nuevo Objeto
      </a>
    </div>

    <!-- ================================================================ -->
    <!-- ADMIN PANEL - Solo visible para ygumy44 -->
    <!-- ================================================================ -->
    <div id="adminPanel" class="hidden mt-8">
      <div class="bg-white rounded-xl shadow-sm border-2 border-red-200 p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-red-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <div class="flex-1">
            <h2 class="text-lg font-bold text-red-900">Panel de Administración</h2>
            <p class="text-sm text-red-500">Gestión de usuarios y asignación a Estoks</p>
          </div>
          <!-- Botón recargar -->
          <button id="adminRefreshBtn" class="px-3 py-1.5 bg-red-100 text-red-700 text-xs font-medium rounded-lg hover:bg-red-200 transition-base flex items-center gap-1" title="Recargar lista">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Recargar
          </button>
        </div>

        <!-- Loading -->
        <div id="adminLoading" class="text-center py-4">
          <svg class="animate-spin h-6 w-6 mx-auto text-red-500 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <p class="text-sm text-gray-500">Cargando usuarios...</p>
        </div>

        <!-- Error -->
        <div id="adminError" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm mb-4"></div>

        <!-- Success -->
        <div id="adminSuccess" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm mb-4"></div>

        <!-- User list -->
        <div id="adminUserList" class="hidden space-y-3">
          <!-- Se llena dinámicamente -->
        </div>
      </div>
    </div>
  </div>

<script>
  // ===========================================================================
  // DASHBOARD PRO - Estadísticas en tiempo real + Chart.js + PWA + AI
  // ===========================================================================

  import {getAuthHeaders, API_BASE_URL} from '../services/auth';


  
  const LM_STUDIO_URL = 'http://localhost:1234/v1';

  const loadingState = document.getElementById('loadingState')!;
  const errorState = document.getElementById('errorState')!;
  const errorMessage = document.getElementById('errorMessage')!;
  const retryBtn = document.getElementById('retryBtn')!;
  const dashboardContent = document.getElementById('dashboardContent')!;


  // ===========================================================================
  // AI HEARTBEAT
  // ===========================================================================

  const aiStatusBadge = document.getElementById('aiStatusBadge')!;
  const aiStatusDot = document.getElementById('aiStatusDot')!;
  const aiStatusText = document.getElementById('aiStatusText')!;

  async function checkAIAvailability(): Promise<boolean> {
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 5000);
      const response = await fetch(`${LM_STUDIO_URL}/models`, {
        method: 'GET',
        signal: controller.signal,
      });
      clearTimeout(timeoutId);
      return response.ok;
    } catch {
      return false;
    }
  }

  async function updateAIStatus() {
    const connected = await checkAIAvailability();
    if (connected) {
      aiStatusBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700';
      aiStatusDot.className = 'w-2 h-2 rounded-full bg-green-500';
      aiStatusText.textContent = 'IA Conectada';
    } else {
      aiStatusBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-500';
      aiStatusDot.className = 'w-2 h-2 rounded-full bg-gray-400';
      aiStatusText.textContent = 'Modo Manual';
    }
  }

  updateAIStatus();
  setInterval(updateAIStatus, 30000);

  // ===========================================================================
  // PWA INSTALL - Android nativo (1 tap) + iOS Safari (2 taps guiados)
  // ===========================================================================
  //
  // IMPORTANTE TÉCNICO: Apple NO permite beforeinstallprompt en iOS Safari.
  // Es una restricción de la plataforma, no del código. Todas las PWAs
  // (Twitter, Uber, Starbucks, Pinterest) tienen la misma limitación.
  // El flujo iOS usa el botón nativo "Compartir" de Safari, que es el
  // método oficial documentado por Apple.
  // ===========================================================================

  let deferredPrompt: any = null;

  const installPwaBtn = document.getElementById('installPwaBtn')!;

  const isIOS = /iPhone|iPad|iPod/i.test(navigator.userAgent);
  const isSafari = /Safari/i.test(navigator.userAgent) && !/CriOS|FxiOS|OPiOS|mercury/i.test(navigator.userAgent);
  const isStandalone = window.matchMedia('(display-mode: standalone)').matches
    || (navigator as any).standalone === true;

  if (isStandalone) {
    installPwaBtn?.classList.add('hidden');
  } else {
    installPwaBtn?.classList.remove('hidden');
  }

  // Android Chrome/Edge: capturar beforeinstallprompt para instalar en 1 tap
  window.addEventListener('beforeinstallprompt', (e: Event) => {
    e.preventDefault();
    deferredPrompt = e;
    console.log('📲 PWA: beforeinstallprompt listo (1-tap)');
    window.dispatchEvent(new CustomEvent('estok-pwa-ready'));
  });

  window.addEventListener('appinstalled', () => {
    deferredPrompt = null;
    installPwaBtn?.classList.add('hidden');
    window.dispatchEvent(new CustomEvent('estok-pwa-installed'));
    console.log('✅ Estok instalada como PWA');
  });

  function mostrarPromptIOS() {
    // Evitar duplicados
    if (document.getElementById('iosPrompt')) return;

    const esChrome = /CriOS/i.test(navigator.userAgent);

    const overlay = document.createElement('div');
    overlay.id = 'iosPrompt';
    overlay.className = 'fixed inset-0 z-[9999] flex items-end justify-center bg-black/40 backdrop-blur-sm animate-fade-in';
    overlay.innerHTML = `
      <div class="bg-white rounded-t-3xl w-full max-w-md mx-auto px-6 pt-6 pb-8 shadow-2xl animate-slide-up">
        <!-- Handle bar -->
        <div class="w-10 h-1 bg-gray-300 rounded-full mx-auto mb-5"></div>

        <!-- Icon + Title -->
        <div class="text-center mb-5">
          <img src="/icons/apple-touch-icon.png" alt="Estok" class="w-16 h-16 rounded-2xl mx-auto mb-3 shadow-md" />
          <h3 class="text-lg font-bold text-gray-900">Instalar Estok</h3>
          <p class="text-sm text-gray-500 mt-1">Agregá Estok a tu pantalla de inicio para usarla como una app.</p>
        </div>

        ${esChrome ? `
        <!-- Usuario en Chrome: necesita Safari -->
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-4 text-center">
          <p class="text-sm font-semibold text-amber-800 mb-2">⚠️ Necesitás Safari</p>
          <p class="text-xs text-amber-700 mb-3">Chrome en iPhone no permite instalar apps. Abrí esta página en Safari para continuar.</p>
          <button id="iosCopiarEnlaceBtn" class="w-full px-4 py-2.5 text-sm font-semibold text-white bg-blue-700 hover:bg-blue-800 rounded-xl transition-base shadow-sm">
            📋 Copiar enlace para abrir en Safari
          </button>
        </div>
        ` : `
        <!-- Usuario en Safari: mostrar instrucción simple -->
        <div class="text-center space-y-3">
          <div class="flex items-center justify-center gap-3 p-4 bg-blue-50 rounded-xl">
            <div class="flex-shrink-0 w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
            </div>
            <p class="text-sm font-semibold text-blue-800 text-left leading-snug">
              Tocá <span class="inline-flex items-center gap-1 px-1.5 py-0.5 bg-white rounded text-xs font-bold border border-blue-200">📤 Compartir</span><br>
              y luego <span class="font-bold">"Agregar a inicio"</span>
            </p>
          </div>
        </div>
        `}

        <button id="iosCerrarBtn" class="w-full mt-4 px-4 py-3 text-sm font-semibold text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-xl transition-base">
          ${esChrome ? 'Cerrar' : 'Entendido'}
        </button>
      </div>
    `;

    document.body.appendChild(overlay);

    const cerrar = () => {
      overlay.classList.add('animate-fade-out');
      setTimeout(() => overlay.remove(), 200);
    };

    document.getElementById('iosCerrarBtn')?.addEventListener('click', cerrar);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) cerrar();
    });

    // Copiar enlace (solo Chrome)
    document.getElementById('iosCopiarEnlaceBtn')?.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        (window as any).showSuccess?.('✅ Enlace copiado. Pegalo en Safari para instalar.');
      }).catch(() => {
        (window as any).showInfo?.('Copiá manualmente el enlace y abrilo en Safari.');
      });
      cerrar();
    });
  }

  async function installPWA(): Promise<boolean> {
    if (deferredPrompt) {
      // Android: 1-tap install vía beforeinstallprompt nativo
      deferredPrompt.prompt();
      const result = await deferredPrompt.userChoice;
      deferredPrompt = null;
      if (result.outcome === 'accepted') {
        (window as any).showSuccess?.('✅ Estok instalada');
        return true;
      }
      return false;
    }

    if (isIOS) {
      // iOS: mostrar prompt profesional con instrucción mínima
      mostrarPromptIOS();
      return false;
    }

    // Desktop / otros
    (window as any).showInfo?.('Usá el menú del navegador para instalar esta app.');
    return false;
  }

  (window as any).installPWA = installPWA;
  installPwaBtn?.addEventListener('click', () => installPWA());

  // ===========================================================================
  // MAPEOS
  // ===========================================================================

  // Taxonomía unificada: la clasificación es por categoría (11 oficiales Meli).
  // Los mapas viejos por "tipo" (libro/tecnologia/mueble/ropa) fueron eliminados.

  // Ícono por categoría oficial (11 Meli). Usado en "Últimos objetos".
  function getIconoCategoria(nombre: string | null | undefined): string {
    if (!nombre) return '';
    const map: Record<string, string> = {
      'Muebles': '🛋️',
      'Arte': '🎨',
      'Coleccionables': '🏺',
      'Antigüedades': '🕰️',
      'Jardín': '🌿',
      'Computación': '💻',
      'Electrónica': '📺',
      'Cocina': '🍳',
      'Hogar': '🏠',
      'Herramientas': '🔧',
      'Materiales': '🧱',
    };
    return map[nombre] || '';
  }

  const ESTADO_LABELS: Record<string, { label: string; color: string }> = {

    excelente: { label: 'Excelente', color: 'bg-green-100 text-green-700' },
    bueno: { label: 'Bueno', color: 'bg-blue-100 text-blue-700' },
    regular: { label: 'Regular', color: 'bg-yellow-100 text-yellow-700' },
    malo: { label: 'Malo', color: 'bg-orange-100 text-orange-700' },
    muy_malo: { label: 'Muy malo', color: 'bg-red-100 text-red-700' },
  };

  // ===========================================================================
  // RENDERIZADO DE BARRAS DE PROGRESO
  // ===========================================================================

  function renderBarChart(containerId: string, data: Record<string, number>, labelMap: Record<string, any>, total: number) {
    const container = document.getElementById(containerId)!;
    const entries = Object.entries(data);

    if (entries.length === 0) {
      container.innerHTML = '<p class="text-sm text-gray-400">Sin datos</p>';
      return;
    }

    container.innerHTML = entries.map(([key, count]) => {
      const info = labelMap[key] || { label: key, color: 'bg-gray-100 text-gray-700' };
      const percentage = total > 0 ? ((count / total) * 100).toFixed(1) : 0;
      return `
        <div>
          <div class="flex justify-between items-center mb-1">
            <span class="text-sm text-gray-700">${info.label || key}</span>
            <span class="text-sm font-medium text-gray-900">${count} (${percentage}%)</span>
          </div>
          <div class="w-full bg-gray-100 rounded-full h-2.5">
            <div class="h-2.5 rounded-full ${info.color.split(' ')[0]}" style="width: ${percentage}%"></div>
          </div>
        </div>
      `;
    }).join('');
  }

