        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-bold text-gray-900">✏️ Editar Usuario</h3>
          <button id="godCerrarModalUsuarioEditar" class="p-1 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-base" title="Cerrar">✕</button>
