              <label for="gUPasswordEditar" class="block text-sm font-medium text-gray-700 mb-1">Nueva contraseña <span class="text-xs text-gray-400 font-normal">(dejar vacío para no cambiar)</span></label>
              <input id="gUPasswordEditar" type="password" autocomplete="new-password" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base" />
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-6">
            <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
              <input id="gUIsActiveEditar" type="checkbox" class="w-4 h-4 text-red-700 rounded border-gray-300" />
              Activo
            </label>
            <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
              <input id="gUIsSuperuserEditar" type="checkbox" class="w-4 h-4 text-red-700 rounded border-gray-300" />
              Superusuario
            </label>
          </div>
          <div id="godFormUsuarioEditarError" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm"></div>
          <div class="flex gap-3 pt-1">
            <button type="submit" id="godGuardarUsuarioEditarBtn" class="flex-1 py-2.5 bg-red-700 hover:bg-red-800 text-white text-sm font-semibold rounded-lg transition-base shadow-sm">Guardar Cambios</button>
            <button type="button" id="godCancelarUsuarioEditarBtn" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition-base">Cancelar</button>
          </div>
        </form>
      </div>
    </div>




  </div>

<script>
  // ===========================================================================
  // DASHBOARD PRO - Estadísticas en tiempo real + Chart.js + PWA + AI
  // ===========================================================================

  import {getAuthHeaders, API_BASE_URL} from '../services/auth';
  import {initGodMode} from '../lib/godMode';

  // ===========================================================================
  // CONTRATO ANALÍTICO - Tipos del payload de /api/objetos/estadisticas/
  // ===========================================================================
  interface DecisionPorUsuario {
    usuario_id: string;
    usuario_nombre: string;
    vender_publicado: number;
    vender_no_publicado: number;
    conservar: number;
    tirar: number;
    sin_decision: number;
  }

  interface UltimoObjetoResumen {
    id: string;
    nombre: string;
    tipo: string | null;
    valor_estimado: number | null;
    fecha_registro: string;
  }

  interface EstadisticasDashboard {
    total_objetos: number;
    valor_total_inventario: number;
    valor_promedio: number;
    total_ubicaciones: number;
    total_contenedores: number;
    objetos_por_categoria: Record<string, number>;
    valor_por_categoria: Record<string, number>;
    objetos_por_estado: Record<string, number>;
    objetos_por_carga: Record<string, number>;
    decisiones_por_usuario: DecisionPorUsuario[];
    ultimos_objetos: UltimoObjetoResumen[];
  }


  
  const LM_STUDIO_URL = 'http://localhost:1234/v1';

  const loadingState = document.getElementById('loadingState')!;
  const errorState = document.getElementById('errorState')!;
  const errorMessage = document.getElementById('errorMessage')!;
  const retryBtn = document.getElementById('retryBtn')!;
  const dashboardContent = document.getElementById('dashboardContent')!;


  // ===========================================================================
  // AI HEARTBEAT
  // ===========================================================================

  const aiStatusBadge = document.getElementById('aiStatusBadge')!;
  const aiStatusDot = document.getElementById('aiStatusDot')!;
  const aiStatusText = document.getElementById('aiStatusText')!;

  async function checkAIAvailability(): Promise<boolean> {
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 5000);
      const response = await fetch(`${LM_STUDIO_URL}/models`, {
        method: 'GET',
        signal: controller.signal,
      });
      clearTimeout(timeoutId);
      return response.ok;
    } catch {
      return false;
    }
  }

  async function updateAIStatus() {
    const connected = await checkAIAvailability();
    if (connected) {
      aiStatusBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700';
      aiStatusDot.className = 'w-2 h-2 rounded-full bg-green-500';
      aiStatusText.textContent = 'IA Conectada';
    } else {
      aiStatusBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-500';
      aiStatusDot.className = 'w-2 h-2 rounded-full bg-gray-400';
      aiStatusText.textContent = 'Modo Manual';
    }
  }

  updateAIStatus();
  setInterval(updateAIStatus, 30000);

  // ===========================================================================
  // PWA INSTALL - Android nativo (1 tap) + iOS Safari (2 taps guiados)
  // ===========================================================================
  //
  // IMPORTANTE TÉCNICO: Apple NO permite beforeinstallprompt en iOS Safari.
  // Es una restricción de la plataforma, no del código. Todas las PWAs
  // (Twitter, Uber, Starbucks, Pinterest) tienen la misma limitación.
  // El flujo iOS usa el botón nativo "Compartir" de Safari, que es el
  // método oficial documentado por Apple.
  // ===========================================================================

  let deferredPrompt: any = null;

  const installPwaBtn = document.getElementById('installPwaBtn')!;

  const isIOS = /iPhone|iPad|iPod/i.test(navigator.userAgent);
  const isSafari = /Safari/i.test(navigator.userAgent) && !/CriOS|FxiOS|OPiOS|mercury/i.test(navigator.userAgent);
  const isStandalone = window.matchMedia('(display-mode: standalone)').matches
    || (navigator as any).standalone === true;

  if (isStandalone) {
    installPwaBtn?.classList.add('hidden');
  } else {
    installPwaBtn?.classList.remove('hidden');
  }

  // Android Chrome/Edge: capturar beforeinstallprompt para instalar en 1 tap
  window.addEventListener('beforeinstallprompt', (e: Event) => {
    e.preventDefault();
    deferredPrompt = e;
    console.log('📲 PWA: beforeinstallprompt listo (1-tap)');
    window.dispatchEvent(new CustomEvent('estok-pwa-ready'));
  });

  window.addEventListener('appinstalled', () => {
    deferredPrompt = null;
    installPwaBtn?.classList.add('hidden');
    window.dispatchEvent(new CustomEvent('estok-pwa-installed'));
    console.log('✅ Estok instalada como PWA');
  });

  function mostrarPromptIOS() {
    // Evitar duplicados
    if (document.getElementById('iosPrompt')) return;

    const esChrome = /CriOS/i.test(navigator.userAgent);

    const overlay = document.createElement('div');
    overlay.id = 'iosPrompt';
    overlay.className = 'fixed inset-0 z-[9999] flex items-end justify-center bg-black/40 backdrop-blur-sm animate-fade-in';
    overlay.innerHTML = `
      <div class="bg-white rounded-t-3xl w-full max-w-md mx-auto px-6 pt-6 pb-8 shadow-2xl animate-slide-up">
        <!-- Handle bar -->
        <div class="w-10 h-1 bg-gray-300 rounded-full mx-auto mb-5"></div>

        <!-- Icon + Title -->
        <div class="text-center mb-5">
          <img src="/icons/apple-touch-icon.png" alt="Estok" class="w-16 h-16 rounded-2xl mx-auto mb-3 shadow-md" />
          <h3 class="text-lg font-bold text-gray-900">Instalar Estok</h3>
          <p class="text-sm text-gray-500 mt-1">Agregá Estok a tu pantalla de inicio para usarla como una app.</p>
        </div>

        ${esChrome ? `
        <!-- Usuario en Chrome: necesita Safari -->
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-4 text-center">
          <p class="text-sm font-semibold text-amber-800 mb-2">⚠️ Necesitás Safari</p>
          <p class="text-xs text-amber-700 mb-3">Chrome en iPhone no permite instalar apps. Abrí esta página en Safari para continuar.</p>
          <button id="iosCopiarEnlaceBtn" class="w-full px-4 py-2.5 text-sm font-semibold text-white bg-blue-700 hover:bg-blue-800 rounded-xl transition-base shadow-sm">
            📋 Copiar enlace para abrir en Safari
          </button>
        </div>
        ` : `
        <!-- Usuario en Safari: mostrar instrucción simple -->
        <div class="text-center space-y-3">
          <div class="flex items-center justify-center gap-3 p-4 bg-blue-50 rounded-xl">
            <div class="flex-shrink-0 w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
            </div>
            <p class="text-sm font-semibold text-blue-800 text-left leading-snug">
              Tocá <span class="inline-flex items-center gap-1 px-1.5 py-0.5 bg-white rounded text-xs font-bold border border-blue-200">📤 Compartir</span><br>
              y luego <span class="font-bold">"Agregar a inicio"</span>
            </p>
          </div>
        </div>
        `}

        <button id="iosCerrarBtn" class="w-full mt-4 px-4 py-3 text-sm font-semibold text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-xl transition-base">
          ${esChrome ? 'Cerrar' : 'Entendido'}
        </button>
      </div>
    `;

    document.body.appendChild(overlay);

    const cerrar = () => {
      overlay.classList.add('animate-fade-out');
      setTimeout(() => overlay.remove(), 200);
    };

    document.getElementById('iosCerrarBtn')?.addEventListener('click', cerrar);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) cerrar();
    });

    // Copiar enlace (solo Chrome)
    document.getElementById('iosCopiarEnlaceBtn')?.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        (window as any).showSuccess?.('✅ Enlace copiado. Pegalo en Safari para instalar.');
      }).catch(() => {
        (window as any).showInfo?.('Copiá manualmente el enlace y abrilo en Safari.');
      });
      cerrar();
    });
  }

  async function installPWA(): Promise<boolean> {
    if (deferredPrompt) {
      // Android: 1-tap install vía beforeinstallprompt nativo
      deferredPrompt.prompt();
      const result = await deferredPrompt.userChoice;
      deferredPrompt = null;
      if (result.outcome === 'accepted') {
        (window as any).showSuccess?.('✅ Estok instalada');
        return true;
      }
      return false;
    }

    if (isIOS) {
      // iOS: mostrar prompt profesional con instrucción mínima
      mostrarPromptIOS();
      return false;
    }

    // Desktop / otros
    (window as any).showInfo?.('Usá el menú del navegador para instalar esta app.');
    return false;
  }

  (window as any).installPWA = installPWA;
  installPwaBtn?.addEventListener('click', () => installPWA());

  // ===========================================================================
  // MAPEOS
  // ===========================================================================

  // Taxonomía unificada: la clasificación es por categoría (11 oficiales Meli).
  // Los mapas viejos por "tipo" (libro/tecnologia/mueble/ropa) fueron eliminados.

  // Ícono por categoría oficial (11 Meli). Usado en "Últimos objetos".
  function getIconoCategoria(nombre: string | null | undefined): string {
    if (!nombre) return '';
    const map: Record<string, string> = {
      'Muebles': '🛋️',
      'Arte': '🎨',
      'Coleccionables': '🏺',
      'Antigüedades': '🕰️',
      'Jardín': '🌿',
      'Computación': '💻',
      'Electrónica': '📺',
      'Cocina': '🍳',
      'Hogar': '🏠',
      'Herramientas': '🔧',
      'Materiales': '🧱',
    };
    return map[nombre] || '';
  }

  const ESTADO_LABELS: Record<string, { label: string; color: string }> = {

    excelente: { label: 'Excelente', color: 'bg-green-100 text-green-700' },
    bueno: { label: 'Bueno', color: 'bg-blue-100 text-blue-700' },
    regular: { label: 'Regular', color: 'bg-yellow-100 text-yellow-700' },
    malo: { label: 'Malo', color: 'bg-orange-100 text-orange-700' },
    muy_malo: { label: 'Muy malo', color: 'bg-red-100 text-red-700' },
  };

  // ===========================================================================
  // RENDERIZADO DE BARRAS DE PROGRESO
  // ===========================================================================

  function renderBarChart(containerId: string, data: Record<string, number>, labelMap: Record<string, any>, total: number) {
    const container = document.getElementById(containerId)!;
    const entries = Object.entries(data);

    if (entries.length === 0) {
      container.innerHTML = '<p class="text-sm text-gray-400">Sin datos</p>';
      return;
    }

    container.innerHTML = entries.map(([key, count]) => {
      const info = labelMap[key] || { label: key, color: 'bg-gray-100 text-gray-700' };
      const percentage = total > 0 ? ((count / total) * 100).toFixed(1) : 0;
      return `
        <div>
          <div class="flex justify-between items-center mb-1">
            <span class="text-sm text-gray-700">${info.label || key}</span>
            <span class="text-sm font-medium text-gray-900">${count} (${percentage}%)</span>
          </div>
          <div class="w-full bg-gray-100 rounded-full h-2.5">
            <div class="h-2.5 rounded-full ${info.color.split(' ')[0]}" style="width: ${percentage}%"></div>
          </div>
        </div>
      `;
    }).join('');
  }

  // ===========================================================================
  // RENDERIZADO DE ÚLTIMOS OBJETOS
  // ===========================================================================

  function renderUltimos(objetos: any[]) {
    const container = document.getElementById('ultimosContainer')!;
    if (!objetos || objetos.length === 0) {
      container.innerHTML = '<p class="text-sm text-gray-400">No hay objetos registrados aún.</p>';
      return;
    }

    container.innerHTML = objetos.map(o => {
      const icono = o.categoria_nombre ? getIconoCategoria(o.categoria_nombre) : '📦';
      return `
        <a href="/objetos/${o.id}" class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 transition-base border border-gray-100">
          <span class="text-lg">${icono}</span>

          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-900 truncate">${o.nombre}</p>
            <p class="text-xs text-gray-400">${new Date(o.fecha_registro).toLocaleDateString('es-AR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}</p>
          </div>
          ${o.valor_estimado ? `<span class="text-sm font-medium text-green-700">$${Number(o.valor_estimado).toLocaleString('es-AR')}</span>` : ''}
        </a>
      `;
    }).join('');
  }

  // ===========================================================================
  // RENDERIZADO DE CARDS DE CATEGORÍAS (dinámicas desde /api/categorias/)
  // Consume las 11 categorías oficiales (Mercado Libre) del backend unificado.
  // ===========================================================================

  // Paleta cíclica para las cards (evita hardcodear categorías específicas)
  const CATEGORIA_PALETA = [
    { bg: 'bg-blue-100', text: 'text-blue-700' },
    { bg: 'bg-green-100', text: 'text-green-700' },
    { bg: 'bg-amber-100', text: 'text-amber-700' },
    { bg: 'bg-purple-100', text: 'text-purple-700' },
    { bg: 'bg-rose-100', text: 'text-rose-700' },
    { bg: 'bg-cyan-100', text: 'text-cyan-700' },
    { bg: 'bg-indigo-100', text: 'text-indigo-700' },
    { bg: 'bg-orange-100', text: 'text-orange-700' },
    { bg: 'bg-teal-100', text: 'text-teal-700' },
    { bg: 'bg-pink-100', text: 'text-pink-700' },
    { bg: 'bg-lime-100', text: 'text-lime-700' },
  ];

  async function renderCategorias() {
    const grid = document.getElementById('categoriasGrid');
    if (!grid) return;
    try {
      const response = await fetch(`${API_BASE_URL}/categorias/`, {
        headers: getAuthHeaders(),
      });
      if (!response.ok) {
        throw new Error(`Error del servidor (${response.status})`);
      }
      const data = await response.json();
      const categorias = Array.isArray(data) ? data : (data.results || []);

      if (categorias.length === 0) {
        grid.innerHTML = '<p class="text-sm text-gray-400 col-span-full">No hay categorías creadas todavía.</p>';
        return;
      }

      grid.innerHTML = categorias.map((cat: any, i: number) => {
        const color = CATEGORIA_PALETA[i % CATEGORIA_PALETA.length];
        const icono = cat.icono || '🏷️';
        const count = cat.objetos_count ?? 0;
        return `
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6 hover:shadow-md transition-base">
            <div class="w-10 h-10 ${color.bg} rounded-lg flex items-center justify-center mb-3">
              <span class="text-xl">${icono}</span>
            </div>
            <h3 class="font-semibold text-gray-900 text-sm line-clamp-2">${cat.nombre}</h3>
            <p class="text-xs ${color.text} font-medium mt-2">${count} objeto${count === 1 ? '' : 's'}</p>
          </div>
        `;
      }).join('');
    } catch (err) {
      console.error('Error al cargar categorías:', err);
      grid.innerHTML = '<p class="text-sm text-gray-400 col-span-full">Error al cargar categorías.</p>';
    }
  }

  // ===========================================================================
  // ANALÍTICAS NATIVAS (sin librerías externas)
  // Barras horizontales apiladas por usuario + torta SVG con <circle>
  // ===========================================================================

  // Mapa de colores OFICIAL de decisiones (clases Tailwind estrictas).
  const DECISION_SEGMENTS: { key: keyof DecisionPorUsuario; label: string; cssClass: string }[] = [
    { key: 'vender_publicado',    label: 'Vender · Publicado',    cssClass: 'bg-green-400' },
    { key: 'vender_no_publicado', label: 'Vender · No publicado', cssClass: 'bg-green-700' },
    { key: 'conservar',           label: 'Conservar',             cssClass: 'bg-blue-600' },
    { key: 'tirar',               label: 'Tirar',                 cssClass: 'bg-red-600' },
    { key: 'sin_decision',        label: 'Sin decisión',          cssClass: 'bg-orange-500' },
  ];

  const HTML_ESCAPES: Record<string, string> = {
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  };

  function escapeHtml(value: string): string {
    return value.replace(/[&<>"']/g, (ch) => HTML_ESCAPES[ch] || ch);
  }

  function totalDecisiones(u: DecisionPorUsuario): number {
    return (u.vender_publicado || 0) + (u.vender_no_publicado || 0)
      + (u.conservar || 0) + (u.tirar || 0) + (u.sin_decision || 0);
  }

  // Barras horizontales apiladas: una fila por usuario (dueño original),
  // cada segmento = volumen de una decisión con su color oficial.
  function renderBarrasApiladas(data: DecisionPorUsuario[]) {
    const container = document.getElementById('barrasApiladasContainer')!;
    if (!data || data.length === 0) {
      container.innerHTML = '<p class="text-sm text-gray-400">Sin objetos con dueño asignado aún.</p>';
      return;
    }

    const filas = [...data].sort((a, b) => totalDecisiones(b) - totalDecisiones(a));

    container.innerHTML = filas.map((usr) => {
      const total = totalDecisiones(usr);
      if (total <= 0) return '';
      const nombre = escapeHtml(usr.usuario_nombre || usr.usuario_id);
      const segmentos = DECISION_SEGMENTS.map((seg) => {
        const value = Number(usr[seg.key]) || 0;
        const pct = (value / total) * 100;
        return value > 0
          ? `<div class="${seg.cssClass}" style="width:${pct.toFixed(2)}%" title="${seg.label}: ${value}"></div>`
          : '';
      }).join('');

      return `
        <div>
          <div class="flex justify-between items-center mb-1 gap-2">
            <span class="text-sm font-medium text-gray-700 truncate">${nombre}</span>
            <span class="text-xs text-gray-400 shrink-0">${total} objeto${total === 1 ? '' : 's'}</span>
          </div>
          <div class="flex w-full h-4 rounded-full overflow-hidden bg-gray-100" role="img" aria-label="Decisiones de ${nombre}">
            ${segmentos}
          </div>
        </div>
      `;
    }).join('');
  }

  // Paleta hex fija para las 11 categorías oficiales del sistema (torta SVG).
  const CATEGORIA_HEX_COLORS: Record<string, string> = {
    'Muebles': '#3b82f6',
    'Arte': '#22c55e',
    'Coleccionables': '#f59e0b',
    'Antigüedades': '#a855f7',
    'Jardín': '#f43f5e',
    'Computación': '#06b6d4',
    'Electrónica': '#6366f1',
    'Cocina': '#f97316',
    'Hogar': '#14b8a6',
    'Herramientas': '#ec4899',
    'Materiales': '#84cc16',
  };
  const CATEGORIA_FALLBACK_COLORS = ['#94a3b8', '#64748b', '#475569'];

  function categoriaHex(nombre: string, index: number): string {
    return CATEGORIA_HEX_COLORS[nombre] || CATEGORIA_FALLBACK_COLORS[index % CATEGORIA_FALLBACK_COLORS.length];
  }

  // Torta (donut) 100% SVG nativa con <circle stroke-dasharray="..." />.
  // Cada segmento es un <circle> con un único dash de largo proporcional,
  // rotado a su ángulo de inicio (arranca a las 12 en punto).
  function renderPieSVG(containerId: string, data: Record<string, number>) {
    const container = document.getElementById(containerId)!;
    const entries = Object.entries(data).filter(([, v]) => Number(v) > 0);
    const total = entries.reduce((acc, [, v]) => acc + Number(v), 0);
    if (total <= 0 || entries.length === 0) {
      container.innerHTML = '<p class="text-sm text-gray-400 text-center py-10">Sin datos para mostrar</p>';
      return;
    }

    const SIZE = 180;
    const CENTER = SIZE / 2;
    const RADIUS = 70;
    const STROKE_WIDTH = 28;
    const CIRCUNFERENCIA = 2 * Math.PI * RADIUS;

    let acumulado = 0;
    const segmentos = entries.map(([nombre, valor], i) => {
      const frac = Number(valor) / total;
      const largo = frac * CIRCUNFERENCIA;
      const rotacion = (acumulado / CIRCUNFERENCIA) * 360 - 90;
      const color = categoriaHex(nombre, i);
      acumulado += largo;
      const circle = `
        <circle
          cx="${CENTER}" cy="${CENTER}" r="${RADIUS}"
          fill="none"
          stroke="${color}"
          stroke-width="${STROKE_WIDTH}"
          stroke-dasharray="${largo.toFixed(3)} ${(CIRCUNFERENCIA - largo).toFixed(3)}"
          stroke-dashoffset="0"
          transform="rotate(${rotacion.toFixed(3)} ${CENTER} ${CENTER})"
        >
          <title>${escapeHtml(nombre)}: ${valor} objeto${Number(valor) === 1 ? '' : 's'}</title>
        </circle>
      `;
      return { nombre, valor, color, circle };
    });

    container.innerHTML = `
      <div class="flex flex-col items-center w-full">
        <div class="relative">
          <svg viewBox="0 0 ${SIZE} ${SIZE}" class="w-44 h-44" role="img" aria-label="Distribución de objetos por categoría">
            ${segmentos.map((s) => s.circle).join('')}
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
            <span class="text-2xl font-bold text-gray-900 leading-none">${total}</span>
            <span class="text-[10px] uppercase tracking-wide text-gray-400 mt-1">objetos</span>
          </div>
        </div>
        <!-- Leyenda limpia con nombres e indicadores de color -->
        <div class="w-full mt-4 grid grid-cols-1 gap-x-4 gap-y-0.5">
          ${segmentos.map((s) => `
            <div class="flex items-center justify-between gap-2 py-0.5">
              <span class="inline-flex items-center gap-2 text-xs text-gray-600 min-w-0">
                <span class="w-2.5 h-2.5 rounded-sm shrink-0" style="background-color:${s.color}"></span>
                <span class="truncate">${escapeHtml(s.nombre)}</span>
              </span>
              <span class="text-xs font-medium text-gray-900 shrink-0">${s.valor} (${((Number(s.valor) / total) * 100).toFixed(1)}%)</span>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  }


  // ===========================================================================
  // CARGA DE ESTADÍSTICAS
  // ===========================================================================

  async function cargarEstadisticas() {
    loadingState.classList.remove('hidden');
    errorState.classList.add('hidden');
    dashboardContent.classList.add('hidden');

    try {
      const response = await fetch(`${API_BASE_URL}/objetos/estadisticas/`, {
        headers: getAuthHeaders(),
      });

      if (response.status === 401) {
        window.location.href = '/login';
        return;
      }

      if (!response.ok) {
        throw new Error(`Error del servidor (${response.status})`);
      }

      const data = (await response.json()) as EstadisticasDashboard;

      // === Mosaicos de totales ===
      document.getElementById('kpiTotalObjetos')!.textContent = data.total_objetos.toString();
      document.getElementById('kpiValorTotal')!.textContent = `$${Number(data.valor_total_inventario).toLocaleString('es-AR', { minimumFractionDigits: 2 })}`;
      document.getElementById('kpiUbicaciones')!.textContent = data.total_ubicaciones.toString();
      document.getElementById('kpiContenedores')!.textContent = (data.total_contenedores ?? 0).toString();

      // === Analíticas nativas (sin librerías externas) ===
      renderBarrasApiladas(data.decisiones_por_usuario || []);
      renderPieSVG('pieCategoriasContainer', data.objetos_por_categoria || {});



      // === Estado de conservación (barras) ===
      renderBarChart('estadosContainer', data.objetos_por_estado, ESTADO_LABELS, data.total_objetos);

      // === Últimos objetos ===
      renderUltimos(data.ultimos_objetos);

      // === Cargar cards dinámicas de categorías (11 Meli desde /api/categorias/) ===
      renderCategorias();


      // === Mostrar dashboard ===
      loadingState.classList.add('hidden');
      errorState.classList.add('hidden');
      dashboardContent.classList.remove('hidden');

    } catch (err: any) {
      console.error('Error al cargar estadísticas:', err);
      loadingState.classList.add('hidden');
      errorState.classList.remove('hidden');
      errorMessage.textContent = err.message || 'Error de conexión. Verifica que el servidor esté corriendo.';
    }
  }

  // ===========================================================================
  // RETRY
  // ===========================================================================

  retryBtn?.addEventListener('click', cargarEstadisticas);

  // ===========================================================================
  // ADMIN GLOBAL - Panel de Control (logica en ../lib/godMode.ts)
  // ===========================================================================
  initGodMode();

</script>
