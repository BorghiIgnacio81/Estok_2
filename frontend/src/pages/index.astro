  function renderMembresiaBadge(m: any, userId: string, idx: number) {
    return `
      <div class="flex items-center gap-1.5 px-2 py-1 bg-gray-50 rounded border border-gray-200 text-xs">
        <span class="text-gray-700 font-medium">${m.estok_nombre}</span>
        ${m.role_nombre ? `<span class="text-gray-400">(${m.role_nombre})</span>` : ''}
        <button
          data-membresia-estok-id="${m.estok_id}"
