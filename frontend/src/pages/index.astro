  function bindAdminEventListeners(userId: string) {
    // Botones de eliminar usuario
    document.querySelectorAll('.adminDeleteBtn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const uid = (btn as HTMLElement).dataset.userId!;
        const userName = (btn as HTMLElement).dataset.userName!;
        const userUsername = (btn as HTMLElement).dataset.userUsername!;

        if (!confirm(`⚠️ ¿Estás SEGURO de eliminar a "${userName}" (@${userUsername})?\n\nEsta acción eliminará físicamente al usuario y TODOS sus datos asociados (membresías, objetos, etc.).\n\nNO SE PUEDE DESHACER.`)) {
          return;
        }
        if (!confirm(`CONFIRMACIÓN FINAL:\n¿Eliminar permanentemente a "${userName}" (@${userUsername})?`)) {
          return;
        }

        try {
          const token = localStorage.getItem('estok_access_token');
          const response = await fetch(`${API_BASE_URL}/usuarios/${uid}/admin-delete/`, {
            method: 'DELETE',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
          });

          if (!response.ok) {
            const errData = await response.json().catch(() => ({}));
            throw new Error(errData.error || errData.detail || `Error del servidor (${response.status})`);
          }

          const result = await response.json();
          showAdminSuccess(`✅ ${result.mensaje}`);
          cargarAdminUsuarios();
        } catch (err: any) {
          showAdminError(err.message || 'Error al eliminar usuario');
        }
      });
    });

    // Botones de asignar a Estok
    document.querySelectorAll('.adminAsignarBtn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const uid = (btn as HTMLElement).dataset.userId!;
        const estokSelectId = (btn as HTMLElement).dataset.estokSelect!;
        const roleSelectId = (btn as HTMLElement).dataset.roleSelect!;

        const estokSelect = document.getElementById(estokSelectId) as HTMLSelectElement;
        const roleSelect = document.getElementById(roleSelectId) as HTMLSelectElement;

        const estokId = estokSelect?.value;
        const roleId = roleSelect?.value || null;

        if (!estokId) {
          showAdminError('Debes seleccionar un Estok.');
          return;
        }

        try {
          const token = localStorage.getItem('estok_access_token');
          const response = await fetch(`${API_BASE_URL}/usuarios/${uid}/asignar-estok/`, {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ estok_id: estokId, role_id: roleId }),
          });

          if (!response.ok) {
            const errData = await response.json().catch(() => ({}));
            throw new Error(errData.error || errData.detail || `Error del servidor (${response.status})`);
          }

          const result = await response.json();
          showAdminSuccess(`✅ ${result.mensaje}`);
          cargarAdminUsuarios();
        } catch (err: any) {
          showAdminError(err.message || 'Error al asignar usuario a Estok');
        }
      });
    });

    // Botones de remover membresía
    document.querySelectorAll('.adminRemoverBtn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const uid = (btn as HTMLElement).dataset.userId!;
        const estokId = (btn as HTMLElement).dataset.membresiaEstokId!;
        const estokNombre = (btn as HTMLElement).dataset.estokNombre!;

        if (!confirm(`¿Quitar al usuario de "${estokNombre}"?`)) return;

        try {
          const token = localStorage.getItem('estok_access_token');
          const response = await fetch(`${API_BASE_URL}/usuarios/${uid}/remover-estok/?estok_id=${estokId}`, {
            method: 'DELETE',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
          });

          if (!response.ok) {
            const errData = await response.json().catch(() => ({}));
            throw new Error(errData.error || errData.detail || `Error del servidor (${response.status})`);
          }

          const result = await response.json();
          showAdminSuccess(`✅ ${result.mensaje}`);
          cargarAdminUsuarios();
        } catch (err: any) {
          showAdminError(err.message || 'Error al remover usuario del Estok');
        }
      });
    });
  }

  async function cargarAdminUsuarios() {
    adminLoading.classList.remove('hidden');
    adminUserList.classList.add('hidden');
    adminError.classList.add('hidden');
    adminSuccess.classList.add('hidden');

    try {
      // Cargar recursos primero (estoks, roles)
      await cargarAdminRecursos();

      const response = await fetch(`${API_BASE_URL}/usuarios/`, {
        headers: getAuthHeaders(),
      });

      if (!response.ok) {
        throw new Error(`Error del servidor (${response.status})`);
      }

      const usuarios = await response.json();
      const results = usuarios.results || usuarios;

      if (results.length === 0) {
        adminUserList.innerHTML = '<p class="text-sm text-gray-500 text-center py-4">No hay usuarios registrados.</p>';
      } else {
        const cachedUserJson = JSON.parse(localStorage.getItem('estok_user') || '{}');

        adminUserList.innerHTML = results.map((u: any) => {
          const displayName = u.display_name || u.username;
          const isSelf = u.id === cachedUserJson.id;
          const membresias = u.membresias || [];
          const rowId = `user-${u.id}`;

          // Mostrar badges de membresías existentes
          const badgesHtml = membresias.length > 0
            ? `<div class="flex flex-wrap gap-1 mt-1.5">${membresias.map((m: any, i: number) => renderMembresiaBadge(m, u.id, i)).join('')}</div>`
            : '<p class="text-xs text-gray-400 mt-1">Sin Estok asignado</p>';

          // Dropdown de asignación (oculto para el propio ygumy44 para evitar auto-remoción)
          const asignarHtml = !isSelf
            ? `<div class="flex items-center gap-1 mt-1.5">${renderEstoksDropdown(u.id, '', null, rowId)}</div>`
            : '';

          return `
            <div class="p-3 rounded-lg border border-gray-200 hover:bg-gray-50 transition-base">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center text-sm font-medium text-gray-700 flex-shrink-0">
                    ${(displayName.charAt(0) || '?').toUpperCase()}
                  </div>
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-gray-900 truncate">${displayName}</p>
                    <p class="text-xs text-gray-500">@${u.username} ${u.email ? `· ${u.email}` : ''}</p>
                  </div>
                </div>
                <div class="flex items-center gap-2 flex-shrink-0 ml-2">
                  ${u.is_active ? '<span class="text-xs text-green-600 font-medium">Activo</span>' : '<span class="text-xs text-red-600 font-medium">Inactivo</span>'}
                  ${!isSelf ? `
                    <button
                      data-user-id="${u.id}"
                      data-user-name="${displayName}"
                      data-user-username="${u.username}"
                      class="adminDeleteBtn px-3 py-1.5 bg-red-100 text-red-700 text-xs font-medium rounded-lg hover:bg-red-200 transition-base shadow-sm flex items-center gap-1"
                      title="Eliminar este usuario"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                      Eliminar
                    </button>
                  ` : '<span class="text-xs text-gray-400 italic">Tú</span>'}
                </div>
              </div>
              ${badgesHtml}
              ${asignarHtml}
            </div>
          `;
        }).join('');

        // Bind eventos
        bindAdminEventListeners('');
      }

      adminLoading.classList.add('hidden');
      adminUserList.classList.remove('hidden');
    } catch (err: any) {
      console.error('Error al cargar usuarios admin:', err);
      adminLoading.classList.add('hidden');
      adminUserList.innerHTML = '<p class="text-sm text-red-500 text-center py-4">Error al cargar usuarios.</p>';
      adminUserList.classList.remove('hidden');
    }
  }

  // Recargar con botón refresh
  adminRefreshBtn?.addEventListener('click', () => cargarAdminUsuarios());

  // Verificar si el usuario es ygumy44 y mostrar el panel
  function initAdminPanel() {
    try {
      const cachedUser = JSON.parse(localStorage.getItem('estok_user') || '{}');
