---
// =============================================================================
// PÁGINA PRINCIPAL - Dashboard Pro de Estok
// Con Chart.js, PWA Install, AI Heartbeat y estadísticas reales
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import AuthGuard from '../components/AuthGuard.astro';
import OnboardingBienvenida from '../components/OnboardingBienvenida.astro';
import GodModales from '../components/dashboard/GodModales.astro';

// Detección de plataforma móvil por User Agent
const userAgent = Astro.request.headers.get('user-agent') || '';
const isMobile = /Android|iPhone|iPad|iPod|webOS|BlackBerry|IEMobile|Opera Mini/i.test(userAgent);
---

<AuthGuard />

<BaseLayout title="Estok - Dashboard | Sistema de Inventario">
  <!-- Asistente de Bienvenida (primer inicio): si el usuario no tiene Estok, la
       pantalla completa del asistente reemplaza al panel ordinario (data-estok-panel). -->
  <OnboardingBienvenida />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" style="background-color: var(--bg-primary)" data-estok-panel>
    <!-- ================================================================ -->
    <!-- HERO SECTION - indicador IA en la cima + CTA principal "Nuevo Objeto" -->
    <!-- ================================================================ -->
    <div class="mb-8">
      <!-- Fila 1 - Cima del encabezado: indicador IA Conectada (por encima del título) -->
      <div class="flex items-center mb-3">
        <span id="aiStatusBadge" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-500 flex-shrink-0">
          <span id="aiStatusDot" class="w-2 h-2 rounded-full bg-gray-400"></span>
          <span id="aiStatusText">Verificando IA...</span>
        </span>
      </div>

      <!-- Fila 2 - Bloque de bienvenida (izquierda) + CTA "Nuevo Objeto" (derecha) -->
      <div class="flex flex-col lg:flex-row justify-between items-center gap-6 w-full">
        <div class="w-full">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900">
            Bienvenido a <span class="text-blue-700">Estok</span>
          </h1>
          <p class="mt-2 text-base sm:text-lg text-gray-500 max-w-3xl">
            Sistema de gestión de inventario personal con análisis por IA y taxonomía unificada por categorías
          </p>

          <!-- Panel de Control global (Admin Global): se abre/cierra desde el botón "Admin Global" del navbar (BaseLayout) -->

        </div>

        <div class="flex flex-col md:flex-row items-center gap-3 md:gap-4 w-full lg:w-auto">
          <!-- PWA Install Button (hero) - SOLO MÓVIL, no se renderiza en desktop -->
          {isMobile && (
            <button id="installPwaBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-green-600 text-white text-xs font-medium rounded-full hover:bg-green-700 transition-base shadow-sm flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Instalar App
            </button>
          )}
          <!-- ACCIONES RÁPIDAS EN PARALELO (md+): "Mudanza" y "Nuevo Objeto" van
               en la misma fila (flex flex-row gap-4 w-full) y se reparten el
               ancho en mitades simétricas con flex-1. La fila se acota con
               max-w-sm para que los dos bloques queden equilibrados y el hero
               no se estire de más. En móvil el wrapper apila la fila debajo del
               botón de instalación PWA para no comprimir las dos acciones. -->
          <div class="flex flex-row gap-4 w-full md:max-w-sm items-center justify-center">
            <!-- Botón Mudanza: se inyecta dinámicamente SOLO si user.estoks.length > 1 -->
            <span id="mudanzaBtnContainer" class="flex-1 min-w-0 flex items-center justify-center"></span>
            <!-- CTA principal - Nuevo Objeto: imagen local con fusión estética (reemplaza el botón de texto) -->
            <a href="/objetos/nuevo" class="flex-1 min-w-0 flex items-center justify-center" aria-label="Nuevo Objeto">
              <img src="/nuevo objeto.png" alt="Nuevo Objeto" class="h-24 md:h-32 lg:h-36 w-auto max-w-full hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer object-contain" />
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Estado de carga -->
    <div id="loadingState" class="text-center py-12">
      <svg class="animate-spin h-10 w-10 mx-auto text-blue-700 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <p class="text-gray-500">Cargando estadísticas...</p>
    </div>

    <!-- Estado de error -->
    <div id="errorState" class="hidden bg-red-50 border border-red-200 text-red-700 px-6 py-4 rounded-xl text-center mb-8">
      <p id="errorMessage" class="font-medium">Error al cargar estadísticas.</p>
      <button id="retryBtn" class="mt-3 px-4 py-2 bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition-base text-sm font-medium">
        Reintentar
      </button>
    </div>

    <!-- Dashboard Content -->
    <div id="dashboardContent" class="hidden space-y-8">
      <!-- ================================================================ -->
      <!-- MOSAICOS DE TOTALES (fila horizontal responsiva - arriba de todo) -->
      <!-- Total de Objetos · Valor Estimado · Ubicaciones · Contenedores    -->
      <!-- ================================================================ -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        <!-- Total de Objetos -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5 flex items-center gap-3">
          <div class="w-10 h-10 shrink-0 bg-blue-100 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-xs sm:text-sm text-gray-500 font-medium truncate">Total de Objetos</p>
            <p id="kpiTotalObjetos" class="text-2xl sm:text-3xl font-bold text-gray-900 leading-tight">—</p>
          </div>
        </div>

        <!-- Valor Estimado -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5 flex items-center gap-3">
          <div class="w-10 h-10 shrink-0 bg-green-100 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-xs sm:text-sm text-gray-500 font-medium truncate">Valor Estimado</p>
            <p id="kpiValorTotal" class="text-2xl sm:text-3xl font-bold text-green-700 leading-tight">—</p>
          </div>
        </div>

        <!-- Ubicaciones -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5 flex items-center gap-3">
          <div class="w-10 h-10 shrink-0 bg-purple-100 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-xs sm:text-sm text-gray-500 font-medium truncate">Ubicaciones</p>
            <p id="kpiUbicaciones" class="text-2xl sm:text-3xl font-bold text-gray-900 leading-tight">—</p>
          </div>
        </div>

        <!-- Contenedores -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5 flex items-center gap-3">
          <div class="w-10 h-10 shrink-0 bg-amber-100 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-xs sm:text-sm text-gray-500 font-medium truncate">Contenedores</p>
            <p id="kpiContenedores" class="text-2xl sm:text-3xl font-bold text-gray-900 leading-tight">—</p>
          </div>
        </div>
      </div>

      <!-- ================================================================ -->
      <!-- ANALÍTICAS NATIVAS (sin librerías externas)                     -->
      <!-- Izquierda: barras horizontales apiladas por usuario/decisión     -->
      <!-- Derecha: torta SVG nativa por categoría                          -->
      <!-- ================================================================ -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Barras horizontales apiladas: decisiones por usuario (2 cols) -->
        <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-1">Decisiones por Usuario</h2>
          <p class="text-xs text-gray-400 mb-4">Objetos por dueño original según la decisión registrada</p>

          <!-- Leyenda de decisiones -->
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 mb-5">
            <span class="inline-flex items-center gap-1.5 text-xs text-gray-600"><span class="w-2.5 h-2.5 rounded-sm bg-green-400"></span>Vender · Publicado</span>
            <span class="inline-flex items-center gap-1.5 text-xs text-gray-600"><span class="w-2.5 h-2.5 rounded-sm bg-green-700"></span>Vender · No publicado</span>
            <span class="inline-flex items-center gap-1.5 text-xs text-gray-600"><span class="w-2.5 h-2.5 rounded-sm bg-blue-600"></span>Conservar</span>
            <span class="inline-flex items-center gap-1.5 text-xs text-gray-600"><span class="w-2.5 h-2.5 rounded-sm bg-red-600"></span>Tirar</span>
            <span class="inline-flex items-center gap-1.5 text-xs text-gray-600"><span class="w-2.5 h-2.5 rounded-sm bg-orange-500"></span>Sin decisión</span>
          </div>

          <div id="barrasApiladasContainer" class="space-y-4">
            <p class="text-sm text-gray-400">Cargando...</p>
          </div>
        </div>

        <!-- Torta SVG nativa: distribución por categoría (1 col) -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-1">Distribución por Categoría</h2>
          <p class="text-xs text-gray-400 mb-4">Las 11 categorías oficiales del sistema</p>
          <div id="pieCategoriasContainer" class="flex flex-col items-center">
            <p class="text-sm text-gray-400 py-8">Cargando...</p>
          </div>
        </div>
      </div>

      <!-- ================================================================ -->
      <!-- BARRAS DE PROGRESO + ÚLTIMOS OBJETOS -->
      <!-- ================================================================ -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Estado de conservación -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Estado de Conservación</h2>
          <div id="estadosContainer" class="space-y-3">
            <p class="text-sm text-gray-400">Cargando...</p>
          </div>
        </div>

        <!-- Últimos objetos registrados -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Últimos Objetos</h2>
          <div id="ultimosContainer" class="space-y-3">
            <p class="text-sm text-gray-400">Cargando...</p>
          </div>
        </div>
      </div>

      <!-- ================================================================ -->
      <!-- CATEGORÍAS (cards dinámicas desde /api/categorias/) -->
      <!-- ================================================================ -->
      <div>
        <h2 class="text-xl font-bold text-gray-900 mb-4">Categorías del Sistema</h2>
        <div id="categoriasGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          <p class="text-sm text-gray-400 col-span-full">Cargando categorías...</p>
        </div>
      </div>
    </div>

    <!-- ================================================================ -->
    <!-- ADMIN GLOBAL - Panel de Control global (solo visible para ygumy44) -->
    <!-- Se abre/cierra con el botón "Admin Global" del navbar (BaseLayout) -->
    <!-- ================================================================ -->
    <div id="godPanel" class="hidden mt-8">
      <div class="bg-white rounded-xl shadow-sm border-2 border-red-200 overflow-hidden">
        <!-- Header del panel -->
        <div class="px-6 py-4 bg-red-50 border-b border-red-200 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="text-2xl">🛡️</span>
            <div>
              <h2 class="text-lg font-bold text-red-900">Admin Global</h2>
              <p class="text-sm text-red-500">Panel de control — usuarios y Estoks</p>
            </div>
          </div>
          <button id="godRefreshBtn" class="px-3 py-1.5 bg-red-100 text-red-700 text-xs font-medium rounded-lg hover:bg-red-200 transition-base flex items-center gap-1" title="Recargar ambos listados">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Recargar
          </button>
        </div>

        <!-- Feedback global -->
        <div id="godError" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm mx-6 mt-4"></div>
        <div id="godSuccess" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm mx-6 mt-4"></div>
        <div id="godLoading" class="hidden text-center py-10">
          <svg class="animate-spin h-8 w-8 mx-auto text-red-500 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <p class="text-sm text-gray-500">Cargando datos globales...</p>
        </div>

        <!-- Gestión de Estoks (ARRIBA) y Usuarios (ABAJO) - apilado vertical 100% ancho -->
        <div class="p-6 space-y-8">
          <!-- ================= GESTIÓN DE ESTOKS (ARRIBA) ================= -->
          <div>
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
              <h3 class="text-base font-bold text-gray-900">🏢 Gestión de Estoks</h3>
              <button id="godCrearEstokBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-red-700 hover:bg-red-800 text-white text-xs font-semibold rounded-lg transition-base shadow-sm">
                🏢 Crear Nuevo Estok
              </button>
            </div>
            <div class="overflow-x-auto rounded-lg border border-gray-200">
              <table class="min-w-full divide-y divide-gray-200 text-sm">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase tracking-wide">Nombre Estok</th>
                    <th class="px-3 py-2 text-center text-xs font-semibold text-gray-600 uppercase tracking-wide">Usuarios</th>
                    <th class="px-3 py-2 text-center text-xs font-semibold text-gray-600 uppercase tracking-wide">Objetos</th>
                    <th class="px-3 py-2 text-center text-xs font-semibold text-gray-600 uppercase tracking-wide">Ubicaciones</th>
                    <th class="px-3 py-2 text-center text-xs font-semibold text-gray-600 uppercase tracking-wide">Contenedores</th>
                    <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase tracking-wide">Acciones</th>
                  </tr>
                </thead>
                <tbody id="godEstoksTbody" class="bg-white divide-y divide-gray-200">
                  <tr><td colspan="6" class="px-3 py-6 text-center text-sm text-gray-400">Cargando Estoks...</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- ================= GESTIÓN DE USUARIOS (ABAJO) ================= -->
          <div>
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
              <h3 class="text-base font-bold text-gray-900">👥 Gestión de Usuarios</h3>
              <button id="godCrearUsuarioBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-red-700 hover:bg-red-800 text-white text-xs font-semibold rounded-lg transition-base shadow-sm">
                ➕ Crear Nuevo Usuario
              </button>
            </div>
            <div class="overflow-x-auto rounded-lg border border-gray-200">
              <table class="min-w-full divide-y divide-gray-200 text-sm">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase tracking-wide">Usuario</th>
                    <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase tracking-wide">Email</th>
                    <th class="px-3 py-2 text-left text-xs font-semibold text-gray-600 uppercase tracking-wide">Estoks Conectados</th>
                    <th class="px-3 py-2 text-center text-xs font-semibold text-gray-600 uppercase tracking-wide">Accesos</th>
                    <th class="px-3 py-2 text-right text-xs font-semibold text-gray-600 uppercase tracking-wide">Acciones</th>
                  </tr>
                </thead>
                <tbody id="godUsuariosTbody" class="bg-white divide-y divide-gray-200">
                  <tr><td colspan="5" class="px-3 py-6 text-center text-sm text-gray-400">Cargando usuarios...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- ================================================================ -->
    <!-- ADMIN GLOBAL - Sync del toggle (vanilla JS, sin dependencias)     -->
    <!-- El panel es dueño de su propia visibilidad: escucha el evento     -->
    <!-- global "estok:admin-open" que dispara el botón "Admin Global" del -->
    <!-- Navbar (BaseLayout) y alterna las clases Tailwind para expandir/  -->
    <!-- colapsar el panel de forma fluida.                                -->
    <!-- ================================================================ -->
    <script is:inline>
      (function () {
        function togglePanelAdminGlobal() {
          var panel = document.getElementById('godPanel');
          if (!panel) return;

          var oculto = panel.classList.toggle('hidden');

          // Sincronizar el estado activo de los botones del Navbar
          var btn = document.getElementById('godModeBtn');
          var btnMobile = document.getElementById('godModeBtnMobile');
          if (btn) btn.classList.toggle('is-open', !oculto);
          if (btnMobile) btnMobile.classList.toggle('is-open', !oculto);

          // Desplazamiento suave hacia el panel cuando se expande
          if (!oculto && panel.scrollIntoView) {
            panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }

        window.addEventListener('estok:admin-open', togglePanelAdminGlobal);
      })();
    </script>

    <!-- ADMIN GLOBAL - Modales (usuario/estok) extraidos a componente -->
    <GodModales />
  </div>


<script>
  // Fase A (refactor preventivo): la logica del Dashboard se modularizo en
  // src/lib/dashboard/ (tipos, IA, PWA, graficos y orquestador de estadisticas).
  import '../lib/dashboard/estadisticas';
</script>
