      <option value="${r.id}" ${(r.id === currentRoleId) ? 'selected' : ''}>
        ${r.name}
      </option>
    `).join('');

    return `
      <select id="select-estok-${rowId}" class="text-xs border border-gray-300 rounded px-2 py-1 bg-white max-w-[140px]" onchange="window._adminEstokChanged && window._adminEstokChanged('${rowId}', '${userId}')">
        <option value="">-- Sin Estok --</option>
        ${opciones}
      </select>
      <select id="select-role-${rowId}" class="text-xs border border-gray-300 rounded px-2 py-1 bg-white max-w-[120px]">
