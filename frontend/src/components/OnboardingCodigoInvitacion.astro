---
// =============================================================================
// COMPONENTE OnboardingCodigoInvitacion
// Modal flotante centrado del Asistente de Bienvenida para ingresar con un
// código de invitación y entrar a un Estok (Tenant) YA existente.
// La lógica vive en src/lib/onboarding/codigoInvitacion.ts (ModalCodigoInvitacion):
// este componente es solo la vista. Se renderiza DENTRO de #onbRoot para
// compartir su scope de DOM con el controlador del asistente.
// =============================================================================
---

<div
  id="onbCodigoModal"
  class="hidden fixed inset-0 z-[9991] items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="onbCodigoTitulo"
>
  <div id="onbCodigoBackdrop" class="absolute inset-0 bg-black/50"></div>

  <div class="relative z-10 w-full max-w-md bg-white rounded-2xl shadow-2xl border border-white overflow-hidden">
    <!-- Encabezado del modal -->
    <div class="flex items-start justify-between px-6 py-4 border-b border-gray-200">
      <div>
        <h3 id="onbCodigoTitulo" class="text-lg font-bold text-gray-900">Usar código de invitación</h3>
        <p class="text-xs text-gray-500 mt-0.5">Unite al Estok que te compartieron</p>
      </div>
      <button type="button" id="onbCodigoCerrar" aria-label="Cerrar"
        class="p-1 -mr-1 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-base">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Cuerpo: campo de código + acciones -->
    <div class="p-6 space-y-4">
      <div>
        <label for="onbCodigoInput" class="block text-sm font-semibold text-gray-700 mb-1">Código de invitación</label>
        <input
          id="onbCodigoInput"
          type="text"
          maxlength="20"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          placeholder="Ej: EST-XXXXXXXX"
          class="w-full px-4 py-3 border border-gray-300 rounded-2xl text-base font-mono tracking-wider uppercase focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base"
        />
      </div>

      <p id="onbCodigoError" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm"></p>

      <div class="flex flex-col sm:flex-row gap-3">
        <button type="button" id="onbCodigoVincular"
          class="flex-1 px-6 py-3.5 bg-blue-700 hover:bg-blue-800 text-white text-base font-bold rounded-2xl shadow-md transition-base">
          Vincular Estok
        </button>
        <button type="button" id="onbCodigoCancelar"
          class="px-6 py-3.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-2xl transition-base">
          Cancelar
        </button>
      </div>
    </div>
  </div>
</div>
