---
// =============================================================================
// MODAL DE ÉXITO DE LA CARGA MANUAL DE OBJETO (/objetos/nuevo)
// -----------------------------------------------------------------------------
// Extraído de pages/objetos/nuevo.astro para dejar la página enfocada en la
// estructura semántica del formulario (regla de modularización <400 líneas).
// Marcado PURO: se abre SOLO cuando el backend confirma 201 Created. Los ids
// canónicos (#exitoModal / #cargarOtroBtn / #volverInicioBtn) los consume
// src/lib/objetos/objetoFormCore.ts (abrirModalExito / cerrarModalExito). No
// cambia clases ni estructura.
// =============================================================================
---

<!-- ================================================================ -->
<!-- MODAL DE ÉXITO - Cierre de flujo direccional tras guardar objeto -->
<!-- Oculta por defecto. Se abre solo cuando el backend confirma 201. -->
<!-- ================================================================ -->
<div
  id="exitoModal"
  class="hidden fixed inset-0 z-50 flex items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exitoModalTitulo"
>
  <!-- Backdrop con blur para detener el flujo visual -->
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <!-- Tarjeta premium mimetizada con la textura de fondo de la app -->
  <div
    class="relative w-full max-w-sm overflow-hidden rounded-2xl shadow-2xl ring-1 ring-black/10"
    style="background-color: var(--bg-primary)"
  >
    <div class="px-8 pb-8 pt-10 text-center">
      <!-- Icono central de verificación -->
      <div
        class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-white/70 text-3xl shadow-inner ring-1 ring-black/5"
      >
        ✅
      </div>
      <h2 id="exitoModalTitulo" class="text-xl font-bold text-gray-900">
        Objeto cargado exitosamente
      </h2>
      <p class="mt-1 text-sm text-gray-600">
        El objeto fue grabado en el inventario.
      </p>
    </div>

    <!-- Fila horizontal de acciones direccionales -->
    <div class="flex gap-3 border-t border-black/5 bg-white px-6 py-5">
      <button
        id="cargarOtroBtn"
        type="button"
        class="flex-1 rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-base hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
      >
        Cargar otro
      </button>
      <button
        id="volverInicioBtn"
        type="button"
        class="flex-1 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 transition-base hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
      >
        Volver al inicio
      </button>
    </div>
  </div>
</div>
