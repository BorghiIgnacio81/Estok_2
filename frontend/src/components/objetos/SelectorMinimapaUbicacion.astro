---
// =============================================================================
// SELECTOR DE UBICACIÓN POR MINIMAPAS INTERACTIVOS (Nuevo / Editar Objeto)
// -----------------------------------------------------------------------------
// ÚNICA cara Astro de la navegación espacial de objetos: reemplaza a la vieja
// nav en árbol estilo carpetas Y al grid de tarjetas de ancho fijo.
//
// ESTÁNDAR ÚNICO: este bloque NO dibuja nada por su cuenta. Monta el COMPONENTE
// GLOBAL `components/MinimapaRuta.astro` en sus dos formatos:
//
//   1. CADENA de orientación (#minimapaNiveles): migaja de siluetas asimétricas
//      (planta → habitación → mueble → caja) con el nivel activo en naranja.
//   2. PLANO A ESCALA (#minimapaLienzo): UN plano elástico del nivel visible,
//      amoldado al ancho real de la tarjeta «Ubicación de Almacenamiento». Cada
//      sector conserva su ui_width/ui_height real (porcentajes del lienzo) y el
//      sector guardado actual se pinta en NARANJA (#f97316). Tocar un sector
//      navega al nivel siguiente (data-sector-id → lib/selectorMinimapaNuevoObjeto.ts).
//
// Sin doble columna, sin anchos en px y sin listado de texto duplicado: la
// geometría la aporta 100% el motor global (src/lib/minimapa.ts).
//
// Los inputs ocultos conservan los nombres canónicos (`ubicacion` y
// `contenedor`): el POST multipart a /api/objetos/ no cambia en absoluto.
//
// Estilos: las clases `.minimapa-ruta*` viven en la hoja propia del componente
// (styles/minimapa-ruta.css) y las `.mini-anidado-*` en styles/almacenamiento-
// portales.css. No se duplican reglas acá.
// =============================================================================

import MinimapaRuta from '../MinimapaRuta.astro';

interface Props {
  ubicacionSeleccionada?: string;
  contenedorSeleccionado?: string;
}

const { ubicacionSeleccionada = '', contenedorSeleccionado = '' } = Astro.props;
---

<!-- Columna vertical natural del formulario: `w-full min-w-0` impide que un mapa
     ancho empuje el layout hacia los costados (no hay doble columna lateral). -->
<div class="w-full min-w-0 space-y-3">
  <!-- 1. CADENA DE ORIENTACIÓN (componente global encapsulado). -->
  <MinimapaRuta id="minimapaNiveles" class="minimapa-ruta-cadena" />

  <!-- 2. PLANO A ESCALA (mismo componente, formato elástico): PUNTO DE MONTAJE
       del plano del nivel visible. El plano NO se dibuja acá: lo emite el motor
       del componente global (`minimapaSectoresSvg` con `responsive: true` dentro
       de `.minimapa-ruta.minimapa-ruta-plano`) y
       selectorMinimapaNuevoObjetoRender.ts solo lo inyecta en caliente. El host
       se deja NEUTRO a propósito (sin caja gris, sin grilla) para que las únicas
       paredes visibles sean las del plano proporcional del componente, con su
       fondo crema, su borde negro de puntas redondeadas y el ambiente actual en
       NARANJA (#f97316). -->
  <div
    id="minimapaLienzo"
    class="w-full min-w-0"
    data-minimapa-montaje
    role="group"
    aria-label="Navegación visual de la ubicación del objeto"
  ></div>

  <!-- Inputs ocultos canónicos: viajan idénticos a Django (sin cambios de API) -->
  <input type="hidden" name="ubicacion" id="ubicacionSeleccionada" value={ubicacionSeleccionada} />
  <input type="hidden" name="contenedor" id="contenedorSeleccionado" value={contenedorSeleccionado} />
</div>

<script>
  import { iniciarSelectorMinimapaUbicacion } from '../../lib/selectorMinimapaNuevoObjeto';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => iniciarSelectorMinimapaUbicacion());
  } else {
    iniciarSelectorMinimapaUbicacion();
  }
</script>
