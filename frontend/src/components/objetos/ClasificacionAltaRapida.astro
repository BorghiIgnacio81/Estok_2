---
// =============================================================================
// ALTA RÁPIDA · ¿ES UNA CAJA O CONTENEDOR? (Lote 31 · punto 4)
// -----------------------------------------------------------------------------
// Dos disyuntores OPCIONALES y mutuamente excluyentes para clasificar el objeto
// en el mismo momento del alta. Sólo una marca MANUAL del operador pone
// `Objeto.es_contenedor = true`:
//   · 📦 Caja   → contenedor transportable (se muda con su contenido).
//   · 🚪 Mueble → contenedor fijo del ambiente (estantería, armario, cómoda).
//
// Qué persiste (sin migraciones; ver lib/objetos/objetoClasificacionAlta.ts):
//   · `es_contenedor = true` en Objeto.
//   · `especificaciones.alta_rapida = 'caja' | 'mueble'` (JSON libre del objeto),
//     que conserva la DISTINCIÓN elegida.
// Sin ninguna casilla marcada el objeto se crea como objeto simple
// (`es_contenedor = false`): es el DEFAULT de todo objeto nuevo, aunque su
// categoría sea Muebles, Materiales o Herramientas.
//
// CAJA LLENA / LOTE EN FOTO: al declarar Caja o Mueble se despliega el
// checkbox «🔒 Caja llena (contenido en foto / lote)»; al tildarlo aparece la
// «Cantidad estimada de objetos en el lote» (opcional). Ambos se leen del DOM
// al enviar (`esta_llena` + `cantidad_objetos_lote`).
//
// El control NO lleva `name` a propósito: no viaja en el FormData del formulario
// ni en la persistencia de sessionStorage. El módulo lee su estado del DOM en el
// momento del envío (lib/objetos/objetoFormCore.ts → camposClasificacionAlta()).
// =============================================================================

export interface Props {
  /** Texto de ayuda bajo los disyuntores. */
  ayuda?: string;
}

const {
  ayuda = 'Opcional: marcá una casilla SOLO si este objeto es un contenedor de otros objetos (caja, baúl, maleta, organizador) o un mueble que los aloja. Sin marcar nada se guarda como objeto simple: es_contenedor = false.',
} = Astro.props as Props;

// Tarjetas de opción: UN solo bloque de marcado parametrizado para las dos
// alternativas (evita duplicar HTML) — el data-* es el gancho de la lógica.
const opciones = [
  {
    valor: 'caja',
    icono: '📦',
    titulo: 'Caja',
    detalle: 'Contenedor transportable: se puede mudar con su contenido.',
  },
  {
    valor: 'mueble',
    icono: '🚪',
    titulo: 'Mueble',
    detalle: 'Contenedor fijo del ambiente: estantería, armario, cómoda.',
  },
];
---

<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
  <div class="flex flex-wrap items-center gap-2 mb-4">
    <h2 class="text-lg font-semibold text-gray-900">¿Es una caja o contenedor?</h2>
    <span class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 text-[11px] font-semibold">opcional</span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    {opciones.map((opcion) => (
      <label
        data-alta-opcion={opcion.valor}
        class="flex items-start gap-3 p-3 rounded-lg border-2 border-gray-200 hover:border-orange-300 cursor-pointer transition-base"
      >
        <input
          type="checkbox"
          data-alta-clasificacion={opcion.valor}
          class="mt-0.5 w-5 h-5 shrink-0 accent-orange-600 cursor-pointer"
        />
        <span class="min-w-0">
          <span class="block text-sm font-semibold text-gray-900">{opcion.icono} {opcion.titulo}</span>
          <span class="block text-xs text-gray-500">{opcion.detalle}</span>
        </span>
      </label>
    ))}
  </div>

  <!-- CAJA LLENA / LOTE EN FOTO: se despliega SOLO al declarar Caja o Mueble
       (visibilidad condicional que gobierna lib/objetos/objetoClasificacionAlta.ts).
       El checkbox y su cantidad NO llevan `name`: se leen del DOM al enviar, igual
       que los disyuntores de clasificación. -->
  <div id="altaCajaLlenaRow" class="mt-4 hidden rounded-lg border border-orange-200 bg-orange-50/60 p-3">
    <label for="altaEstaLlena" class="flex items-start gap-2.5 cursor-pointer">
      <input
        id="altaEstaLlena"
        type="checkbox"
        data-alta-caja-llena
        class="mt-0.5 w-5 h-5 shrink-0 accent-orange-600 cursor-pointer"
      />
      <span class="min-w-0">
        <span class="block text-sm font-semibold text-gray-900">
          🔒 Caja llena <span class="font-normal text-gray-600">(contenido en foto / lote)</span>
        </span>
        <span class="block text-xs text-gray-500">
          El contenido ya está fotografiado como lote: no se carga objeto por objeto.
        </span>
      </span>
    </label>

    <div id="altaCantidadLoteRow" class="mt-3 hidden pl-8">
      <label for="altaCantidadLote" class="block text-xs font-semibold text-gray-600 mb-1">
        Cantidad estimada de objetos en el lote
        <span class="font-normal text-gray-400">(opcional)</span>
      </label>
      <input
        id="altaCantidadLote"
        type="number"
        min="1"
        step="1"
        inputmode="numeric"
        placeholder="Ej: 40"
        class="w-full max-w-[12rem] px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-base text-sm"
      />
    </div>
  </div>

  <p class="mt-3 text-xs text-gray-500">{ayuda}</p>
</div>

<style is:global>
  /* Resalte de la opción activa. En `is:global` a propósito: el MISMO control se
     reusa en el tutorial de onboarding (paso 4), donde los estilos scoped de
     Astro del componente no alcanzarían a las instancias ya montadas. */
  [data-alta-opcion].alta-opcion-activa {
    border-color: #f97316;
    background-color: #fff7ed;
  }
</style>
