---
// =============================================================================
// CAMPOS DEL FORMULARIO DE ALTA DE OBJETO (orquestador de componentes)
// -----------------------------------------------------------------------------
// Este archivo es SOLO composición: cada bloque vive en su propio componente
// atómico para no volver a inflar el formulario (regla de modularización <400
// líneas por archivo de UI).
//
//   1. CapturaFotosCompacta   → drag & drop compacto y simétrico + cámara/galería
//                               (incluye el ÚNICO botón "Autocompletar con IA")
//   2. Datos Básicos          → campos + progreso/resultado del análisis con IA
//   3. Ubicación              → SELECTOR DE MINIMAPAS INTERACTIVOS (siluetas
//                               elásticas de plantas, habitaciones y muebles)
//   4. LegadoTrazabilidad     → dueño original (con alta de dueño EXTERNO "+")
//
// Los `name` de los campos no cambiaron: el POST a /api/objetos/ es idéntico.
// =============================================================================

import CategoriaCreator from '../CategoriaCreator.astro';
import CapturaFotosCompacta from './CapturaFotosCompacta.astro';
import AutocompletarIA from './AutocompletarIA.astro';
import SelectorMinimapaUbicacion from './SelectorMinimapaUbicacion.astro';
import LegadoTrazabilidad from './LegadoTrazabilidad.astro';

interface Props {
  /** Ubicación preseleccionada (input oculto `ubicacion`). */
  ubicacion?: string;
  /** Contenedor preseleccionado (input oculto `contenedor`). */
  contenedor?: string;
}

const { ubicacion = '', contenedor = '' } = Astro.props as Props;
---

      <!-- ============================================================================== -->
      <!-- SECCION: CAPTURA DE FOTO (compacta + drag & drop) -->
      <!-- ============================================================================== -->
      <CapturaFotosCompacta />

      <!-- ============================================================================== -->
      <!-- SECCION: DATOS BASICOS (progreso/resultado de IA; el botón IA está en Fotos) -->
      <!-- ============================================================================== -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Datos Básicos</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Progreso/resultado de la IA (el botón vive en Fotos del Objeto) -->
          <AutocompletarIA />

          <div class="sm:col-span-2">
            <label for="nombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre del objeto <span class="text-red-500">*</span></label>
            <input id="nombre" name="nombre" type="text" required placeholder="Ej: iPhone 14 Pro, El Principito, Sillón de cuero"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
          </div>
          <div class="sm:col-span-2">
            <label for="descripcion" class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
            <textarea id="descripcion" name="descripcion" rows={3} placeholder="Describe el objeto, su estado, historia o cualquier detalle relevante..."
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base"></textarea>
          </div>
          <div>
            <label for="categoria" class="block text-sm font-medium text-gray-700 mb-1">Categoría <span class="text-red-500">*</span></label>
            <!-- Contenedor simétrico: el select crece (flex-1) y la imagen "Nueva Categoría"
                 se alinea centrada al lado. En pantallas chicas hace wrap y no colapsa. -->
            <div class="flex flex-wrap items-center gap-4">
              <select id="categoria" name="categoria" required
                class="flex-1 min-w-[160px] px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base bg-white">
                <option value="">Sin categoría</option>
              </select>
              <!-- Botón "Nueva Categoría" como imagen física local (identidad texturizada ESTOK) -->
              <CategoriaCreator />
            </div>
            <p class="mt-1 text-xs text-gray-400">Selecciona la categoría oficial (11 categorías de Mercado Libre) o crea una personalizada.</p>
          </div>
          <div>
            <label for="estado_conservacion" class="block text-sm font-medium text-gray-700 mb-1">Estado de conservación</label>
            <select id="estado_conservacion" name="estado_conservacion"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base bg-white">
              <option value="excelente">Excelente</option>
              <option value="bueno" selected>Bueno</option>
              <option value="regular">Regular</option>
              <option value="malo">Malo</option>
              <option value="muy_malo">Muy malo</option>
            </select>
          </div>
          <div>
            <label for="color" class="block text-sm font-medium text-gray-700 mb-1">Color</label>
            <input id="color" name="color" type="text" placeholder="Ej: Rojo, Negro, Plateado"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
          </div>
          <div>
            <label for="valor_estimado" class="block text-sm font-medium text-gray-700 mb-1">Valor estimado (USD)</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">$</span>
              <input id="valor_estimado" name="valor_estimado" type="number" step="0.01" min="0" placeholder="0.00"
                class="w-full pl-8 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
            </div>
            <button type="button" id="estimarPrecioBtn"
              class="mt-2 inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-blue-700 bg-blue-50 border border-blue-200 rounded-lg hover:bg-blue-100 transition-base disabled:opacity-50 disabled:cursor-not-allowed">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <span id="estimarPrecioText">Buscar precio de referencia</span>
              <span id="estimarPrecioSpinner" class="hidden">
                <svg class="animate-spin h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </span>
            </button>
            <div id="precioReferencia" class="mt-2 text-xs hidden"></div>
          </div>
        </div>
      </div>

      <!-- ============================================================================== -->
      <!-- SECCION: UBICACION DE ALMACENAMIENTO CON MINIMAPAS INTERACTIVOS -->
      <!-- La taxonomía es unificada: el único selector de clasificación es "Categoría". -->
      <!-- ============================================================================== -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
          <div>
            <h2 class="text-lg font-semibold text-gray-900">Ubicación de Almacenamiento</h2>
            <p class="text-xs text-gray-500 mt-1">
              Navegá las siluetas del Estok: planta → habitación → mueble → caja.
            </p>
          </div>
          <!-- Creación rápida in-place: los modales viven en nuevo.astro (sin recargar la
               página). Los botones de texto fueron reemplazados por imágenes físicas
               locales; los ids kebab-case se corresponden con los listeners de nuevo.astro. -->
          <div class="flex flex-wrap items-center gap-4">
            <img src="/nueva ubicacion.png" alt="Nueva Ubicación" id="btn-nueva-ubicacion"
              class="h-20 w-auto hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer object-contain" />
            <img src="/Nuevo Contenedor.png" alt="Nuevo Contenedor" id="btn-nuevo-contenedor"
              class="h-20 w-auto hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer object-contain" />
          </div>
        </div>
        <SelectorMinimapaUbicacion
          ubicacionSeleccionada={ubicacion}
          contenedorSeleccionado={contenedor}
        />
      </div>

      <!-- ============================================================================== -->
      <!-- SECCION: LEGADO Y TRAZABILIDAD (dueño original + dueño externo + beneficiario) -->
      <!-- ============================================================================== -->
      <LegadoTrazabilidad />

