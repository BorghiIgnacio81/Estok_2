---
// =============================================================================
// LEGADO Y TRAZABILIDAD (Dueño original / Beneficiario)
// -----------------------------------------------------------------------------
// Dueño original: combobox de usuarios del Estok + botón «+» para registrar un
// DUEÑO EXTERNO que NO es usuario de la plataforma. Ese nombre se guarda como
// STRING PLANO en el campo `dueno_externo_nombre` (metadata, columna de
// PostgreSQL) y viaja al backend junto al resto del formulario.
//
// REGLA DE NEGOCIO: si el objeto queda con Dueño lleno (usuario O externo) y el
// Beneficiario VACÍO, el backend abre automáticamente una VOTACIÓN PENDIENTE
// para que todo el Estok decida (pestaña Decisiones). El aviso está abajo.
//
// Widget autocontenido: su lógica de UI vive en este mismo componente (no infla
// el orquestador nuevo.astro) y solo sincroniza los inputs del formulario.
// =============================================================================
---

<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
  <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>
    Legado y Trazabilidad
  </h2>
  <p class="text-sm text-gray-500 mb-4">
    Definen quién fue el dueño original del objeto y quién es el beneficiario designado.
    Si cargás un dueño y dejás el beneficiario vacío, el Estok votará el destino del objeto
    en la pestaña <strong>Decisiones</strong>.
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <!-- DUEÑO ORIGINAL + alta de dueño externo -->
    <div>
      <label for="dueno_original" class="block text-sm font-medium text-gray-700 mb-1">Dueño original</label>
      <div class="flex items-stretch gap-2">
        <select id="dueno_original" name="dueno_original"
          class="flex-1 min-w-0 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base bg-white">
          <option value="">Seleccionar dueño original...</option>
        </select>
        <button type="button" id="btnDuenoExterno" title="Registrar un dueño que no usa la plataforma"
          aria-label="Registrar dueño externo"
          class="shrink-0 w-10 rounded-lg border-2 border-dashed border-blue-300 bg-blue-50 text-blue-700 text-xl font-bold leading-none hover:bg-blue-100 hover:border-blue-400 transition-base cursor-pointer">
          +
        </button>
      </div>

      <!-- Nombre plano del dueño externo (metadata) -->
      <input type="hidden" name="dueno_externo_nombre" id="dueno_externo_nombre" value="" />

      <!-- Formulario inline de alta del dueño externo (oculto) -->
      <div id="duenoExternoForm" class="hidden mt-2 p-3 bg-blue-50 border border-blue-200 rounded-lg">
        <label for="duenoExternoInput" class="block text-xs font-medium text-blue-800 mb-1">
          Nombre del dueño (no es usuario de la plataforma)
        </label>
        <div class="flex items-stretch gap-2">
          <input id="duenoExternoInput" type="text" maxlength="200" placeholder="Ej: Abuelo Juan Pérez"
            class="flex-1 min-w-0 px-3 py-2 text-sm border border-blue-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
          <button type="button" id="guardarDuenoExternoBtn"
            class="px-3 py-2 text-sm font-medium bg-blue-700 text-white rounded-lg hover:bg-blue-800 transition-base">
            Guardar
          </button>
          <button type="button" id="cancelarDuenoExternoBtn"
            class="px-3 py-2 text-sm font-medium bg-white text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-100 transition-base">
            Cancelar
          </button>
        </div>
        <p class="text-[11px] text-blue-700 mt-1">
          Se guarda como texto plano en la ficha del objeto (no crea una cuenta de usuario).
        </p>
      </div>

      <!-- Chip del dueño externo registrado -->
      <div id="duenoExternoChip" class="hidden mt-2 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-medium">
        <span id="duenoExternoChipTexto"></span>
        <button type="button" id="quitarDuenoExternoBtn" title="Quitar dueño externo"
          class="text-blue-700 hover:text-blue-900 font-bold leading-none cursor-pointer">×</button>
      </div>
    </div>

    <!-- BENEFICIARIO -->
    <div>
      <label for="beneficiario" class="block text-sm font-medium text-gray-700 mb-1">Beneficiario</label>
      <select id="beneficiario" name="beneficiario"
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base bg-white">
        <option value="">Seleccionar beneficiario...</option>
      </select>
      <p id="avisoVotacion" class="hidden mt-2 p-2 bg-amber-50 border border-amber-200 rounded-lg text-[11px] text-amber-800">
        🗳️ Dueño cargado sin beneficiario: al guardar se abrirá una votación pendiente en Decisiones.
      </p>
    </div>
  </div>
</div>


<script>
  // ---------------------------------------------------------------------------
  // ALTA / BAJA DE DUEÑO EXTERNO (metadata plana `dueno_externo_nombre`)
  // ---------------------------------------------------------------------------
  const btnDuenoExterno = document.getElementById('btnDuenoExterno') as HTMLButtonElement | null;
  const formExterno = document.getElementById('duenoExternoForm') as HTMLElement | null;
  const inputExterno = document.getElementById('duenoExternoInput') as HTMLInputElement | null;
  const guardarExternoBtn = document.getElementById('guardarDuenoExternoBtn') as HTMLButtonElement | null;
  const cancelarExternoBtn = document.getElementById('cancelarDuenoExternoBtn') as HTMLButtonElement | null;
  const chipExterno = document.getElementById('duenoExternoChip') as HTMLElement | null;
  const chipExternoTexto = document.getElementById('duenoExternoChipTexto') as HTMLElement | null;
  const quitarExternoBtn = document.getElementById('quitarDuenoExternoBtn') as HTMLButtonElement | null;
  const inputExternoOculto = document.getElementById('dueno_externo_nombre') as HTMLInputElement | null;
  const selectDueno = document.getElementById('dueno_original') as HTMLSelectElement | null;
  const selectBeneficiario = document.getElementById('beneficiario') as HTMLSelectElement | null;
  const avisoVotacion = document.getElementById('avisoVotacion') as HTMLElement | null;

  /** Refresca chip + aviso de votación según la selección actual. */
  function refrescarLegado(): void {
    const nombreExterno = (inputExternoOculto?.value || '').trim();
    const tieneDueno = Boolean(selectDueno?.value) || Boolean(nombreExterno);
    const tieneBeneficiario = Boolean(selectBeneficiario?.value);

    if (chipExterno && chipExternoTexto) {
      if (nombreExterno) {
        chipExternoTexto.textContent = `Dueño externo: ${nombreExterno}`;
        chipExterno.classList.remove('hidden');
      } else {
        chipExterno.classList.add('hidden');
      }
    }
    if (avisoVotacion) {
      avisoVotacion.classList.toggle('hidden', !(tieneDueno && !tieneBeneficiario));
    }
    // El cambio también alimenta la persistencia en sessionStorage del formulario.
    inputExternoOculto?.dispatchEvent(new Event('change', { bubbles: true }));
  }

  btnDuenoExterno?.addEventListener('click', () => {
    formExterno?.classList.remove('hidden');
    if (inputExterno) {
      inputExterno.value = (inputExternoOculto?.value || '').trim();
      inputExterno.focus();
    }
  });

  cancelarExternoBtn?.addEventListener('click', () => formExterno?.classList.add('hidden'));

  function guardarDuenoExterno(): void {
    const nombre = (inputExterno?.value || '').trim();
    if (!nombre) {
      inputExterno?.focus();
      return;
    }
    if (inputExternoOculto) inputExternoOculto.value = nombre;
    // Dueño externo y dueño usuario son excluyentes en la interfaz: el backend
    // acepta cualquiera de los dos (el externo como texto plano).
    if (selectDueno) selectDueno.value = '';
    formExterno?.classList.add('hidden');
    refrescarLegado();
  }

  guardarExternoBtn?.addEventListener('click', guardarDuenoExterno);
  inputExterno?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      guardarDuenoExterno();
    }
  });

  quitarExternoBtn?.addEventListener('click', () => {
    if (inputExternoOculto) inputExternoOculto.value = '';
    refrescarLegado();
  });

  selectDueno?.addEventListener('change', refrescarLegado);
  selectBeneficiario?.addEventListener('change', refrescarLegado);

  refrescarLegado();

  // La página rellena los comboboxes de forma asíncrona: avisa por este evento
  // para recalcular el aviso de votación pendiente.
  window.addEventListener('estok:usuariosCargados', refrescarLegado);
</script>
