---
// =============================================================================
// FORMULARIO COMPACTO DE OBJETO (Paso 4 del Asistente de Bienvenida)
// -----------------------------------------------------------------------------
// Reutiliza la MISMA interfaz modular del formulario real de /objetos/nuevo
// (components/objetos/ObjetoFormFields.astro) para evitar inconsistencias de
// visualización: mismos ids/names/clases y los componentes atómicos vivos
//   · CategoriaCreator   → alta rápida de categorías (imagen física + modal).
//   · LegadoTrazabilidad → dueño original (con alta de dueño EXTERNO) y beneficiario.
// Los `name` NO cambian: el objeto se envía con el MISMO contrato que el backend
// ya acepta (nombre, descripcion, categoria, valor_estimado, dueno_*).
// =============================================================================

import CategoriaCreator from '../CategoriaCreator.astro';
import LegadoTrazabilidad from '../objetos/LegadoTrazabilidad.astro';
---

<div class="space-y-4">
  <!-- DATOS BÁSICOS (mismo bloque que el formulario real, en formato compacto) -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
    <h2 class="text-base font-semibold text-gray-900 mb-4">Datos Básicos</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="sm:col-span-2">
        <label for="nombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre del objeto <span class="text-red-500">*</span></label>
        <input id="nombre" name="nombre" type="text" maxlength="300" autocomplete="off"
          placeholder="Ej: Taladro, El Principito, Sillón de cuero"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
      </div>
      <div class="sm:col-span-2">
        <label for="descripcion" class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
        <textarea id="descripcion" name="descripcion" rows={2} placeholder="Describe el objeto, su estado o cualquier detalle relevante..."
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base"></textarea>
      </div>
      <div>
        <label for="categoria" class="block text-sm font-medium text-gray-700 mb-1">Categoría</label>
        <div class="flex flex-wrap items-center gap-3">
          <select id="categoria" name="categoria"
            class="flex-1 min-w-[140px] px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base bg-white">
            <option value="">Sin categoría</option>
          </select>
          <CategoriaCreator class="h-10 w-auto hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer object-contain" />
        </div>
      </div>
      <div>
        <label for="valor_estimado" class="block text-sm font-medium text-gray-700 mb-1">Valor estimado (USD)</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">$</span>
          <input id="valor_estimado" name="valor_estimado" type="number" step="0.01" min="0" placeholder="0.00"
            class="w-full pl-8 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
        </div>
      </div>
    </div>
  </div>

  <!-- LEGADO Y TRAZABILIDAD (dueño original / beneficiario) — componente real -->
  <LegadoTrazabilidad />
</div>
