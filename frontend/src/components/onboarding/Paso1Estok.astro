---
// =============================================================================
// COMPONENTE Paso1Estok — ALTA CANÓNICA DEL INQUILINATO (Paso 1 del Onboarding)
// -----------------------------------------------------------------------------
// FUENTE ÚNICA DE VERDAD del alta de un Estok. Lo consumen:
//   · components/OnboardingBienvenida.astro → Paso 1 del asistente (usuario común)
//   · pages/estoks/index.astro             → alta desde el panel admin
// Al enviarse llama al inicializador canónico `fundarEstok()`
// (lib/onboarding/api), que crea el Estok (POST /api/estoks/ con cantidad_pisos),
// lo deja ACTIVO (localStorage + backend → header X-Estok-Id) y devuelve la
// ficha creada. Emite en `window` el evento `estok:paso1-completado` con
// { estok, pisos } para que el anfitrión navegue según su contexto.
//
// Los ids (#onbNombreEstok / #onbCantidadPisos / #onbErrorPaso1 / #onbPaso1Ok /
// #onbFundarBtn) son los canónicos: el asistente los usa para su mensajería
// (omitirTutorial escribe el error en #onbErrorPaso1 dentro de su root).
//
// DESTINO POST-ALTA: este componente NO navega (el asistente necesita avanzar al
// Paso 2 sin recargar). La pantalla de destino canónica vive en la FUENTE ÚNICA
// `lib/onboarding/destinos.ts` → `DESTINO_POST_ALTA = '/almacenamiento'`, que la
// consumen sus anfitriones (estoks/index.astro y lib/onboarding/wizard.ts).
// =============================================================================
---

<form id="onbFormEstok" data-paso1-estok class="space-y-4" novalidate>
  <div>
    <label for="onbNombreEstok" class="block text-sm font-semibold text-gray-700 mb-1">Nombre del Estok</label>
    <input
      id="onbNombreEstok"
      name="nombre"
      type="text"
      maxlength="200"
      autocomplete="off"
      placeholder="Ej: Mi Casa"
      class="w-full px-4 py-3 border border-gray-300 rounded-2xl text-base focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base"
    />
  </div>
  <div>
    <label for="onbCantidadPisos" class="block text-sm font-semibold text-gray-700 mb-1">¿Cuántas plantas tiene?</label>
    <select
      id="onbCantidadPisos"
      name="cantidad_pisos"
      class="w-full px-4 py-3 border border-gray-300 rounded-2xl text-base bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base"
    >
      <option value="1">1 planta (vista de planta única)</option>
      <option value="2">2 plantas (casa con techo)</option>
    </select>
  </div>

  <p id="onbErrorPaso1" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm"></p>
  <p id="onbPaso1Ok" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-2xl text-sm"></p>

  <button
    type="submit"
    id="onbFundarBtn"
    data-label-inicial="🏠 Fundar Estok"
    class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-blue-700 hover:bg-blue-800 text-white text-base font-bold rounded-2xl shadow-md transition-base disabled:opacity-60 disabled:cursor-not-allowed"
  >
    🏠 Fundar Estok
  </button>
</form>

<script>
  import { fundarEstok } from '../../lib/onboarding/api';

  /** Nombre del evento canónico de alta completada (lo escuchan los anfitriones). */
  const EVENTO = 'estok:paso1-completado';

  /** Muestra u oculta un aviso (error/éxito) del formulario. */
  function mostrar(el: HTMLElement | null, mensaje: string | null): void {
    if (!el) return;
    el.textContent = mensaje ?? '';
    el.classList.toggle('hidden', !mensaje);
  }

  /** Cablea un formulario de alta (idempotente por dataset). */
  function initPaso1(form: HTMLFormElement): void {
    if (form.dataset.paso1Listo === '1') return;
    form.dataset.paso1Listo = '1';

    const nombre = form.querySelector<HTMLInputElement>('#onbNombreEstok');
    const pisos = form.querySelector<HTMLSelectElement>('#onbCantidadPisos');
    const btn = form.querySelector<HTMLButtonElement>('#onbFundarBtn');
    const error = form.querySelector<HTMLElement>('#onbErrorPaso1');
    const ok = form.querySelector<HTMLElement>('#onbPaso1Ok');
    if (!nombre || !btn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      mostrar(error, null);
      const valor = nombre.value.trim();
      if (valor.length < 2) {
        mostrar(error, 'Escribí un nombre para tu Estok (mínimo 2 caracteres).');
        return;
      }
      const cantidad = Math.max(1, Math.floor(Number(pisos?.value) || 1));
      const label = btn.dataset.labelInicial ?? '🏠 Fundar Estok';
      btn.disabled = true;
      btn.textContent = 'Fundando Estok…';
      try {
        const estok = await fundarEstok(valor, cantidad);
        mostrar(ok, `✅ «${estok.nombre}» quedó creado y activo.`);
        window.dispatchEvent(new CustomEvent(EVENTO, { detail: { estok, pisos: cantidad } }));
      } catch (err) {
        const e2 = err as { error?: string; message?: string };
        mostrar(error, e2?.error ?? e2?.message ?? 'No se pudo fundar el Estok. Reintentá.');
      } finally {
        btn.disabled = false;
        btn.textContent = label;
      }
    });
  }

  document.querySelectorAll<HTMLFormElement>('[data-paso1-estok]').forEach(initPaso1);
</script>
