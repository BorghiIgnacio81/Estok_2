<!-- =============================================================================      MODALES ADMIN GLOBAL (god mode)      Extraido de pages/index.astro (Fase A refactor preventivo).      Contiene: Crear Usuario, Crear Estok, Editar Estok y Editar Usuario.      ============================================================================= --> 
    <!-- ================================================================ -->
    <!-- ADMIN GLOBAL - Modal Crear Usuario -->
    <!-- ================================================================ -->
    <div id="godModalUsuario" class="hidden fixed inset-0 z-[9999] flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-bold text-gray-900">➕ Crear Nuevo Usuario</h3>
          <button id="godCerrarModalUsuario" class="p-1 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-base" title="Cerrar">✕</button>
        </div>
        <form id="godFormUsuario" class="p-6 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="gUUsername" class="block text-sm font-medium text-gray-700 mb-1">Username *</label>
              <input id="gUUsername" type="text" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base" />
            </div>
            <div>
              <label for="gUEmail" class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
              <input id="gUEmail" type="email" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base" />
            </div>
            <div>
              <label for="gUPassword" class="block text-sm font-medium text-gray-700 mb-1">Password *</label>
              <input id="gUPassword" type="password" required autocomplete="new-password" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base" />
            </div>
            <div>
              <label for="gUFirst" class="block text-sm font-medium text-gray-700 mb-1">Nombre</label>
              <input id="gUFirst" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base" />
            </div>
            <div>
              <label for="gULast" class="block text-sm font-medium text-gray-700 mb-1">Apellido</label>
              <input id="gULast" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base" />
            </div>
            <div>
              <label for="gUPhone" class="block text-sm font-medium text-gray-700 mb-1">Teléfono</label>
              <input id="gUPhone" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base" />
            </div>
          </div>
          <div>
            <label for="gUDescription" class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
            <textarea id="gUDescription" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base"></textarea>
          </div>
          <div class="flex flex-wrap items-center gap-6">
            <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
              <input id="gUIsActive" type="checkbox" checked class="w-4 h-4 text-red-700 rounded border-gray-300" />
              Activo
            </label>
            <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
              <input id="gUIsSuperuser" type="checkbox" class="w-4 h-4 text-red-700 rounded border-gray-300" />
              Superusuario
            </label>
          </div>
          <div id="godFormUsuarioError" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm"></div>
          <div class="flex gap-3 pt-1">
            <button type="submit" id="godGuardarUsuarioBtn" class="flex-1 py-2.5 bg-red-700 hover:bg-red-800 text-white text-sm font-semibold rounded-lg transition-base shadow-sm">Crear Usuario</button>
            <button type="button" id="godCancelarUsuarioBtn" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition-base">Cancelar</button>
          </div>
        </form>
      </div>
    </div>
    <!-- ================================================================ -->
    <!-- ADMIN GLOBAL - Modal Crear Estok -->
    <!-- ================================================================ -->
    <div id="godModalEstok" class="hidden fixed inset-0 z-[9999] flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-bold text-gray-900">🏢 Crear Nuevo Estok</h3>
          <button id="godCerrarModalEstok" class="p-1 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-base" title="Cerrar">✕</button>
        </div>
        <form id="godFormEstok" class="p-6 space-y-4">
          <div>
            <label for="gENombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre *</label>
            <input id="gENombre" type="text" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base" />
          </div>
          <div>
            <label for="gEPisos" class="block text-sm font-medium text-gray-700 mb-1">¿Cuántas plantas (pisos) tiene su inmueble? *</label>
            <input id="gEPisos" type="number" min="1" max="99" step="1" value="1" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base" />
            <p class="mt-1 text-xs text-gray-500">1 planta → Modo Planta Única (sin techo). 2+ → Modo Casa con techo.</p>
          </div>
          <div>
            <label for="gEDescripcion" class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
            <textarea id="gEDescripcion" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base"></textarea>
          </div>
          <div id="godFormEstokError" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm"></div>
          <div class="flex gap-3 pt-1">
            <button type="submit" id="godGuardarEstokBtn" class="flex-1 py-2.5 bg-red-700 hover:bg-red-800 text-white text-sm font-semibold rounded-lg transition-base shadow-sm">Crear Estok</button>
            <button type="button" id="godCancelarEstokBtn" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition-base">Cancelar</button>
          </div>
        </form>
      </div>
    </div>
    <!-- ================================================================ -->
    <!-- ADMIN GLOBAL - Modal Editar Estok (PUT) -->
    <!-- ================================================================ -->
    <div id="godModalEstokEditar" class="hidden fixed inset-0 z-[9999] flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-bold text-gray-900">✏️ Editar Estok</h3>
          <button id="godCerrarModalEstokEditar" class="p-1 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-base" title="Cerrar">✕</button>
        </div>
        <form id="godFormEstokEditar" class="p-6 space-y-4">
          <div>
            <label for="gENombreEditar" class="block text-sm font-medium text-gray-700 mb-1">Nombre *</label>
            <input id="gENombreEditar" type="text" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base" />
          </div>
          <div id="godFormEstokEditarError" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm"></div>
          <div class="flex gap-3 pt-1">
            <button type="submit" id="godGuardarEstokEditarBtn" class="flex-1 py-2.5 bg-red-700 hover:bg-red-800 text-white text-sm font-semibold rounded-lg transition-base shadow-sm">Guardar Cambios</button>
            <button type="button" id="godCancelarEstokEditarBtn" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition-base">Cancelar</button>
          </div>
        </form>
      </div>
    </div>
    <!-- ================================================================ -->
    <!-- ADMIN GLOBAL - Modal Editar Usuario (PUT) -->
    <!-- ================================================================ -->
    <div id="godModalUsuarioEditar" class="hidden fixed inset-0 z-[9999] flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-bold text-gray-900">✏️ Editar Usuario</h3>
          <button id="godCerrarModalUsuarioEditar" class="p-1 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-base" title="Cerrar">✕</button>
        </div>
        <form id="godFormUsuarioEditar" class="p-6 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="gUUsernameEditar" class="block text-sm font-medium text-gray-700 mb-1">Username *</label>
              <input id="gUUsernameEditar" type="text" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base" />
            </div>
            <div>
              <label for="gUEmailEditar" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
              <input id="gUEmailEditar" type="email" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base" />
            </div>
            <div class="sm:col-span-2">
              <label for="gUPasswordEditar" class="block text-sm font-medium text-gray-700 mb-1">Nueva contraseña <span class="text-xs text-gray-400 font-normal">(dejar vacío para no cambiar)</span></label>
              <input id="gUPasswordEditar" type="password" autocomplete="new-password" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-base" />
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-6">
            <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
              <input id="gUIsActiveEditar" type="checkbox" class="w-4 h-4 text-red-700 rounded border-gray-300" />
              Activo
            </label>
            <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
              <input id="gUIsSuperuserEditar" type="checkbox" class="w-4 h-4 text-red-700 rounded border-gray-300" />
              Superusuario
            </label>
          </div>
          <div id="godFormUsuarioEditarError" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm"></div>
          <div class="flex gap-3 pt-1">
            <button type="submit" id="godGuardarUsuarioEditarBtn" class="flex-1 py-2.5 bg-red-700 hover:bg-red-800 text-white text-sm font-semibold rounded-lg transition-base shadow-sm">Guardar Cambios</button>
            <button type="button" id="godCancelarUsuarioEditarBtn" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition-base">Cancelar</button>
          </div>
        </form>
      </div>
    </div>
