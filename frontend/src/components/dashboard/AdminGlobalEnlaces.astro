---
// =============================================================================
// ADMIN GLOBAL · ATAJOS AL ADMIN DE DJANGO
//
// El panel #godPanel (index.astro) sólo lista Estoks y Usuarios. La
// configuración FINA de monetización (plan por usuario con combobox, permisos y
// cuotas por botón, feature flags, pagos) y el resto de los MODELOS REGISTRADOS
// viven en el Admin de Django (/admin/). Este bloque concentra esas rutas para
// que el Admin Global no tenga que memorizarlas.
//
// OJO: la sesión del Admin de Django es INDEPENDIENTE de la sesión de la app.
// =============================================================================

interface EnlaceAdmin {
  href: string;
  icono: string;
  titulo: string;
  detalle: string;
}

const ENLACES: EnlaceAdmin[] = [
  {
    href: '/admin/inventario/botonpermiso/matriz/',
    icono: '🧩',
    titulo: 'Permisos y cuotas por botón',
    detalle: 'Matriz por plan o por usuario',
  },
  {
    href: '/admin/inventario/customuser/',
    icono: '👤',
    titulo: 'Usuarios y planes',
    detalle: 'Combobox Free / Pro / Personalizado',
  },
  {
    href: '/admin/inventario/featureflag/',
    icono: '🚩',
    titulo: 'Feature Flags',
    detalle: 'Prender/apagar funciones en caliente',
  },
  {
    href: '/admin/inventario/cuotausousuario/',
    icono: '📊',
    titulo: 'Cuotas de uso por botón',
    detalle: 'Consumo real y reinicio del período',
  },
  {
    href: '/admin/inventario/suscripcionpago/',
    icono: '💳',
    titulo: 'Pagos de suscripción',
    detalle: 'Auditoría de Mercado Pago',
  },
  {
    href: '/admin/inventario/estok/',
    icono: '🏠',
    titulo: 'Estoks y su plan',
    detalle: 'Plan del hogar y publicidad',
  },
];

const CLASE_ENLACE =
  'flex items-start gap-3 p-3 rounded-lg border border-red-200 bg-red-50 hover:bg-red-100 transition-base';
---

<div>
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <h3 class="text-base font-bold text-gray-900">🎛️ Monetización, permisos y modelos</h3>
    <a
      href="/admin/"
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-800 hover:bg-gray-900 text-white text-xs font-semibold rounded-lg transition-base shadow-sm"
    >
      🗂️ Todos los modelos registrados
    </a>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    {
      ENLACES.map((enlace) => (
        <a href={enlace.href} target="_blank" rel="noopener" class={CLASE_ENLACE}>
          <span class="text-xl">{enlace.icono}</span>
          <span>
            <span class="block text-sm font-semibold text-red-900">{enlace.titulo}</span>
            <span class="block text-xs text-red-600">{enlace.detalle}</span>
          </span>
        </a>
      ))
    }
  </div>
</div>
