---
// =============================================================================
// MINIMAPA RUTA · COMPONENTE GLOBAL DE MINIMAPAS (AUTOCONTENIDO Y ELÁSTICO)
// -----------------------------------------------------------------------------
// ÚNICA cara Astro del sistema de minimapas del proyecto. Es un contenedor
// CERRADO: se importa a sí mismo su propia hoja de estilos (styles/minimapa-
// ruta.css) y se amolda al ancho real de su padre. Quien lo usa NO necesita
// conocer clases, ni anchos, ni el motor de dibujo.
//
// DOS FORMATOS (misma fuente de verdad geométrica, cero código duplicado):
//
//   1. PLANO A ESCALA (`plano` + `sectores`):
//      dibuja UN plano elástico del nivel pedido (habitaciones de una planta,
//      muebles de una habitación, cajas de un mueble, etc.). El SVG se mide en
//      PORCENTAJE del padre (`width="100%"`, `height="100%"`, `viewBox`),
//      así que cada sector conserva su `ui_width`/`ui_height` real y el plano
//      se amolda al ancho del formulario sin anchos fijos ni recortes.
//      Con `clicable` cada silueta viaja en un `<g data-sector-id>` para que la
//      pantalla resuelva el clic; el sector activo va en NARANJA (#f97316).
//
//   2. CADENA DE ORIENTACIÓN (`nodos`):
//      mini-guía analítica superior (planta → habitación → mueble → caja) con
//      las siluetas asimétricas reales; delega en el motor puro
//      src/lib/minimapasAnidados.ts → renderMinimapasAnidados(), el MISMO que
//      consumen las pantallas con render en caliente (portalesAlmacenamiento.ts
//      y rutaCajaMinimapas.ts de Objetos).
//
// PROP DE RESALTADO (`activoId`): recibe el ID del contenedor/ambiente en el que
// está parado el usuario. ÚNICAMENTE el sector (o el nodo de la cadena) cuyo ID
// coincide se pinta en NARANJA ESTRICTO (#f97316); los demás quedan en el crema
// suave de fondo. Sin `activoId`, la cadena resalta por posición (último nodo).
//
// ANTI-DESBORDE: NINGÚN ancho fijo. El host es `w-full min-w-0` con
// `overflow-hidden` y las celdas interiores escalan en porcentaje, de modo que
// el bloque jamás empuja ni desborda su contenedor lateral.
//
// CONTORNOS Y LÍNEAS DIVISORIAS: este componente NO declara bordes. El color y
// el grosor de los trazos viven en el motor (lib/minimapa.ts) y se refuerzan en
// styles/minimapa-ruta.css §2 (plano a escala: negro nítido zinc-950 #0a0a0a) y
// styles/almacenamiento-portales.css §2.1 (cadena: mismo negro a escala
// reducida). Un espacio FUSIONADO («Pasillo Escalera») se dibuja como UN solo
// `<path>` de contorno: nunca queda una línea divisoria interna.
//
// ESTÁNDAR VISUAL ÚNICO (idéntico en Almacenamiento, Objetos —nuevo/editar—,
// Mudanza y la barra lateral de «Minimapas de las plantas»):
//   - contenedor estilizado con PUNTAS REDONDEADAS y BORDE NEGRO externo,
//   - FONDO CREMA suave (#fef3c7) en todos los ambientes,
//   - NARANJA ESTRICTO (#f97316) SOLO en el ambiente/contenedor actual,
//   - geometría POSICIONAL PROPORCIONAL ABSOLUTA: cada ambiente se ubica con su
//     `ui_left`/`ui_top`/`ui_width`/`ui_height` real persistido en PostgreSQL
//     (lib/sectoresMinimapa.ts → sectoresDeItems) — NUNCA una cuadrícula rígida
//     de filas y columnas uniformes.
// =============================================================================

import { renderMinimapasAnidados } from '../lib/minimapasAnidados';
import type { NodoRuta } from '../lib/minimapasAnidados';
import { ASPECTO_LIENZO, minimapaSectoresSvg } from '../lib/minimapa';
import type { SectorMinimapa } from '../lib/minimapa';
// Hoja propia del componente: única fuente de verdad de su tamaño elástico.
import '../styles/minimapa-ruta.css';

interface Props {
  /** Nodos de la cadena de orientación (casita → habitación → mueble → caja). */
  nodos?: NodoRuta[];
  /** Sectores con geometría REAL: dibuja UN plano a escala del nivel. */
  sectores?: SectorMinimapa[];
  /** Formato PLANO a escala (amoldado al ancho del padre, con `aspect-ratio`). */
  plano?: boolean;
  /** Plano navegable: cada sector viaja en `<g data-sector-id>`. */
  clicable?: boolean;
  /** ID del contenedor/ambiente activo: su sector va en NARANJA (#f97316). */
  activoId?: string | null;
  /** Resalta TODA la cadena (ruta geográfica de una caja móvil). */
  todosActivos?: boolean;
  /** Relación alto/ancho REAL del lienzo medido en vivo (no deforma el plano). */
  aspecto?: number;
  /** ID del host (para que los módulos de src/lib lo rellenen en caliente). */
  id?: string;
  /** Clases extra del host (ej: `hidden` cuando la barra arranca vacía). */
  class?: string;
}

const {
  nodos = [],
  sectores,
  plano = false,
  clicable = false,
  activoId = null,
  todosActivos = false,
  aspecto,
  id,
  class: clase,
} = Astro.props;

const aspectoFinal = Math.max(0.35, Math.min(1.8, Number(aspecto) || ASPECTO_LIENZO));

// La dimensión elástica recibida por Props se hereda a los nodos que no traen
// su propia medición en vivo: una sola fuente de verdad para las proporciones.
const nodosFinales: NodoRuta[] =
  aspecto != null ? nodos.map((nodo) => ({ ...nodo, aspecto: nodo.aspecto ?? aspecto })) : nodos;

// PLANO a escala: SVG elástico (100% del padre) con los porcentajes reales.
// Los `sectores` son la fuente de verdad geométrica: cuando vienen, SIEMPRE se
// dibuja el plano proporcional (no hace falta recordar `plano`), así ninguna
// pantalla puede caer en una cuadrícula de celdas idénticas.
const sectoresFinales: SectorMinimapa[] = sectores ?? [];
const dibujarPlano = sectoresFinales.length > 0 && (plano || nodosFinales.length === 0);
const htmlPlano = dibujarPlano
  ? minimapaSectoresSvg({
      sectores: sectoresFinales,
      aspecto: aspectoFinal,
      activoId,
      responsive: true,
      clicable,
    })
  : '';

// CADENA de orientación (host vacío sin `nodos`: la pantalla la rellena en vivo).
const htmlCadena = nodosFinales.length
  ? renderMinimapasAnidados(nodosFinales, { activoId, todosActivos })
  : '';

const html = htmlPlano || htmlCadena;

const clases = [
  'minimapa-ruta',
  htmlPlano ? 'minimapa-ruta-plano' : 'minimapa-ruta-cadena',
  // Anti-desborde SIEMPRE; el centrado de la cadena y el `aspect-ratio` del plano
  // viven en styles/minimapa-ruta.css. NO se declaran `h-full` ni utilidades de
  // flex acá: chocarían con el comportamiento elástico que pide cada pantalla
  // (ej: `w-full h-auto aspect-video max-w-2xl mx-auto` del formulario de objetos).
  'w-full overflow-hidden',
  clase,
]
  .filter(Boolean)
  .join(' ');

// Proporción REAL del lienzo (ancho/alto) para el `aspect-ratio` del host.
const estilo = htmlPlano
  ? `--minimapa-aspecto-ratio:${(1 / aspectoFinal).toFixed(4)};`
  : undefined;
---

<div id={id} class={clases} style={estilo} data-minimapa-ruta>
  {html ? <Fragment set:html={html} /> : null}
</div>

