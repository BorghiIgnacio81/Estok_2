---
// =============================================================================
// MODAL SIMPLIFICADO «+ NUEVA CAJA / CONTENEDOR» (pantalla de Almacenamiento)
// -----------------------------------------------------------------------------
// Formulario dedicado a contenedores físicos: Nombre, Foto (opcional),
// Dimensiones (Largo × Ancho × Alto en cm), Descripción y Ubicación/Espacio.
//
// OMITE DELIBERADAMENTE el «Valor Estimado» y los campos patrimoniales del alta
// de objetos: una caja no es un ítem de stock, es un espacio que lo aloja.
//
// La lógica (carga de espacios, POST multipart, reset y refresco en caliente)
// vive en src/lib/nuevaCajaModal.ts, inicializada desde
// src/lib/almacenamientoArranque.ts. Auth 100% centralizada en services/auth.
// =============================================================================
---

<div id="modalNuevaCaja"
  class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
  role="dialog" aria-modal="true" aria-labelledby="nuevaCajaTitulo">
  <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-4">
      <h3 id="nuevaCajaTitulo" class="text-lg font-semibold text-gray-900">📦 Nueva Caja / Contenedor</h3>
      <button type="button" data-cerrar-nueva-caja class="text-gray-400 hover:text-gray-600" aria-label="Cerrar">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <form id="nuevaCajaForm" class="space-y-4">
      <div>
        <label for="nuevaCajaNombre" class="block text-sm font-medium text-gray-700 mb-1">
          Nombre <span class="text-red-500">*</span>
        </label>
        <input id="nuevaCajaNombre" name="nombre" type="text" required
          placeholder="Ej: Caja 01"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
      </div>

      <div>
        <label for="nuevaCajaFoto" class="block text-sm font-medium text-gray-700 mb-1">Foto (opcional)</label>
        <div class="flex items-center gap-3">
          <label for="nuevaCajaFoto"
            class="inline-flex items-center gap-1.5 px-3 py-2 bg-gray-100 text-gray-700 text-sm font-semibold rounded-lg hover:bg-gray-200 transition-base cursor-pointer">
            <span class="text-base leading-none" aria-hidden="true">🖼️</span>
            Elegir foto
          </label>
          <input id="nuevaCajaFoto" name="foto" type="file" accept="image/*" class="hidden" />
          <span id="nuevaCajaFotoLabel" class="text-xs text-gray-400">Sin foto seleccionada</span>
        </div>
        <div id="nuevaCajaFotoPreview" class="hidden mt-2">
          <img id="nuevaCajaFotoPreviewImg" alt="Vista previa de la caja"
            class="h-32 w-full object-cover rounded-lg border border-gray-200" />
        </div>
      </div>

      <div>
        <span class="block text-sm font-medium text-gray-700 mb-1">Dimensiones (cm)</span>
        <div class="grid grid-cols-3 gap-2">
          <div>
            <label for="nuevaCajaLargo" class="block text-xs font-medium text-gray-700 mb-1">Largo</label>
            <input id="nuevaCajaLargo" name="largo" type="number" step="0.01" min="0" placeholder="0"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
          </div>
          <div>
            <label for="nuevaCajaAncho" class="block text-xs font-medium text-gray-700 mb-1">Ancho</label>
            <input id="nuevaCajaAncho" name="ancho" type="number" step="0.01" min="0" placeholder="0"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
          </div>
          <div>
            <label for="nuevaCajaAlto" class="block text-xs font-medium text-gray-700 mb-1">Alto</label>
            <input id="nuevaCajaAlto" name="alto" type="number" step="0.01" min="0" placeholder="0"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base" />
          </div>
        </div>
      </div>

      <div>
        <label for="nuevaCajaDescripcion" class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
        <textarea id="nuevaCajaDescripcion" name="descripcion" rows="2"
          placeholder="Ej: Caja de cartón con ropa de invierno"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base"></textarea>
      </div>

      <div>
        <label for="nuevaCajaUbicacion" class="block text-sm font-medium text-gray-700 mb-1">
          Ubicación / Espacio <span class="text-red-500">*</span>
        </label>
        <select id="nuevaCajaUbicacion" name="ubicacion" required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-base bg-white">
          <option value="">Cargando espacios…</option>
        </select>
      </div>

      <p id="nuevaCajaError" class="hidden text-sm text-red-600"></p>

      <div class="flex gap-3 pt-2">
        <button type="submit" id="nuevaCajaSaveBtn"
          class="flex-1 px-4 py-2 bg-blue-700 text-white font-medium rounded-lg hover:bg-blue-800 transition-base disabled:opacity-50">
          <span id="nuevaCajaSaveText">Crear Caja</span>
          <span id="nuevaCajaSaveSpinner" class="hidden">
            <svg class="animate-spin h-5 w-5 mx-auto" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" />
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
            </svg>
          </span>
        </button>
        <button type="button" data-cerrar-nueva-caja
          class="flex-1 px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-base">
          Cancelar
        </button>
      </div>
    </form>
  </div>
</div>
