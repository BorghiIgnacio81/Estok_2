---
// =============================================================================
// PANEL DE VOTACIONES PENDIENTES (Sección 3 de /alertas-stock)
// -----------------------------------------------------------------------------
// Muestra las votaciones que el backend abre AUTOMÁTICAMENTE cuando un objeto
// queda con Dueño original y sin Beneficiario, y permite votar en ellas
// (democracia 1-usuario-1-voto dentro del Estok activo).
//
// Este componente es SÓLO EL CUERPO de la sección: el encabezado colapsable
// (título, badge con el total y 🚨 Alerta Rojo) lo dibuja el acordeón de la
// página (components/decisiones/SeccionAcordeon.astro), que conserva los ids
// `votacionesCount` y `alertaDescarte` que leen los controladores.
//
// Toda la lógica vive en src/lib/votacionesDecisiones.ts (render + endpoints).
// =============================================================================
---

<div id="votacionesPendientes" class="space-y-3"></div>

<script>
  import { iniciarVotacionesPendientes } from '../lib/votacionesDecisiones';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => iniciarVotacionesPendientes());
  } else {
    iniciarVotacionesPendientes();
  }
</script>
