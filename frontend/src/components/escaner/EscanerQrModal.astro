---
// =============================================================================
// MODAL «ESCANEAR QR» · CÁMARA EN VIVO DESDE LA BARRA DE ACCIONES
// -----------------------------------------------------------------------------
// Montaje del escáner dentro del Dashboard (pages/index.astro). El disparador es
// el botón gráfico `/boton-qr.webp` intercalado entre «Mudanza» y «Nuevo
// Objeto»: cualquier elemento con `data-abrir-escaner-qr` abre este modal.
//
// RESPONSABILIDADES
//   · Markup + estados visuales (cámara, permiso denegado, resultado).
//   · Toda la lógica (getUserMedia, jsQR empaquetado, resolución del QR contra
//     la API, contenido del contenedor y ruta de ubicación completa) vive en
//     src/lib/escanerQrModal.ts. Este componente sólo aporta Tailwind.
//
// NOTA DE ESTILOS: los bloques que se muestran/ocultan por JS NO combinan la
// clase `hidden` con una utilidad de display (`flex`, `grid`, …) en el MISMO
// elemento: en Tailwind v4 el orden del bundle puede dejar la utilidad de
// display por encima de `.hidden` y el bloque no se ocultaría. El `hidden` va
// siempre en un contenedor sin utilidad de display.
// =============================================================================
---

<div id="escanerQrModal" role="dialog" aria-modal="true" aria-labelledby="escanerQrTitulo"
  class="hidden fixed inset-0 z-[9998] bg-black/70 backdrop-blur-sm overflow-y-auto p-3 sm:p-6">
  <div class="mx-auto w-full max-w-lg my-4 sm:my-8 bg-white rounded-2xl shadow-2xl overflow-hidden">

    <header class="flex items-center justify-between gap-3 px-4 py-3 border-b border-gray-200 bg-gradient-to-r from-amber-50 to-orange-50">
      <div class="min-w-0">
        <h3 id="escanerQrTitulo" class="text-base font-bold text-gray-900">📷 Escanear código QR</h3>
        <p class="text-[11px] text-gray-500 truncate">Caja, contenedor u objeto · contenido y ruta de ubicación</p>
      </div>
      <button type="button" id="escanerQrCerrar" aria-label="Cerrar el escáner"
        class="shrink-0 w-9 h-9 inline-flex items-center justify-center rounded-full text-gray-400 hover:text-gray-700 hover:bg-gray-100 text-xl leading-none">✕</button>
    </header>

    <div class="p-4 space-y-3">
      <!-- Cámara en vivo (el marco azul ayuda a encuadrar el QR) -->
      <div id="escanerQrCamara" class="relative bg-black rounded-xl overflow-hidden aspect-square">
        <video id="escanerQrVideo" class="w-full h-full object-cover" autoplay playsinline muted></video>
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <div class="w-48 h-48 border-2 border-blue-400/70 rounded-xl"></div>
        </div>
      </div>

      <!-- Estado del permiso / del escaneo -->
      <p id="escanerQrEstado" role="status" aria-live="polite"
        class="text-center text-sm text-gray-600">Pidiendo permiso de cámara…</p>

      <!-- Permiso denegado, QR inválido o entidad inexistente -->
      <div id="escanerQrError"
        class="hidden rounded-xl bg-amber-50 border border-amber-200 text-amber-800 px-4 py-3 text-sm"></div>

      <!-- Resultado: lo construye lib/escanerQrModal.ts (DOM seguro, sin HTML crudo) -->
      <div id="escanerQrResultado" class="hidden space-y-3"></div>

      <!-- Controles -->
      <div class="flex flex-col sm:flex-row gap-2">
        <button type="button" id="escanerQrReintentar"
          class="hidden flex-1 px-4 py-2.5 bg-amber-600 text-white text-sm font-semibold rounded-lg hover:bg-amber-700 transition-base">
          Reintentar cámara
        </button>
        <label class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-white border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-base cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Escanear desde una foto
          <input id="escanerQrArchivo" type="file" accept="image/*" class="hidden" />
        </label>
      </div>
    </div>
  </div>
</div>

<script>
  import { initEscanerQrModal } from '../../lib/escanerQrModal';
  initEscanerQrModal();
</script>
