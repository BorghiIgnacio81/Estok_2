---
// =============================================================================
// COMPONENTE: EmptyState
// Muestra un estado vacío con icono, mensaje y acción opcional
// =============================================================================

import BotonAccionRapida from './ui/BotonAccionRapida.astro';

export interface Props {
  titulo: string;
  descripcion: string;
  icono?: string;
  accionTexto?: string;
  accionHref?: string;
  accionId?: string;
  id?: string;
}

const {
  titulo,
  descripcion,
  icono = '📦',
  accionTexto,
  accionHref,
  accionId,
  id = 'emptyState',
} = Astro.props;
---

<div id={id} class="hidden bg-white rounded-xl shadow-sm border border-gray-200 p-12 text-center">
  <div class="text-6xl mb-4">{icono}</div>
  <p class="text-xl font-medium text-gray-400 mb-2">{titulo}</p>
  <p class="text-gray-400 mb-6">{descripcion}</p>
  {accionTexto && (
    accionHref ? (
      <BotonAccionRapida variante="inline" href={accionHref} etiqueta={accionTexto} />
    ) : (
      <BotonAccionRapida variante="inline" id={accionId} etiqueta={accionTexto} />
    )
  )}
</div>
