---
// =============================================================================
// MODAL DE PUBLICACIÓN (2 pasos: elegir plataforma → vista previa)
// -----------------------------------------------------------------------------
// Host del modal que publica un objeto en Mercado Libre / Facebook Marketplace.
// Es SOLO markup: todo el comportamiento (apertura, pasos, vista previa con IA
// y precio de referencia, publicación y cierre) vive en
// src/lib/publicarObjeto.ts, que la página arranca con
// iniciarModalPublicar() y abre con abrirPublicarObjeto(objeto).
// =============================================================================
---

<div id="publicarModal" class="hidden fixed inset-0 z-[9999] flex items-center justify-center bg-black/50 backdrop-blur-sm overflow-y-auto py-8">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden transform transition-all my-auto">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
      <h3 id="modalTitulo" class="text-lg font-bold text-gray-900">📢 Publicar objeto</h3>
      <button id="cerrarPublicarModalBtn" class="p-1 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-base">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Paso 1: Elegir plataforma -->
    <div id="modalPaso1" class="p-6">
      <p id="publicarObjetoNombre" class="text-sm font-medium text-gray-900 mb-1"></p>
      <p id="publicarObjetoValor" class="text-xs text-gray-500 mb-4"></p>
      <p class="text-sm font-semibold text-gray-700 mb-3">¿Dónde querés publicarlo?</p>
      <div class="space-y-3">
        <button id="btnElegirML" class="w-full flex items-center gap-4 p-4 rounded-xl border-2 border-gray-200 hover:border-yellow-400 hover:bg-yellow-50 transition-base text-left">
          <div class="w-12 h-12 bg-yellow-100 rounded-xl flex items-center justify-center flex-shrink-0 text-2xl">🛒</div>
          <div><p class="text-sm font-semibold text-gray-900">Mercado Libre</p><p class="text-xs text-gray-500">Mayor visibilidad, gestión de envíos integrada</p></div>
        </button>
        <button id="btnElegirFB" class="w-full flex items-center gap-4 p-4 rounded-xl border-2 border-gray-200 hover:border-blue-400 hover:bg-blue-50 transition-base text-left">
          <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center flex-shrink-0 text-2xl">📘</div>
          <div><p class="text-sm font-semibold text-gray-900">Facebook Marketplace</p><p class="text-xs text-gray-500">Venta local, sin comisiones, contacto directo</p></div>
        </button>
      </div>
    </div>

    <!-- Paso 2: Formulario de publicación -->
    <div id="modalPaso2" class="hidden p-6">
      <!-- Loading del preview -->
      <div id="previewLoading" class="text-center py-8">
        <svg class="animate-spin h-8 w-8 mx-auto text-blue-600 mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        <p class="text-sm text-gray-500">Generando vista previa...</p>
      </div>

      <!-- Formulario -->
      <div id="previewForm" class="hidden space-y-4">
        <!-- Foto -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Foto principal</label>
          <div id="fotoSelector" class="flex gap-2 overflow-x-auto pb-1"></div>
        </div>

        <!-- Título -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Título</label>
          <input id="inputTitulo" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500" />
        </div>

        <!-- Precio -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Precio (USD)</label>
          <input id="inputPrecio" type="number" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500" />
          <p id="precioRefInfo" class="text-xs text-gray-400 mt-0.5"></p>
        </div>

        <!-- Descripción -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
          <textarea id="inputDescripcion" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500"></textarea>
        </div>

        <!-- Mensaje de estado / error -->
        <div id="publicarStatus" class="hidden p-3 rounded-lg text-sm"></div>

        <!-- Botón de acción -->
        <button id="btnPublicarAhora" class="w-full px-4 py-2.5 text-sm font-semibold text-white rounded-lg transition-base shadow-sm">
          Publicar ahora
        </button>

        <!-- Volver -->
        <button id="btnVolverPaso1" class="w-full px-4 py-2 text-sm font-medium text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-base">
          ← Elegir otra plataforma
        </button>
      </div>
    </div>
  </div>
</div>
