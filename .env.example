# =============================================================================
# .env.example - Estok en Coolify
# Copia este archivo como .env y completa los valores
# Luego carga estas variables en el dashboard de Coolify
# =============================================================================

# =============================================================================
# DJANGO
# =============================================================================
DJANGO_SECRET_KEY=genera-una-clave-unica-con-python-c-manage.py-shell
DEBUG=False

# =============================================================================
# BASE DE DATOS - PostgreSQL 17 (Coolify Resource)
# Resource ID: postgresql-database-t2oy5kwg9wdtdrf448lpmiz1
# =============================================================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=tu_contraseña_segura_aqui
DB_HOST=t2oy5kwg9wdtdrf448lpmiz1
DB_PORT=5432

# =============================================================================
# JWT (SimpleJWT)
# =============================================================================
JWT_SECRET=genera-un-secreto-unico-para-jwt

# =============================================================================
# EMAIL - Credencial SMTP (NUNCA versionar el valor real)
# La contraseña de aplicación de Gmail se carga SOLO en el panel de Coolify;
# este archivo es una plantilla y no debe contener secretos reales.
# =============================================================================
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx

# =============================================================================
# IA HÍBRIDA - LM Studio (RX 9060 XT en tu PC local)
# AI_API_ENDPOINT debe apuntar a la IP de tu PC en la red local
# Coolify en Hetzner se conectará a tu PC vía Internet o VPN
# =============================================================================
AI_API_ENDPOINT=http://192.168.1.100:1234/v1

# =============================================================================
# IA MULTI-MOTOR - CONMUTACIÓN POR ERROR (FAILOVER EN CADENA)
# Motor primario: Gemini (capa gratuita). Si responde HTTP 429 (rate limit),
# el backend conmuta AUTOMÁTICAMENTE a la IA secundaria, en este orden:
#   1. Otro modelo Gemini con la MISMA key (la cuota diaria gratuita de Google
#      es POR MODELO: agotado gemini-2.5-flash-lite, otro modelo tiene cuota).
#   2. Una segunda API key de Gemini (opcional).
#   3. Un proveedor OpenAI-compatible (OpenRouter / Groq / Hugging Face).
# Todos devuelven el MISMO JSON unificado (el usuario no nota el corte).
# =============================================================================
GEMINI_API_KEY=AIza...tu_clave_de_google...
GEMINI_MODEL=gemini-2.5-flash-lite

# Modelos Gemini de respaldo (misma key, cuota diaria independiente por modelo).
# Verificado en producción: aceptan imágenes y responden con la misma key.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash
# Timeout (segundos) por intento de la IA secundaria.
GEMINI_FALLBACK_TIMEOUT=60
# Timeout del análisis primario y presupuesto TOTAL de la cadena de respaldo.
GEMINI_TIMEOUT=120
FALLBACK_AI_MAX_TOTAL=180
# (Opcional) Segunda cuenta/proyecto de Google: GEMINI_API_KEY_2..5 o lista
# separada por comas en GEMINI_FALLBACK_API_KEYS.
# GEMINI_API_KEY_2=AIza...otra_cuenta...

FALLBACK_AI_ENABLED=True
# La API key acepta 3 aliases: FALLBACK_AI_API_KEY, DEEPSEEK_API_KEY u
# OPENROUTER_API_KEY (prioridad en ese orden).
FALLBACK_AI_API_KEY=sk-...tu_clave_del_proveedor...
# URL del proveedor OpenAI-compatible. El backend la NORMALIZA: si se carga
# "https://groq.com" la corrige a "https://api.groq.com/openai/v1".
FALLBACK_AI_BASE_URL=https://openrouter.ai/api/v1
# Modelo de visión del proveedor de respaldo. OJO: debe soportar IMÁGENES
# (Groq, por ejemplo, no expone modelos multimodales en su capa gratuita).
FALLBACK_AI_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
FALLBACK_AI_TIMEOUT=120

# (Opcional) Proveedores OpenAI-compatible adicionales al final de la cadena.
# GROQ_API_KEY=gsk_...
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# HUGGINGFACE_API_KEY=hf_...
# HUGGINGFACE_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
