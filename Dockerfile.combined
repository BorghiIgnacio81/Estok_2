# =============================================================================
# Dockerfile - Estok (Backend + Frontend en un solo contenedor)
# Soluciona problemas de resolución DNS entre contenedores en Coolify
# =============================================================================
# PUERTOS:
#   - Nginx escucha en ESTOK_PORT (default: 8000) - este es el puerto que
#     Coolify/Traefik debe usar para enrutar tráfico
#   - Gunicorn (Django API) escucha internamente en 8001
#   - Astro (Frontend SSR) escucha internamente en 4321
# =============================================================================

# ---- Etapa 1: Build Frontend ----
FROM node:22-alpine AS frontend-builder

ARG PUBLIC_API_URL
ARG PUBLIC_SITE_URL
ENV PUBLIC_API_URL=${PUBLIC_API_URL:-https://eeestok.duckdns.org/api}
ENV PUBLIC_SITE_URL=${PUBLIC_SITE_URL:-https://eeestok.duckdns.org}

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build 2>&1
RUN echo "=== Frontend build output ===" && ls -la dist/ && ls -la dist/server/ 2>/dev/null || echo "WARNING: No server/entry.mjs generated - will use static fallback"



# ---- Etapa 2: Build Backend ----
FROM python:3.12-slim AS backend-builder

WORKDIR /app

# ANTI-OOM: dependencia SECUENCIAL forzada con la etapa 1 (frontend).
# BuildKit ejecuta EN PARALELO las etapas independientes; `npm ci` +
# `npm run build` (etapa 1) en simultaneo con `pip install` (etapa 2) pueden
# agotar los 4GB del VPS y disparar el OOM Killer (exit 1). Al referenciar
# frontend-builder aca, BuildKit DEBE terminar la etapa 1 antes de arrancar la 2.
# Se copia un archivo minimo a /tmp (fuera de /app) para NO engordar la imagen.
COPY --from=frontend-builder /app/package.json /tmp/.frontend-builder-done

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

# ---- Etapa 3: Contenedor final ----
FROM python:3.12-slim

WORKDIR /app

# Blindaje de codificación UTF-8: evita textos corruptos (“Habitación”) en Django/Gunicorn
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV PYTHONIOENCODING=utf-8

# ---------------------------------------------------------------------------
# Instalacion de Node.js 22 + Nginx (fragmentada en capas RUN independientes)
# - Se divide en 4 capas RUN para reducir el pico de RAM en el VPS (mitiga el
#   OOM Killer en builds de 4GB): Docker commitea cada capa y no acumula todo
#   el trabajo en una sola instruccion.
# - NO se usa `curl | gpg` (pipe largo); la clave se descarga a archivo y se
#   dearmora desde archivo.
# - NO se usa `apt-key` (fue removido en Debian 12 / python:3.12-slim).
# - Repositorio OFICIAL NodeSource repo `nodistro` con keyring explicito.
# ---------------------------------------------------------------------------

# Capa 1: dependencias basicas del sistema
RUN export DEBIAN_FRONTEND=noninteractive && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg nginx && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Capa 2: descargar la clave oficial y dearmorarla (sin pipe hacia gpg)
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL -o /tmp/nodesource-repo.gpg.key https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key && \
    gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg /tmp/nodesource-repo.gpg.key && \
    rm -f /tmp/nodesource-repo.gpg.key

# Capa 3: registrar el repositorio oficial de Node 22 (codename `nodistro`)
RUN echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" > /etc/apt/sources.list.d/nodesource.list

# Capa 4: actualizar indices e instalar Node.js en su propia capa
RUN apt-get update && \
    apt-get install -y --no-install-recommends nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copiar backend
COPY --from=backend-builder /app /app
COPY --from=backend-builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=backend-builder /usr/local/bin /usr/local/bin

# Copiar frontend build
COPY --from=frontend-builder /app/dist ./frontend/dist
COPY --from=frontend-builder /app/package.json ./frontend/
COPY --from=frontend-builder /app/node_modules ./frontend/node_modules

# Configuración de Nginx
RUN rm -f /etc/nginx/sites-enabled/default
COPY nginx-combined.conf /etc/nginx/sites-enabled/default

# Script de entrada (archivo separado para evitar errores de sintaxis)
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Puerto principal - debe coincidir con:
#   - ESTOK_PORT en docker-compose.yml
#   - listen en nginx-combined.conf
#   - traefik.http.services.estok.loadbalancer.server.port
EXPOSE 8000


ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]
